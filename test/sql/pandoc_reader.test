# name: test/sql/pandoc_reader.test
# description: read_pandoc_blocks() -- the Pandoc AST converter, now panduck's
# group: [sql]

require panduck

# ---------------------------------------------------------------------------
# THE POINT OF THIS READER: `json` is pandoc's own AST, so this makes all 43 of pandoc's
# input formats reachable with no per-format code, for anyone who has pandoc installed.
# It is not a tenth format alongside the nine -- it is the thing that makes the format
# list finite.
#
# (43, measured with `pandoc --list-input-formats | wc -l`. This comment said 42 for a
# while, as did three peer sessions, because I said it first and nobody counted.)
#
# A TABLE FUNCTION, like every other panduck reader, so a filter pushes down into it. The
# upstream surface is a SCALAR returning LIST(duck_block), which plants a blocking
# aggregate no predicate can pass -- fine for a README, not for a 400-page document.
query III
SELECT element_type, level, content FROM read_pandoc_blocks_string(
  '{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Para","c":[{"t":"Str","c":"Hello"}]}]}')
ORDER BY element_order;
----
paragraph	1	Hello

# NOTE the shape above: a lone `Str` becomes the PARAGRAPH'S OWN CONTENT, not a `text`
# child. That is spec 6.0's content rule -- content is populated iff the container's only
# child is a plain text run -- and the converter applies it via
# CollapseLonePlainIntoParent, which travelled with it. The rule is SIBLING-DEPENDENT, so
# a converter walking Pandoc's tree cannot know at the run whether it applies; panduck's
# native readers enforce it at emission instead, where they do know.

# THE NAMES ARE PANDUCK'S OWN and deliberately do not match duck_block_utils'
# pandoc_ast_to_blocks / read_pandoc_ast.
#
# A NAME IS OWNED BY EXACTLY ONE EXTENSION IN THIS FAMILY. Measured: when two loaded
# extensions register the same name, BOTH registrations survive as ambiguous overloads and
# every call then fails at BIND TIME with "Could not choose a best candidate function" --
# naming a construct the caller never wrote. It does not degrade, it breaks. So for the
# window in which both copies exist, the two surfaces must not overlap.
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name IN ('pandoc_ast_to_blocks', 'read_pandoc_ast', 'duck_blocks_to_pandoc_ast');
----
0

# ---------------------------------------------------------------------------
# THE CONVERTER AND THE NATIVE READER MUST AGREE. Reading one document two ways is the
# only check that can catch a conversion which is consistently wrong -- round-trip
# stability cannot, because a stable wrong answer round-trips perfectly.
#
# handwritten.org and handwritten.org.pandoc.json are THE SAME DOCUMENT: the second is
# `pandoc -f org -t json` of the first. EVERY block's text must match, `code` included.
query I
SELECT count(*) FROM (
  (SELECT content FROM read_org_blocks('test/fixtures/handwritten.org')
   WHERE kind = 'block' AND coalesce(content, '') <> '')
  EXCEPT
  (SELECT content FROM read_pandoc_blocks('test/fixtures/handwritten.org.pandoc.json')
   WHERE kind = 'block' AND coalesce(content, '') <> '')
);
----
0

# ...AND THE REVERSE, because EXCEPT in one direction is satisfied by the converter simply
# producing MORE. Both directions is what makes this an equality rather than a containment.
query I
SELECT count(*) FROM (
  (SELECT content FROM read_pandoc_blocks('test/fixtures/handwritten.org.pandoc.json')
   WHERE kind = 'block' AND coalesce(content, '') <> '')
  EXCEPT
  (SELECT content FROM read_org_blocks('test/fixtures/handwritten.org')
   WHERE kind = 'block' AND coalesce(content, '') <> '')
);
----
0

# ---------------------------------------------------------------------------
# THE TRAILING NEWLINE, which is the disagreement this cross-check found on its first run
# and which is now RESOLVED rather than pinned.
#
# Pandoc keeps a code block's trailing newline -- its own Org reader gives 12 bytes for an
# 11-byte line. panduck's org, latex, rst, ipynb and epub readers ALL trim it: five
# independently written readers reaching the same conclusion, which makes it a convention
# rather than an accident. A source line's TERMINATOR is not its content.
#
# So the converter trims too, and that is the one place it deliberately diverges from the
# AST it was handed. Left alone, panduck answered one question two ways depending on which
# route a user took -- and a route-dependent answer is worse than a documented divergence
# from the reference. The pandoc-faithful behaviour is a `pandoc_compat` candidate.
#
# Asserted as LENGTHS: the byte that matters cannot be written inside a tab-delimited
# value, so a naive comparison shows two identical-looking strings and fails invisibly.
query II
SELECT 'converter' AS path, length(content)
FROM read_pandoc_blocks('test/fixtures/handwritten.org.pandoc.json') WHERE element_type = 'code'
UNION ALL
SELECT 'native org', length(content)
FROM read_org_blocks('test/fixtures/handwritten.org') WHERE element_type = 'code'
ORDER BY 1;
----
converter	11
native org	11

# ---------------------------------------------------------------------------
# DISPATCH: reachable by format := 'pandoc', and NEVER by extension.
#
# `.json` is already claimed as a DATA format, a Pandoc AST file is also a .json, and
# dispatch cannot tell them apart by suffix -- the overwhelming majority of .json files in
# the world are data. Auto-routing would silently change what every existing .json query
# returns to serve a rare case, which is the wrong direction to be wrong in.
query II
SELECT element_type, content FROM read_panduck_doc(
  'test/fixtures/handwritten.org.pandoc.json', format := 'pandoc')
WHERE kind = 'block' AND element_type = 'heading' ORDER BY element_order;
----
heading	Heading One
heading	Heading Two

# THE NEGATIVE IS THE LOAD-BEARING HALF. .json must still resolve to `data`, and the
# pandoc format must claim NO registry row -- a format with no extension is unroutable by
# suffix by construction, which is the property that keeps existing .json reads working.
query I
SELECT format FROM panduck_reader_registry() WHERE ext = '.json';
----
data

query I
SELECT count(*) FROM panduck_reader_registry() WHERE format = 'pandoc';
----
0

# ...and it is still DECLARED, so `panduck_supported_extensions()` reports a format panduck
# can read even though nothing routes to it automatically. Declared-but-unroutable is the
# right shape here, and is different from planned-but-unimplemented: there IS a reader.
query II
SELECT format, reader FROM panduck_supported_extensions() WHERE format = 'pandoc';
----
pandoc	read_pandoc_blocks

# ---------------------------------------------------------------------------
# A FORMATTED HEADING KEEPS BOTH: a derived flattening in `content` AND the rich inline
# children beside it (duck_block ruling d003d32).
#
# Flattening alone loses formatting irreversibly -- `**Bold** title` and `Bold title`
# become byte-identical, so a round trip rewrites the first as the second. Children alone
# break every consumer that reads a title from `content`: doc_toc, section slugs, any
# table-of-contents query.
#
# The shape marks itself and needs no new vocabulary: a LONE text child lives in `content`
# and produces NO children, so children alongside non-empty content can only mean the
# content is derived. CHILDREN ARE AUTHORITATIVE when both are present.
query IIII
SELECT kind, element_type, level, coalesce(content, '<NULL>') FROM read_pandoc_blocks_string(
  '{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Header","c":[1,["x",[],[]],[{"t":"Strong","c":[{"t":"Str","c":"Bold"}]},{"t":"Space"},{"t":"Str","c":"title"}]]}]}')
ORDER BY element_order;
----
block	heading	1	Bold title
inline	bold	2	(empty)
inline	text	3	Bold
inline	space	2	 
inline	text	2	title

# ...and an UNFORMATTED heading still produces content and NO children, which is the half
# that proves the rule is conditional rather than "always emit both".
query III
SELECT kind, element_type, content FROM read_pandoc_blocks_string(
  '{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Header","c":[1,["x",[],[]],[{"t":"Str","c":"Plain"}]]}]}')
ORDER BY element_order;
----
block	heading	Plain

# ---------------------------------------------------------------------------
# A FORMATTED TABLE CELL MUST NOT VANISH, and it did.
#
# The inline flattener handled only Str/Space/SoftBreak/LineBreak and did not recurse into
# Strong, Emph, Code or Link. A cell whose only content was `**BoldCell**` flattened to the
# EMPTY STRING -- the text was not mangled, it was GONE, inside the native {headers, rows}
# schema whose entire purpose is that cell text be searchable.
#
# Found by measuring a formatted HEADING after duck_block_utils reported the same class in
# duckdb_markdown. The table-cell half is the more serious one and neither of us was
# looking at tables -- the heading was the visible symptom of a flattener used in two
# places.
query I
SELECT content FROM read_pandoc_blocks_string('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[
 {"t":"Table","c":[["",[],[]],[null,[]],[[{"t":"AlignDefault"},{"t":"ColWidthDefault"}]],
  [["",[],[]],[]],
  [[["",[],[]],0,[],[[["",[],[]],[[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Strong","c":[{"t":"Str","c":"BoldCell"}]}]}]]]]]]],
  [["",[],[]],[]]]}]}') WHERE element_type = 'table';
----
{"headers":[],"rows":[["BoldCell"]]}

# ---------------------------------------------------------------------------
# THE FLATTENER MUST REACH ALL THREE INLINE SHAPES, and my first fix reached one.
#
# I claimed a Link's inlines fall out of a general descent "without a per-constructor arm".
# Measured, they do not -- there are THREE shapes and they need three treatments:
#
#   Strong/Emph        `c` IS the inline list              descending reaches it
#   Link/Image         `c` is [attr, [inlines], target]    inlines in an INNER ARRAY, and
#                                                          all three elements are arrays,
#                                                          so an object-only walk stops dead
#   Code/Math/Raw      `c` is [attr, "text"]               a BARE STRING, unreachable by
#                                                          descending at any depth
#
# The third is the one genuinely unavoidable per-constructor arm, and the reason is the
# whole point: A BARE STRING IS INDISTINGUISHABLE FROM A LINK'S URL. A flattener that takes
# every string it walks past recovers the code text AND leaks `http://x.example` into the
# cell. Taking c[1] by position is what keeps one without the other.
query I
SELECT content FROM read_pandoc_blocks('test/fixtures/table_inlines.pandoc.json')
WHERE element_type = 'table';
----
{"headers":["H"],"rows":[["text and co**de"]]}

# THE NEGATIVE ASSERTIONS ARE THE LOAD-BEARING ONES. An assertion that only checks the text
# is PRESENT passes for a leaking implementation -- appending everything it walks past
# recovers the words and the URL together. Only asserting the absence discriminates.
query II
SELECT content NOT LIKE '%x.example%' AS no_host, content NOT LIKE '%http%' AS no_scheme
FROM read_pandoc_blocks('test/fixtures/table_inlines.pandoc.json') WHERE element_type = 'table';
----
true	true

# An image cell keeps its ALT TEXT and not its filename, which is the same discrimination
# on the other constructor: `c` is [attr, [alt], target] and only c[1] is content.
query I
SELECT content FROM read_pandoc_blocks('test/fixtures/table_image.pandoc.json')
WHERE element_type = 'table';
----
{"headers":["H"],"rows":[["alt text"]]}

# ---------------------------------------------------------------------------
# DefinitionList AND Figure MUST SURVIVE THE READ.
#
# Reported by duckeye 2026-09-02, measured on the shipped duck_block_utils v1.4.3:
#
#   pandoc -f rst -t json        ->  ['Header', 'DefinitionList', 'Figure']
#   shipped pandoc_ast_to_blocks ->  heading
#
# Both constructors DROPPED OUTRIGHT at the read boundary -- not degraded, not flattened,
# gone, exit 0. pandoc 3.x wraps every standalone captioned image in a Figure, so that
# silently loses a figure from every format routed through the converter.
#
# panduck's copy is not affected, and this pins that rather than trusting it.
#
# WHAT THIS IS NOT EVIDENCE OF, corrected by duckeye 2026-09-02 after I got it wrong here.
# I compared their SHIPPED v1.4.3 artifact against panduck's SOURCE and concluded panduck
# was uniquely clean. Those are not comparable. duck_block_utils' own main maps
# DefinitionList, LineBlock and Figure too -- so the loss is a property of a RELEASED
# ARTIFACT, not of that codebase, and it is the shipped-versus-main distinction this family
# keeps re-learning, made by me in the other direction this time.
#
# So this guard says panduck's copy is correct. It does not say panduck's copy is the only
# correct one, and it says nothing at all about whether the two copies AGREE -- which is a
# third fact nobody has measured, and the one that actually matters while both exist.
#
# Asserted on ELEMENT TYPES rather than on text. A reader that emitted the definition's
# prose as a bare paragraph and dropped the list around it would satisfy any content check
# while losing exactly what is being guarded -- the structure.
query I
SELECT count(*) FROM read_pandoc_blocks_string(
  '{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"DefinitionList","c":[[[{"t":"Str","c":"Term"}],[[{"t":"Plain","c":[{"t":"Str","c":"Def"}]}]]]]}]}')
WHERE element_type = 'list' AND attributes['list_type'] = 'definition';
----
1

query II
SELECT element_type, attributes['role'] FROM read_pandoc_blocks_string(
  '{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"DefinitionList","c":[[[{"t":"Str","c":"Term"}],[[{"t":"Plain","c":[{"t":"Str","c":"Def"}]}]]]]}]}')
WHERE element_type = 'list_item' ORDER BY element_order;
----
list_item	term
list_item	definition

query I
SELECT count(*) FROM read_pandoc_blocks_string(
  '{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"Cap"}]}]],[{"t":"Plain","c":[{"t":"Image","c":[["",[],[]],[],["p.png","Cap"]]}]}]]}]}')
WHERE element_type = 'figure';
----
1

# The caption and the image both have to come through, not just the figure wrapper.
query I
SELECT count(*) FROM read_pandoc_blocks_string(
  '{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Figure","c":[["",[],[]],[null,[{"t":"Plain","c":[{"t":"Str","c":"Cap"}]}]],[{"t":"Plain","c":[{"t":"Image","c":[["",[],[]],[],["p.png","Cap"]]}]}]]}]}')
WHERE element_type IN ('caption', 'image');
----
2

# ---------------------------------------------------------------------------
# DEEP NESTING RAISES, IT DOES NOT CRASH.
#
# ExtractInlinesTextVal and ExtractInlinesTextValInto are MUTUALLY RECURSIVE, and the
# recursion is driven by the shape of the input. A Pandoc AST is document-controlled --
# anyone handing panduck a .json chooses its nesting -- so an unbounded cycle here is a
# crash reachable from a file.
#
# The bound was lost when the flattener gained its Link/Image arms: that edit ADDED the
# recursion most needing a limit and dropped the parameter carrying it, in one change.
# Measured before the fix, on a term holding N nested Emph:
#
#     depth 10,000  ->  reads fine
#     depth 50,000  ->  SIGSEGV, core dumped
#
# Found by duckeye statically, diffing this file against duck_block_utils' copy: their
# CheckPandocDepth appears 8 times and ours appeared 7. NEITHER REPO'S SUITE COULD SEE IT
# -- the defect existed only in the relationship between two copies that each passed their
# own tests, and a fixture nesting 50,000 deep is not a fixture anyone writes.
#
# The AST is built with repeat() rather than written out, because the assertion needs a
# depth no one would type and the shape is the whole point.
statement error
SELECT count(*) FROM read_pandoc_blocks_string(
  '{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"DefinitionList","c":[[[' ||
  repeat('{"t":"Emph","c":[', 200) || '{"t":"Str","c":"x"}' || repeat(']}', 200) ||
  '],[[{"t":"Plain","c":[{"t":"Str","c":"d"}]}]]]]}]}');
----
exceeded the maximum nesting depth

# ...and a document nested well within the limit still reads, so the guard bounds the
# input rather than rejecting ordinary nesting.
query I
SELECT count(*) > 0 FROM read_pandoc_blocks_string(
  '{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"DefinitionList","c":[[[' ||
  repeat('{"t":"Emph","c":[', 8) || '{"t":"Str","c":"x"}' || repeat(']}', 8) ||
  '],[[{"t":"Plain","c":[{"t":"Str","c":"d"}]}]]]]}]}');
----
true

# THE DATA FIX THE GUARD MUST NOT HAVE UNDONE. Restoring the bound touched every arm of
# the flattener, including the Link/Image arms that recovered formatted cell text -- the
# regression risk runs in both directions. Before that fix this cell flattened to " and ",
# losing both the link text and the bold text.
#
# The AST is pandoc's OWN output for `| [linktext](http://x) and **BoldCell** |`, not a
# hand-written one. I wrote this tuple by hand twice and got it malformed both times, which
# is its own small argument for generating fixtures rather than typing them.
query I
SELECT content FROM read_pandoc_blocks_string(
  '{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Table","c":[["",[],[]],[null,[]],[[{"t":"AlignDefault"},{"t":"ColWidthDefault"}],[{"t":"AlignDefault"},{"t":"ColWidthDefault"}]],[["",[],[]],[[["",[],[]],[[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Str","c":"a"}]}]],[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Str","c":"b"}]}]]]]]],[[["",[],[]],0,[],[[["",[],[]],[[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Link","c":[["",[],[]],[{"t":"Str","c":"linktext"}],["http://x",""]]},{"t":"Space"},{"t":"Str","c":"and"},{"t":"Space"},{"t":"Strong","c":[{"t":"Str","c":"BoldCell"}]}]}]],[["",[],[]],{"t":"AlignDefault"},1,1,[{"t":"Plain","c":[{"t":"Str","c":"plain"}]}]]]]]]],[["",[],[]],[]]]}]}')
WHERE element_type = 'table';
----
{"headers":["a","b"],"rows":[["linktext and BoldCell","plain"]]}
