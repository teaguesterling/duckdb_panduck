# name: test/sql/rtf_reader.test
# description: read_rtf_blocks() over RTF produced by two different real writers
# group: [sql]

#
# The two fixtures were generated by real writers and mark headings by MUTUALLY
# EXCLUSIVE mechanisms -- pandoc emits \outlinelevel and no stylesheet; LibreOffice
# emits a {\stylesheet} with \sN references and no \outlinelevel at all. A reader
# supporting only one silently loses every heading from the other, so both paths are
# asserted independently.

require panduck

# ---------------------------------------------------------------------------
# Heading detection path 1: \outlinelevelN (pandoc)
# ---------------------------------------------------------------------------
query II
SELECT content, attributes['heading_level'] AS lvl
FROM read_rtf_blocks('test/fixtures/pandoc_outlinelevel.rtf')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	1
Heading Two	2

# ---------------------------------------------------------------------------
# Heading detection path 2: \sN resolved through {\stylesheet} (LibreOffice/Word)
# ---------------------------------------------------------------------------
query II
SELECT content, attributes['heading_level'] AS lvl
FROM read_rtf_blocks('test/fixtures/libreoffice_stylesheet.rtf')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	1
Heading Two	2

# THE TWO WRITERS NO LONGER REDUCE TO THE SAME BLOCKS, and the reason is a fact about the
# writers rather than a regression in the reader.
#
# Only LibreOffice emits real list markup. Measured: libreoffice_stylesheet.rtf carries
# \ls and \ilvl and a {\listtext} group, and panduck reads a bullet list from it.
# pandoc's RTF WRITER emits no list control words at all -- it writes the bullet as a
# literal `\bullet` character in an ordinary paragraph -- so pandoc_outlinelevel.rtf has
# paragraphs beginning with a bullet glyph, and pandoc's own reader gives Para for them too.
#
# So what must still agree is the HEADING mechanism, which is what this pair exists to
# prove equivalent: \outlinelevel and {\stylesheet} \sN reach the same result.
query II
SELECT content, attributes['heading_level'] FROM read_rtf_blocks('test/fixtures/pandoc_outlinelevel.rtf')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	1
Heading Two	2

# And the LIST is present in exactly one of them, named rather than counted, so a change
# that invented a list in the pandoc file or lost the one in the LibreOffice file cannot
# pass by coincidence.
query II
SELECT
  (SELECT count(*) FROM read_rtf_blocks('test/fixtures/libreoffice_stylesheet.rtf') WHERE element_type = 'list'),
  (SELECT count(*) FROM read_rtf_blocks('test/fixtures/pandoc_outlinelevel.rtf') WHERE element_type = 'list');
----
1	0

# THE RENDERED BULLET MUST NOT REACH THE TEXT of a real list item. {\listtext ...} holds the
# glyph and its tab, written into the file so a non-list-aware renderer still shows
# something. It is presentation, and including it puts a literal bullet at the front of
# every item -- which is exactly what the pandoc-written file shows, since there the bullet
# IS the content.
query I
SELECT count(*) FROM read_rtf_blocks('test/fixtures/libreoffice_stylesheet.rtf')
WHERE element_type = 'list_item' AND content LIKE '%' || chr(8226) || '%';
----
0

# ---------------------------------------------------------------------------
# Inline runs: character formatting becomes structured inline children, and the
# block's own content is NULL per the duck_block convention for containers.
# ---------------------------------------------------------------------------
query II
SELECT element_type, trim(content) FROM read_rtf_blocks('test/fixtures/pandoc_outlinelevel.rtf')
WHERE kind = 'inline' AND element_type <> 'text' ORDER BY element_order;
----
bold	bold
italic	italic
strikethrough	strike

# A heading always flattens its text into content, even though both writers bold it:
# the bold is part of the heading style, and leaving content NULL would make a table
# of contents built from `content` come back empty.
query I
SELECT count(*) FROM read_rtf_blocks('test/fixtures/pandoc_outlinelevel.rtf')
WHERE element_type = 'heading' AND content IS NULL;
----
0

# ---------------------------------------------------------------------------
# Unicode: \uNNNN escapes decode, and the ANSI fallback that follows is dropped.
# LibreOffice writes those fallbacks as \'hh, which must be skipped as one whole
# character -- trimming decoded bytes instead splits a multi-byte UTF-8 sequence.
# ---------------------------------------------------------------------------
query I
SELECT content FROM read_rtf_blocks('test/fixtures/libreoffice_stylesheet.rtf')
WHERE content LIKE 'Unicode:%';
----
Unicode: café — em-dash, and a tab.

# The decoded text really is multi-byte UTF-8, not mojibake: length() counts
# characters and strlen() counts bytes, so 'café — em-dash' must differ. (DuckDB
# rejects invalid UTF-8 at value construction, so the query running at all already
# proves well-formedness -- this asserts the characters actually decoded.)
query II
SELECT length(content) < strlen(content) AS is_multibyte, contains(content, 'café')
FROM read_rtf_blocks('test/fixtures/libreoffice_stylesheet.rtf')
WHERE content LIKE 'Unicode:%';
----
true	true

# ---------------------------------------------------------------------------
# Destinations are dropped. LibreOffice writes {\*\bkmkstart heading-one} directly
# before the heading text; if ignorable destinations leaked, "heading-one" would be
# prepended to the title. Font and colour tables must not surface either.
# ---------------------------------------------------------------------------
query I
SELECT count(*) FROM read_rtf_blocks('test/fixtures/libreoffice_stylesheet.rtf')
WHERE content LIKE '%bkmkstart%' OR content LIKE '%heading-one%'
   OR content LIKE '%Helvetica%' OR content LIKE '%Courier%' OR content LIKE '%\\red255%';
----
0

# ---------------------------------------------------------------------------
# Row shape matches the duck_block struct, so a row casts straight to duck_block --
# which is what duck_block_utils' doc_to_blocks dispatcher does.
# ---------------------------------------------------------------------------
# 'value' is included ahead of duck_block_utils implementing it, so panduck does not go
# red -- and block a coordinated vocabulary change -- the moment a reader emits metadata.
# duck_block_utils now ships db_block_kinds(); once panduck's suite can depend on it being
# installed this should become
#     WHERE NOT list_contains(db_block_kinds(), kind)
# so the set has one source of truth instead of two. Hardcoding it here is the same defect
# one repo over, and it is temporary for that reason.
query I
SELECT count(*) FROM read_rtf_blocks('test/fixtures/pandoc_outlinelevel.rtf')
WHERE kind NOT IN ('block', 'inline', 'value') OR encoding <> 'text';
----
0

# The guard above counts violations, and an empty document has none -- verified against
# an empty RTF, where it still reports 0. So assert there is something to guard.
query I
SELECT count(*) > 10 FROM read_rtf_blocks('test/fixtures/pandoc_outlinelevel.rtf');
----
true

query I
SELECT count(DISTINCT element_order) = count(*)
FROM read_rtf_blocks('test/fixtures/pandoc_outlinelevel.rtf');
----
true

# A missing file is an error, not silently empty.
statement error
SELECT * FROM read_rtf_blocks('test/fixtures/does_not_exist.rtf');
----
file not found

# ---------------------------------------------------------------------------
# TABLES. RTF has no table ELEMENT: a table is a run of paragraphs marked \intbl, with
# \cell ending each cell and \row each row. So the reader accumulates rather than descends.
#
# \pard fires at the start of EVERY row, so it cannot end the table -- doing that produced
# one table per row. The table ends when a paragraph arrives that is not in it.
#
# No header: \trhdr is absent from this file, and pandoc reports 0 header rows and 3 body
# rows for it. Inventing a header from the first row would disagree with both the document
# and the reference.
query III
SELECT element_type, encoding, content FROM read_rtf_blocks('test/fixtures/rich.rtf')
WHERE element_type = 'table';
----
table	json	{"headers":[],"rows":[["Name","Value"],["a","1"],["b","2"]]}
