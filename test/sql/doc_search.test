# name: test/sql/doc_search.test
# description: doc_section pattern matching and doc_search_sections — find a section by fragment
# group: [sql]

#
# TWO WAYS TO ASK FOR A SECTION, and they bound it differently on purpose.
#
#   doc_section(src, section)        -- BY HEADING. Stops at the next heading of the SAME
#                                       OR HIGHER level, so a chapter yields its subsections.
#   doc_search_sections(src, pattern) -- BY CONTENT. Stops at the next heading of ANY level,
#                                       so you get the INNERMOST section holding the match
#                                       and not its parent's other children.
#
# Both were measured against duckeye's -S and -s, which arrived at the same span arithmetic
# independently. duckeye reported the gap: doc_section matched only an exact title or id,
# but "a viewer's user types a fragment, not a heading verbatim".
#
# THESE FIXTURES ARE .textile, AND THAT IS THE SECOND CHOICE. They were .md first, which was
# wrong for a reason that does not show up locally: READING MARKDOWN NEEDS THE markdown
# COMMUNITY EXTENSION, which a dev machine has installed and CI does not. All twelve local
# gates passed and CI failed with
#
#     panduck: test/fixtures/search_sections.textile needs the markdown extension
#
# panduck_dependencies() is the authority: markdown, html, pdf, json, yaml, toml, excel and
# zim each need an external extension; anything absent from that table -- textile, org, rst,
# latex, odt, rtf, docx, epub -- panduck reads natively. A fixture in a DEPENDENT format
# makes a test that cannot run in a clean environment, and a local pass says nothing about it.
#
# textile specifically because it is the only native format measured that generates heading
# id slugs ('Alpha One' -> 'alpha-one'), which the id-arm assertions below need. org, rst,
# latex, odt and rtf all produce headings with a NULL id. And no test re-registers
# '.textile' -- checked by extracting the extension list from every panduck_register_*_reader
# call in test/sql/.
#
# Every assertion below is on block CONTENT, never on a resolved format string. That is the
# lesson from the '.rtf' assertion in doc_namespace.test: asserting on a format string is
# what makes a test hostage to the process-wide registry (#10).

require panduck

# test/fixtures/search_sections.textile, as blocks. Referenced by element_order throughout, so
# the spans below are checkable by hand:
#
#   0  paragraph  Preamble prose that belongs to no heading.
#   1  heading    Alpha            level 1   id alpha
#   2  paragraph  alpha body
#   3  heading    Alpha One        level 2   id alpha-one
#   4  paragraph  alpha one body
#   5  heading    Beta             level 1   id beta
#   6  paragraph  beta body
#   7  heading    Beta One         level 2   id beta-one
#   8  paragraph  beta one body

#
# ---------------------------------------------------------------------------------------
# doc_section: THE DEFAULT IS STILL EXACT. This is the compatibility assertion.
# ---------------------------------------------------------------------------------------
#
# Substring matching is opt-in through `match`, NOT the new default. An exact-title lookup
# is a superset-free contract a caller may already depend on: switching the default to
# ILIKE can only ever return MORE rows, silently, for someone who was matching a title
# verbatim. duckeye offered "either a substring mode on doc_section or a sibling that takes
# a pattern"; a mode keeps one function and one span implementation.

query I
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', 'Alpha');
----
4

# The fragment duckeye measured as returning 0. Still 0 by default -- unchanged behaviour.
query I
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', 'Alph');
----
0

# 'alpha' DOES match -- not as a lowercase title, but as the generated slug id. The exact
# predicate is `content = section OR attributes['id'] = section`, and the markdown reader
# slugs 'Alpha' to 'alpha'. Recorded because it is the reason the case-sensitivity check
# below had to use a spelling that is neither the title nor the slug.
query I
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', 'alpha');
----
4

# ...and exact IS exact about case: 'ALPHA' is neither the title 'Alpha' nor the id 'alpha'.
query I
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', 'ALPHA');
----
0

# match := 'exact' spells the default out loud and changes nothing.
query I
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', 'Alpha', match := 'exact');
----
4

#
# ---------------------------------------------------------------------------------------
# doc_section(match := 'contains'): title ILIKE '%pat%' OR id = pat
# ---------------------------------------------------------------------------------------
#
# duckeye's -S predicate exactly: the TITLE matches as a case-insensitive substring, the ID
# matches whole. An id is a slug the caller either has or does not; a substring of it is not
# a meaningful request, and 'alpha-one' matching 'alpha' would collide with the title arm.

query I
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', 'Alph', match := 'contains');
----
4

# ILIKE, so case-insensitive.
query I
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', 'alpha', match := 'contains');
----
4

# THE CONTAINMENT DEDUP. 'Alph' matches BOTH 'Alpha' (level 1, span 2..5) and 'Alpha One'
# (level 2, span 4..5). Without the dedup this returns 6 rows -- orders 2,3,4,5 from the
# chapter plus 4,5 AGAIN from the subsection, printing the child twice. duckeye flagged this
# as "easy to miss until someone searches for a word that appears in two nested headings".
query I
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', 'Alph', match := 'contains');
----
4

# Same thing, checked by content rather than by count, so a wrong-but-equal-sized result
# cannot pass. Each block appears exactly once and in document order.
query II
SELECT element_order, content
FROM doc_section('test/fixtures/search_sections.textile', 'Alph', match := 'contains');
----
1	Alpha
2	alpha body
3	Alpha One
4	alpha one body

# TWO DISJOINT SPANS BOTH SURVIVE. 'One' matches 'Alpha One' (span 4..5) and 'Beta One'
# (span 8..9). Neither contains the other, so the dedup must NOT drop either -- the mirror
# of the assertion above, and the reason the rule is "contained by", not "overlaps".
query II
SELECT element_order, content
FROM doc_section('test/fixtures/search_sections.textile', 'One', match := 'contains');
----
3	Alpha One
4	alpha one body
7	Beta One
8	beta one body

# THE LAST SECTION RUNS TO THE END OF THE DOCUMENT. 'Beta One' has no following heading at
# level <= 2, so its span is open-ended rather than empty.
query I
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', 'Beta One', match := 'contains');
----
2

# AN ID STILL MATCHES WHOLE in contains mode -- the OR arm, not the ILIKE arm.
query I
SELECT count(*) > 0 FROM doc_section('test/fixtures/search_sections.textile', 'alpha-one', match := 'contains');
----
true

# ...AND THE ID ARM DECLINES A SUBSTRING. The assertion above proves the arm exists; it does
# NOT prove it is whole-string, because 'alpha-one' is also matched by the title arm through
# ILIKE. Only a pattern that substrings the ID and NOT the title isolates it, and 'alpha-'
# is that shape: the id 'alpha-one' contains it, the title 'Alpha One' has no hyphen.
#
# duckeye hit this exact trap from the other side and reported it: it first tested the id
# arm with '-S zeb' against a heading 'Zebra', which matched -- but through
# `title ILIKE '%zeb%'`, not the id, making the test worthless as evidence about ids. Its
# isolating case was '-S install-up' against a heading 'Install & Update' with id
# 'install-update'. Both tools decline it; both arrived at "an id is a slug the caller
# either has or does not" separately.
query I
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', 'alpha-', match := 'contains');
----
0

# The control for the assertion above: the SAME id, whole, does match. Without this pair the
# 0 above could equally mean the id arm is broken outright.
query I
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', 'alpha-one', match := 'contains');
----
2

# % IS A LIVE WILDCARD, not a literal, because the pattern goes to ILIKE. Documented rather
# than defended: duckeye's -S is `title ILIKE '%pat%' ESCAPE '\'` and delegating means
# spelling it the same way. 'A%a' matches both Alpha headings, which then dedup to one span.
query I
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', 'A%a', match := 'contains');
----
4

# ...and ESCAPE '\' is what makes a literal percent reachable at all.
query I
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', '\%', match := 'contains');
----
0

# No match is empty, not an error -- same contract as exact mode.
query I
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', 'no such fragment', match := 'contains');
----
0

# AN UNKNOWN MODE IS REFUSED BY NAME, and the message says what the caller wrote. Silently
# treating a typo as 'exact' would return 0 rows and read as "no such section".
statement error
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', 'Alpha', match := 'substring');
----
substring is not one of them

statement error
SELECT count(*) FROM doc_section('test/fixtures/search_sections.textile', 'Alpha', match := 'substring');
----
doc_section match must be

#
# ---------------------------------------------------------------------------------------
# doc_search_sections: THE INNERMOST SECTION WHOSE TEXT MATCHES
# ---------------------------------------------------------------------------------------
#
# Spans stop at the next heading of ANY level. That is the whole difference from
# doc_section, and it is what "innermost" means: the match under 'Alpha One' returns
# 'Alpha One', never the enclosing 'Alpha'.

# 'alpha body' appears only under 'Alpha'. doc_section('Alpha') returns 4 rows because it
# carries the subsection along; this returns 2, because the innermost section holding the
# phrase ends at the next heading of ANY level.
query II
SELECT element_order, content
FROM doc_search_sections('test/fixtures/search_sections.textile', 'alpha body');
----
1	Alpha
2	alpha body

# The parent is NOT returned when the match is in the child.
query II
SELECT element_order, content
FROM doc_search_sections('test/fixtures/search_sections.textile', 'alpha one body');
----
3	Alpha One
4	alpha one body

# Two innermost sections can match at once, and they stay in document order.
query II
SELECT element_order, content
FROM doc_search_sections('test/fixtures/search_sections.textile', 'one body');
----
3	Alpha One
4	alpha one body
7	Beta One
8	beta one body

# THE HEADING'S OWN TEXT COUNTS as part of the section it opens. 'Beta One' appears nowhere
# but in that heading, so a hit proves the heading text was flattened in with the body --
# and only the innermost section comes back, not the enclosing 'Beta' and its other child.
query II
SELECT element_order, content
FROM doc_search_sections('test/fixtures/search_sections.textile', 'Beta One');
----
7	Beta One
8	beta one body

# ...and the sibling case, recorded because it is the one that surprised me: 'Beta' matches
# TWO segments, since the text of 'Beta One' contains it. The pattern is a substring over
# flattened text, so a heading that is a prefix of another heading selects both sections.
# Nothing is deduped here -- unlike doc_section, these segments are disjoint by construction
# (every heading ends the previous segment), so neither contains the other.
query II
SELECT element_order, content
FROM doc_search_sections('test/fixtures/search_sections.textile', 'Beta');
----
5	Beta
6	beta body
7	Beta One
8	beta one body

# CONTENT BEFORE THE FIRST HEADING IS A SECTION. duckeye: "It also needs a span covering
# anything before the first heading ... both of which I got wrong before fixing them."
# Without this the preamble is unreachable by any query, since it belongs to no heading.
query II
SELECT element_order, content
FROM doc_search_sections('test/fixtures/search_sections.textile', 'Preamble');
----
0	Preamble prose that belongs to no heading.

# ILIKE here too, for the same reason as doc_section.
query I
SELECT count(*) FROM doc_search_sections('test/fixtures/search_sections.textile', 'PREAMBLE');
----
1

# A DOCUMENT WITH NO HEADINGS AT ALL IS ONE SECTION. The other half of what duckeye got
# wrong first: with no heading to anchor a span, the whole document is the section, so a
# matching document returns everything rather than nothing.
query II
SELECT element_order, content
FROM doc_search_sections('test/fixtures/no_headings.textile', 'prose');
----
0	Only prose here.
1	Still no heading anywhere.

# The match is against the section's FLATTENED text, so a phrase spanning two blocks still
# selects the section -- 'here' is in block 1 and 'heading' in block 2, and either finds it.
query I
SELECT count(*) FROM doc_search_sections('test/fixtures/no_headings.textile', 'heading anywhere');
----
2

# No match is empty, not an error.
query I
SELECT count(*) FROM doc_search_sections('test/fixtures/no_headings.textile', 'zzz nothing');
----
0

# Same seven duck_block columns as doc_section, in the same order -- this is a sibling, not
# a new shape. A caller can UNION the two.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM doc_search_sections('test/fixtures/no_headings.textile', 'prose'));
----
7

query I
SELECT list(column_name ORDER BY column_name) = list_sort(['kind', 'element_type', 'content',
                                                           'level', 'encoding', 'attributes',
                                                           'element_order'])
FROM (DESCRIBE SELECT * FROM doc_search_sections('test/fixtures/no_headings.textile', 'prose'));
----
true

#
# ---------------------------------------------------------------------------------------
# BOTH REFUSE A PLURAL SOURCE, for the reason doc_section already did: element_order
# restarts per document, so a glob interleaves them and every span is wrong.
# ---------------------------------------------------------------------------------------

statement error
SELECT count(*) FROM doc_search_sections('test/fixtures/*.textile', 'prose');
----
doc_search_sections takes a single document

statement error
SELECT count(*) FROM doc_search_sections(['test/fixtures/no_headings.textile', 'test/fixtures/search_sections.textile'], 'prose');
----
doc_search_sections takes a single document

# doc_section's existing guard must survive the match parameter.
statement error
SELECT count(*) FROM doc_section('test/fixtures/*.textile', 'Alpha', match := 'contains');
----
doc_section takes a single document

# A ONE-MATCH GLOB IS ONE DOCUMENT and must still work -- the distinction doc_section's
# guard already draws, re-checked on the new surface so it is not re-lost here.
query I
SELECT count(*) FROM doc_search_sections('test/fixtures/no_head*.textile', 'prose');
----
2

# format := is accepted and forwarded, same as doc_section.
query I
SELECT count(*) FROM doc_search_sections('test/fixtures/no_headings.textile', 'prose', format := 'textile');
----
2

#
# ---------------------------------------------------------------------------------------
# INVARIANTS. These say something about the SHAPE of any result, not about one query, so
# they catch span arithmetic that is wrong in a way the worked examples above happen to
# agree with.
# ---------------------------------------------------------------------------------------

# THE SEGMENTS PARTITION THE DOCUMENT. An empty pattern is `ILIKE '%%'`, which every segment
# matches, so the result must be the whole document exactly once -- no block missed (the
# preamble is the one that goes missing) and none counted twice. Checked on README.md while
# writing this: 476 of 476.
query I
SELECT count(*) = (SELECT count(*) FROM read_panduck_doc('test/fixtures/search_sections.textile'))
FROM doc_search_sections('test/fixtures/search_sections.textile', '');
----
true

# NO BLOCK IS EVER EMITTED TWICE by either function, for a pattern that matches two NESTED
# headings. This is the containment dedup stated as a property; the worked example above
# pins one expected list, this pins the rule. Run across nine patterns on README.md while
# writing this, including ones matching the top-level heading (476 blocks, 0 duplicates).
query I
SELECT count(*) = count(DISTINCT element_order)
FROM doc_section('test/fixtures/search_sections.textile', 'Alph', match := 'contains');
----
true

query I
SELECT count(*) = count(DISTINCT element_order)
FROM doc_search_sections('test/fixtures/search_sections.textile', 'body');
----
true

# CONTAINS IS A SUPERSET OF EXACT for the same needle. ILIKE '%x%' matches everything
# `= x` does, so contains can only ever widen -- which is exactly why it is not the
# default. Verified against all twelve README.md headings while writing this.
query I
SELECT count(*) = 0 FROM (
  SELECT element_order FROM doc_section('test/fixtures/search_sections.textile', 'Alpha')
  EXCEPT
  SELECT element_order FROM doc_section('test/fixtures/search_sections.textile', 'Alpha', match := 'contains'));
----
true

#
# ---------------------------------------------------------------------------------------
# A BLOCK WITH NO CONTENT CONTRIBUTES NO SEPARATOR.
# ---------------------------------------------------------------------------------------
#
# test/fixtures/null_content.textile is `h1. Heading / alpha / !img.png! / beta`. The image
# yields TWO blocks with NULL content -- a paragraph wrapper and the image itself -- sitting
# between two visible paragraphs. Flattening each as '' still earns it a separator, so the
# text came out
#
#     [Heading alpha   beta]      <- THREE spaces, from coalesce(content, '')
#
# (The markdown version of this fixture used an `hr` and produced two spaces. Same defect;
# textile reaches it with an image because panduck reads textile natively and markdown not.)
#
# and doc_search_sections(doc, 'alpha beta') returned 0. The doubled space exists nowhere in
# the document; it is an artifact of the join. A caller cannot predict it without knowing
# which invisible blocks sit between two visible ones -- which is precisely the knowledge
# reading a document is supposed to save them.
#
# Found by duckeye, comparing its own -s against this function on a constructed case after
# twelve patterns on a real 696-block document agreed exactly. None of those twelve happened
# to straddle a NULL-content block. It could not have been found by adding more patterns to
# that document; the two flattening contracts differed, and only a built case separates
# them. duckeye's README carries 81 NULL-content blocks out of 696 and panduck's own carries
# 71 of 476 -- hr, list, list_item, link, bold, image, paragraph -- measured on both, so this
# is the common shape of a document rather than an exotic one.

query I
SELECT count(*) FROM doc_search_sections('test/fixtures/null_content.textile', 'alpha beta');
----
5

# The flattened text contains what the document contains, and nothing the join invented.
query I
SELECT count(*) FROM doc_search_sections('test/fixtures/null_content.textile', 'alpha  beta');
----
0

# The NULL-content block is still RETURNED -- it is part of the section. Only its
# contribution to the MATCH TEXT is dropped, which is a statement about searching, not about
# what a section contains.
query II
SELECT element_order, element_type
FROM doc_search_sections('test/fixtures/null_content.textile', 'alpha beta');
----
0	heading
1	paragraph
2	paragraph
3	image
4	paragraph

# A SEGMENT WHOSE BLOCKS ARE *ALL* CONTENTLESS STILL EXISTS. test/fixtures/empty_preamble.textile
# opens with an image before its first heading, so the preamble segment flattens to nothing at
# all. Skipping contentless blocks (above) made that aggregate NULL, and `NULL ILIKE '%%'` is
# NULL rather than true -- so the empty pattern dropped the leading blocks, and they vanished
# from a result that is supposed to be the whole document.
#
# CAUGHT BY THE PARTITION INVARIANT, not by a worked example, and introduced BY the fix for
# the doubled separator directly above it. Worth stating plainly: the fix for one flattening
# bug opened another, one CTE away, and only the property test noticed. Empty text and absent
# text are different, and ILIKE treats them differently.
query I
SELECT count(*) = (SELECT count(*) FROM read_panduck_doc('test/fixtures/empty_preamble.textile'))
FROM doc_search_sections('test/fixtures/empty_preamble.textile', '');
----
true

# ...and that same segment must NOT match a real pattern: it has no text to match.
query II
SELECT element_order, element_type
FROM doc_search_sections('test/fixtures/empty_preamble.textile', 'body');
----
2	heading
3	paragraph
