# name: test/sql/html_attributes.test
# description: reader options end to end -- the option changes what the READER returns
# group: [sql]

#
# THIS FILE WAS GATED FOR ITS WHOLE LIFE UNTIL NOW.
#
# It is the only assertion in panduck that a SIBLING READER ACTUALLY HONOURS AN OPTION --
# everything else proves panduck generates the right SQL, which is a different claim. Its
# premise was unreleased webbed: `capture_attributes` existed only on their main, so the
# file sat behind require-env and executed nowhere. An assertion that cannot fail occupies
# the space where a real check would go, which is worse than not having one.
#
# webbed v2.9.0 (73189d2) is now SERVED from the community registry -- confirmed by a
# clean-directory install, not by the tag existing -- so the premise is real and the gate
# is gone.

require panduck

statement ok
INSTALL webbed;

statement ok
LOAD webbed;

# THIS REGISTRATION OVERRIDES A BUILTIN THAT NOW EXISTS. panduck ships
# attributes := 'all' -> capture_attributes := '*' on its .html rows, so the builtin path is
# asserted separately below. This registration is still worth keeping: it is the shape a
# caller uses to teach panduck a sibling's spelling, and it maps to 'classes' rather than
# '*' so the two paths cannot pass for one another.
statement ok
CALL panduck_register_doc_reader('webbed', 'read_html_blocks', ['.html'],
     options := [{intent: 'attributes', value: 'all',
                  param: 'capture_attributes', arg: 'classes', arg_type: 'VARCHAR'}]);

query I
SELECT count(*) > 0 FROM read_panduck_doc('test/fixtures/constructs.html', attributes := 'all')
WHERE attributes['class'] IS NOT NULL;
----
true

query I
SELECT (SELECT count(*) FROM read_panduck_doc('test/fixtures/constructs.html', attributes := 'all')
        WHERE attributes['class'] IS NOT NULL)
     > (SELECT count(*) FROM read_panduck_doc('test/fixtures/constructs.html')
        WHERE attributes['class'] IS NOT NULL);
----
true

# AND IT CARRIES ACROSS A PLURAL READ, which is the branch options exist for: one arm per
# path, each rendering the option independently from its own registry row.
query I
SELECT count(*) > 0 FROM read_panduck_doc(['test/fixtures/constructs.html',
                                           'test/fixtures/containers.html'],
                                          attributes := 'all')
WHERE attributes['class'] IS NOT NULL;
----
true

# ---------------------------------------------------------------------------
# THE BUILTIN MAPPING, with nothing registered.
#
# Until webbed published `capture_attributes` there was no builtin mapping for any reader,
# and `attributes := 'all'` raised on all 22 doc rows -- correct at the time, since naming a
# parameter that did not exist would have surfaced webbed's binder error instead of
# panduck's. Now it maps to '*', which is webbed's spelling for EVERY source attribute.
#
# ASSERTED AS A DELTA, not as "> 0". A mapping to 'classes' -- webbed's default PLUS class,
# five attributes rather than all of them -- would satisfy any threshold this fixture can
# produce while silently giving a caller less than they asked for. The default arm is what
# makes the number mean something.
query II
SELECT (SELECT count(*) FROM read_panduck_doc('test/fixtures/containers.html')
        WHERE attributes['class'] IS NOT NULL) AS with_default,
       (SELECT count(*) FROM read_panduck_doc('test/fixtures/containers.html', attributes := 'all')
        WHERE attributes['class'] IS NOT NULL) > 0 AS with_all;
----
0	true
