# name: test/sql/multidoc.test
# description: multi-document reads -- glob expansion, plural sources, provenance
# group: [sql]

require panduck

# panduck_glob is the one primitive this feature needs in C++. DuckDB's own glob is a TABLE
# function, and dispatch cannot use it: a table function's arguments must be literals, so
# neither `LATERAL read_odt_blocks(g.file)` nor `query((SELECT ... FROM glob(...)))` binds.
# A scalar returning a list can be consumed by the scalar expression that builds dispatch's
# SQL string, which is the whole mechanism.
query I
SELECT len(panduck_glob('test/fixtures/*.odt')) > 1;
----
true

# Sorted, so a UNION ALL built from it is deterministic across runs and platforms. This
# `= list_sort(...)` form is necessary but NOT sufficient: LocalFileSystem's glob does not
# sort internally, and on a checkout where the directory's natural enumeration order
# already happens to be alphabetical, this assertion passes whether or not panduck_glob
# sorts at all -- it would not catch a regression that deleted the sort. Kept anyway as a
# structural check, but see the next assertion for the one that actually pins the order.
query I
SELECT panduck_glob('test/fixtures/*.odt') = list_sort(panduck_glob('test/fixtures/*.odt'));
----
true

# A concrete, order-pinning assertion. Narrowed to the "constructs.*" prefix (six files,
# one per format-under-test) rather than "*.odt" or all fixtures, so it does not need
# updating every time an unrelated fixture is added elsewhere in the directory -- only a
# change to the constructs.* set itself would touch this list. The expected order below
# was produced by running panduck_glob itself and pasting its output, not hand-derived,
# so this test fails if sorting is removed even on a filesystem whose natural enumeration
# order happens to already be alphabetical (see the note above).
query I
SELECT panduck_glob('test/fixtures/constructs.*');
----
[test/fixtures/constructs.docx, test/fixtures/constructs.html, test/fixtures/constructs.odt, test/fixtures/constructs.rst, test/fixtures/constructs.source.md, test/fixtures/constructs.textile]

# An exact path that exists resolves to itself.
query I
SELECT panduck_glob('test/fixtures/constructs.odt');
----
[test/fixtures/constructs.odt]

# NOTHING MATCHED IS AN EMPTY LIST, NOT AN ERROR. The primitive is neutral and the policy
# lives in dispatch (Task 4), so there is exactly one site to change if the rule is ever
# revisited, and a future caller wanting "possibly none" has something to build on.
query I
SELECT len(panduck_glob('test/fixtures/*.nothing_matches_this'));
----
0

# NULL in, NULL out -- ordinary scalar-function NULL propagation, not "no match".
query I
SELECT panduck_glob(NULL) IS NULL;
----
true

# NULL (unknown pattern) and empty list (known pattern, zero matches) are two different
# outcomes a caller could otherwise confuse; assert they stay distinguishable.
query I
SELECT panduck_glob(NULL) IS NULL AND len(panduck_glob('test/fixtures/*.no_such')) = 0;
----
true

# ---------------------------------------------------------------------------
# One normalisation for every source form, so nothing downstream branches on which form
# the caller used. A plain path is NOT sent through the filesystem: a caller naming one
# file should get the same behaviour they get today, including the reader's own error if
# it does not exist, rather than a glob-shaped error from panduck.
# ---------------------------------------------------------------------------
query I
SELECT panduck_source_list('test/fixtures/constructs.odt');
----
[test/fixtures/constructs.odt]

query I
SELECT len(panduck_source_list('test/fixtures/*.odt')) > 1;
----
true

query I
SELECT panduck_source_list(['a.odt', 'b.docx']);
----
[a.odt, b.docx]

# A list element may itself glob, and order follows the argument, not the filesystem.
query I
SELECT len(panduck_source_list(['test/fixtures/constructs.odt', 'test/fixtures/*.odt']))
     = 1 + len(panduck_glob('test/fixtures/*.odt'));
----
true

# The count check above constrains cardinality, not order -- and order is the property
# this macro exists to guarantee, since a later task builds a UNION ALL from this list and
# the generated SQL must be deterministic. This pins the actual sequence: the explicit
# path comes FIRST, and the glob's own (sorted) expansion follows in place.
query I
SELECT panduck_source_list(['test/fixtures/constructs.odt', 'test/fixtures/*.odt'])
     = ['test/fixtures/constructs.odt'] || panduck_glob('test/fixtures/*.odt');
----
true

# A companion that fails if the order were reversed, so the assertion above is not
# satisfiable by a symmetric bug (e.g. concatenating the two halves in the wrong order).
# Uses 'lists.odt' rather than 'constructs.odt' deliberately: 'constructs.odt' sorts
# FIRST among the '*.odt' matches, so an explicit-path-vs-glob swap would coincidentally
# still land it at position [1] and this check would pass either way. 'lists.odt' sorts
# third, so a swap puts the glob's own first match ('constructs.odt') at [1] instead,
# which is not 'lists.odt' -- the check can actually fail.
query I
SELECT panduck_source_list(['test/fixtures/lists.odt', 'test/fixtures/*.odt'])[1]
     = 'test/fixtures/lists.odt';
----
true

# A non-existent plain path passes through untouched -- panduck does not pre-validate it.
query I
SELECT panduck_source_list('no/such/file.odt');
----
[no/such/file.odt]

# ---------------------------------------------------------------------------
# The generated SQL is asserted as a STRING before anything runs it. A test that only
# checked row counts would pass on SQL that happened to work while emitting the provenance
# column in the wrong POSITION -- which is exactly the defect that shipped in two sibling
# extensions (webbed a865d37, markdown 340c0cd both emitted filename FIRST, which spec 6.4
# refuses). Asserting the string catches it in the producer.
# ---------------------------------------------------------------------------
query I
SELECT panduck_read_arms(['a.odt'], false);
----
SELECT * FROM read_odt_blocks('a.odt')

# filename LAST, after the canonical seven, because SELECT * emits them first. Trailing is
# not cosmetic: spec 6.4 keys 8-field acceptance on the exact type with filename last, and
# every consumer reads the struct BY INDEX, so a leading column puts the path where kind is
# expected.
query I
SELECT panduck_read_arms(['a.odt'], true);
----
SELECT *, 'a.odt' AS filename FROM read_odt_blocks('a.odt')

query I
SELECT panduck_read_arms(['a.odt', 'b.html'], true);
----
SELECT *, 'a.odt' AS filename FROM read_odt_blocks('a.odt') UNION ALL SELECT *, 'b.html' AS filename FROM read_html_blocks('b.html')

# A path with a quote in it survives, because every interpolated value goes through
# panduck_quote. This is the assertion that the string builder is not concatenating.
query I
SELECT contains(panduck_read_arms(['o''brien.odt'], true), 'o''''brien.odt');
----
true

# ---------------------------------------------------------------------------
# A glob returns exactly the sum of the individual reads. Written as a computed equality
# rather than a literal so that adding an .odt fixture cannot silently invalidate it.
#
# Not written as a correlated subquery over unnest(panduck_glob(...)) -- DuckDB v1.5.5
# refuses that outright ("Table function ... does not support lateral join column
# parameters"), and that restriction is unconditional: it reproduces on read_csv and on
# read_odt_blocks called directly, with no panduck code in the path at all. So the per-path
# counts are summed by building one query() arm per path instead, the same technique
# panduck_read_arms itself uses, keeping every path a compile-time literal.
# ---------------------------------------------------------------------------
query I
SELECT (SELECT count(*) FROM read_panduck_doc('test/fixtures/*.odt'))
     = (SELECT sum(n) FROM query(
         array_to_string(list_transform(panduck_glob('test/fixtures/*.odt'),
             lambda p: 'SELECT count(*) AS n FROM read_panduck_doc(' || panduck_quote(p) || ')'),
             ' UNION ALL ')));
----
true

# Mixed formats in one call, each path dispatched through the registry independently.
#
# NOT preceded by INSTALL/LOAD webbed. panduck_read_arms wraps each arm in the same
# panduck_ensure_extension gate the single-path branch uses -- and that gate does not
# merely produce a nicer error, it IS TryAutoLoadExtension (reader_registry.cpp), so the
# .html arm autoloads webbed on its own. An explicit LOAD here would hide a regression in
# the gate rather than prove it works.
query I
SELECT count(DISTINCT filename)
FROM read_panduck_doc(['test/fixtures/constructs.odt', 'test/fixtures/constructs.html'],
                      filename := true);
----
2

# PROVENANCE IS OFF BY DEFAULT FOR EVERY SOURCE FORM. A default that changed shape with
# the form of the argument would mean read_panduck_doc(x) returns seven or eight columns
# depending on whether x contains a '*' -- a rule every caller must know and none can see
# at the call site. It is also what keeps the default output consumable by a RELEASED
# duck_block_utils, which refuses an 8-field struct.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_panduck_doc('test/fixtures/*.odt'));
----
7

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_panduck_doc('test/fixtures/constructs.odt'));
----
7

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_panduck_doc('test/fixtures/*.odt', filename := true));
----
8

# element_order is PER DOCUMENT. Making it global would break every consumer that uses it
# to reconstruct one document's order -- doc_section, doc_container, the pandoc writer.
query I
SELECT bool_and(has_zero) FROM (
  SELECT bool_or(element_order = 0) AS has_zero
  FROM read_panduck_doc('test/fixtures/*.odt', filename := true)
  GROUP BY filename);
----
true

# A glob matching nothing RAISES, matching DuckDB core, which errors identically for a
# pattern that matches nothing and for a named file that is absent.
statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/*.nothing_matches_this');
----
no files matched

# The default output is byte-identical to today's for a single path -- the check that this
# feature is additive and that a caller on a released duck_block_utils is unaffected.
query I
SELECT (SELECT count(*) FROM read_panduck_doc('test/fixtures/constructs.odt'))
     = (SELECT count(*) FROM read_odt_blocks('test/fixtures/constructs.odt'));
----
true

# ---------------------------------------------------------------------------
# ROUND-1 REVIEW FIXES. Four regressions found in review, each covered here and each also
# verified in isolation (its own scratch file, run alone) because sqllogictest aborts at
# the first failing assertion in a file -- a whole-file pass proves only that something
# before the last assertion did not fail, not that any one assertion is doing its job.
# ---------------------------------------------------------------------------

# CRITICAL 1 (autoload gate) is covered by the mixed-format assertion above, which now
# runs with no preceding INSTALL/LOAD webbed.

# CRITICAL 2: a format with no registry function (pdf, toml, yaml, zim, and every
# KIND_TABLE format) inside a plural call is REFUSED LOUDLY, not silently dropped.
# Before this fix: read_panduck_doc(['constructs.odt', 'two_pages.pdf']) returned 54 rows
# -- exactly constructs.odt alone -- because array_to_string skips the NULL arm a reader
# with no registry function produces.
statement error
SELECT count(*) FROM read_panduck_doc(['test/fixtures/constructs.odt', 'test/fixtures/two_pages.pdf']);
----
cannot be read in a multi-document call yet

# IMPORTANT 1: `pages` is no longer silently ignored on a glob. The plural branch now runs
# after this guard, so a glob is checked exactly like a plain path is.
statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/*.odt', pages := 'nonsense');
----
pages applies only to paginated formats

# IMPORTANT 2: a glob NESTED inside a list that matches nothing raises, naming that
# element specifically -- not silently dropped by flatten(). Before this fix:
# read_panduck_doc(['test/fixtures/constructs.odt', 'test/fixtures/*.nomatch']) returned
# rows for constructs.odt alone, with no error, because the length check ran only on the
# flattened (and therefore already-collapsed) list.
statement error
SELECT count(*) FROM read_panduck_doc(['test/fixtures/constructs.odt', 'test/fixtures/*.nomatch']);
----
no files matched
