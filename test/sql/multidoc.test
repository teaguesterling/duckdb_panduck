# name: test/sql/multidoc.test
# description: multi-document reads -- glob expansion, plural sources, provenance
# group: [sql]

require panduck

# INSTALL BUT DELIBERATELY DO NOT LOAD. The distinction is the whole point of the gate this
# file asserts, and it is not cosmetic:
#
#   panduck_ensure_extension  ->  TryAutoLoadExtension  ->  LOADs an INSTALLED extension.
#                                 It cannot INSTALL one. Measured: with an empty
#                                 extension_directory, panduck_ensure_extension('webbed')
#                                 returns FALSE.
#
# So the arms below need webbed present on disk, but must NOT have it loaded -- loading it
# here would hide a regression in the per-arm gate, which is exactly what the mixed-format
# assertions exist to catch.
#
# Without the INSTALL this file passes on a developer machine whose shared ~/.duckdb profile
# happens to hold webbed, and fails in a clean container -- or worse, passes there too but
# only because some other test file installed it first, making the result depend on file
# execution order. register_reader.test failed CI for precisely that reason.
statement ok
INSTALL webbed;

# panduck_glob is the one primitive this feature needs in C++. DuckDB's own glob is a TABLE
# function, and dispatch cannot use it: a table function's arguments must be literals, so
# neither `LATERAL read_odt_blocks(g.file)` nor `query((SELECT ... FROM glob(...)))` binds.
# A scalar returning a list can be consumed by the scalar expression that builds dispatch's
# SQL string, which is the whole mechanism.
query I
SELECT len(panduck_glob('test/fixtures/*.odt')) > 1;
----
true

# Sorted, so a UNION ALL built from it is deterministic across runs and platforms. This
# `= list_sort(...)` form is necessary but NOT sufficient: LocalFileSystem's glob does not
# sort internally, and on a checkout where the directory's natural enumeration order
# already happens to be alphabetical, this assertion passes whether or not panduck_glob
# sorts at all -- it would not catch a regression that deleted the sort. Kept anyway as a
# structural check, but see the next assertion for the one that actually pins the order.
query I
SELECT panduck_glob('test/fixtures/*.odt') = list_sort(panduck_glob('test/fixtures/*.odt'));
----
true

# A concrete, order-pinning assertion. Narrowed to the "constructs.*" prefix (six files,
# one per format-under-test) rather than "*.odt" or all fixtures, so it does not need
# updating every time an unrelated fixture is added elsewhere in the directory -- only a
# change to the constructs.* set itself would touch this list. The expected order below
# was produced by running panduck_glob itself and pasting its output, not hand-derived,
# so this test fails if sorting is removed even on a filesystem whose natural enumeration
# order happens to already be alphabetical (see the note above).
query I
SELECT panduck_glob('test/fixtures/constructs.*');
----
[test/fixtures/constructs.docx, test/fixtures/constructs.html, test/fixtures/constructs.odt, test/fixtures/constructs.rst, test/fixtures/constructs.source.md, test/fixtures/constructs.textile]

# An exact path that exists resolves to itself.
query I
SELECT panduck_glob('test/fixtures/constructs.odt');
----
[test/fixtures/constructs.odt]

# NOTHING MATCHED IS AN EMPTY LIST, NOT AN ERROR. The primitive is neutral and the policy
# lives in dispatch (Task 4), so there is exactly one site to change if the rule is ever
# revisited, and a future caller wanting "possibly none" has something to build on.
query I
SELECT len(panduck_glob('test/fixtures/*.nothing_matches_this'));
----
0

# NULL in, NULL out -- ordinary scalar-function NULL propagation, not "no match".
query I
SELECT panduck_glob(NULL) IS NULL;
----
true

# NULL (unknown pattern) and empty list (known pattern, zero matches) are two different
# outcomes a caller could otherwise confuse; assert they stay distinguishable.
query I
SELECT panduck_glob(NULL) IS NULL AND len(panduck_glob('test/fixtures/*.no_such')) = 0;
----
true

# ---------------------------------------------------------------------------
# One normalisation for every source form, so nothing downstream branches on which form
# the caller used. A plain path is NOT sent through the filesystem: a caller naming one
# file should get the same behaviour they get today, including the reader's own error if
# it does not exist, rather than a glob-shaped error from panduck.
# ---------------------------------------------------------------------------
query I
SELECT panduck_source_list('test/fixtures/constructs.odt');
----
[test/fixtures/constructs.odt]

query I
SELECT len(panduck_source_list('test/fixtures/*.odt')) > 1;
----
true

query I
SELECT panduck_source_list(['a.odt', 'b.docx']);
----
[a.odt, b.docx]

# A list element may itself glob, and order follows the argument, not the filesystem.
query I
SELECT len(panduck_source_list(['test/fixtures/constructs.odt', 'test/fixtures/*.odt']))
     = 1 + len(panduck_glob('test/fixtures/*.odt'));
----
true

# The count check above constrains cardinality, not order -- and order is the property
# this macro exists to guarantee, since a later task builds a UNION ALL from this list and
# the generated SQL must be deterministic. This pins the actual sequence: the explicit
# path comes FIRST, and the glob's own (sorted) expansion follows in place.
query I
SELECT panduck_source_list(['test/fixtures/constructs.odt', 'test/fixtures/*.odt'])
     = ['test/fixtures/constructs.odt'] || panduck_glob('test/fixtures/*.odt');
----
true

# A companion that fails if the order were reversed, so the assertion above is not
# satisfiable by a symmetric bug (e.g. concatenating the two halves in the wrong order).
# Uses 'lists.odt' rather than 'constructs.odt' deliberately: 'constructs.odt' sorts
# FIRST among the '*.odt' matches, so an explicit-path-vs-glob swap would coincidentally
# still land it at position [1] and this check would pass either way. 'lists.odt' sorts
# third, so a swap puts the glob's own first match ('constructs.odt') at [1] instead,
# which is not 'lists.odt' -- the check can actually fail.
query I
SELECT panduck_source_list(['test/fixtures/lists.odt', 'test/fixtures/*.odt'])[1]
     = 'test/fixtures/lists.odt';
----
true

# A non-existent plain path passes through untouched -- panduck does not pre-validate it.
query I
SELECT panduck_source_list('no/such/file.odt');
----
[no/such/file.odt]

# ---------------------------------------------------------------------------
# The generated SQL is asserted as a STRING before anything runs it. A test that only
# checked row counts would pass on SQL that happened to work while emitting the provenance
# column in the wrong POSITION -- which is exactly the defect that shipped in two sibling
# extensions (webbed a865d37, markdown 340c0cd both emitted filename FIRST, which spec 6.4
# refuses). Asserting the string catches it in the producer.
# ---------------------------------------------------------------------------
query I
SELECT panduck_read_arms(['a.odt'], false);
----
SELECT * FROM read_odt_blocks('a.odt')

# filename LAST, after the canonical seven, because SELECT * emits them first. Trailing is
# not cosmetic: spec 6.4 keys 8-field acceptance on the exact type with filename last, and
# every consumer reads the struct BY INDEX, so a leading column puts the path where kind is
# expected.
query I
SELECT panduck_read_arms(['a.odt'], true);
----
SELECT *, 'a.odt' AS filename FROM read_odt_blocks('a.odt')

query I
SELECT panduck_read_arms(['a.odt', 'b.html'], true);
----
SELECT *, 'a.odt' AS filename FROM read_odt_blocks('a.odt') UNION ALL SELECT *, 'b.html' AS filename FROM read_html_blocks('b.html')

# A path with a quote in it survives, because every interpolated value goes through
# panduck_quote. This is the assertion that the string builder is not concatenating.
query I
SELECT contains(panduck_read_arms(['o''brien.odt'], true), 'o''''brien.odt');
----
true

# ---------------------------------------------------------------------------
# A glob returns exactly the sum of the individual reads. Written as a computed equality
# rather than a literal so that adding an .odt fixture cannot silently invalidate it.
#
# Not written as a correlated subquery over unnest(panduck_glob(...)) -- DuckDB v1.5.5
# refuses that outright ("Table function ... does not support lateral join column
# parameters"), and that restriction is unconditional: it reproduces on read_csv and on
# read_odt_blocks called directly, with no panduck code in the path at all. So the per-path
# counts are summed by building one query() arm per path instead, the same technique
# panduck_read_arms itself uses, keeping every path a compile-time literal.
# ---------------------------------------------------------------------------
query I
SELECT (SELECT count(*) FROM read_panduck_doc('test/fixtures/*.odt'))
     = (SELECT sum(n) FROM query(
         array_to_string(list_transform(panduck_glob('test/fixtures/*.odt'),
             lambda p: 'SELECT count(*) AS n FROM read_panduck_doc(' || panduck_quote(p) || ')'),
             ' UNION ALL ')));
----
true

# Mixed formats in one call, each path dispatched through the registry independently.
#
# NOT preceded by INSTALL/LOAD webbed. panduck_read_arms wraps each arm in the same
# panduck_ensure_extension gate the single-path branch uses -- and that gate does not
# merely produce a nicer error, it IS TryAutoLoadExtension (reader_registry.cpp), so the
# .html arm autoloads webbed on its own. An explicit LOAD here would hide a regression in
# the gate rather than prove it works.
query I
SELECT count(DISTINCT filename)
FROM read_panduck_doc(['test/fixtures/constructs.odt', 'test/fixtures/constructs.html'],
                      filename := true);
----
2

# PROVENANCE IS OFF BY DEFAULT FOR EVERY SOURCE FORM. A default that changed shape with
# the form of the argument would mean read_panduck_doc(x) returns seven or eight columns
# depending on whether x contains a '*' -- a rule every caller must know and none can see
# at the call site. It is also what keeps the default output consumable by a RELEASED
# duck_block_utils, which refuses an 8-field struct.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_panduck_doc('test/fixtures/*.odt'));
----
7

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_panduck_doc('test/fixtures/constructs.odt'));
----
7

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_panduck_doc('test/fixtures/*.odt', filename := true));
----
8

# element_order is PER DOCUMENT. Making it global would break every consumer that uses it
# to reconstruct one document's order -- doc_section, doc_container, the pandoc writer.
query I
SELECT bool_and(has_zero) FROM (
  SELECT bool_or(element_order = 0) AS has_zero
  FROM read_panduck_doc('test/fixtures/*.odt', filename := true)
  GROUP BY filename);
----
true

# A glob matching nothing RAISES, matching DuckDB core, which errors identically for a
# pattern that matches nothing and for a named file that is absent.
statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/*.nothing_matches_this');
----
no files matched

# The default output is byte-identical to today's for a single path -- the check that this
# feature is additive and that a caller on a released duck_block_utils is unaffected.
query I
SELECT (SELECT count(*) FROM read_panduck_doc('test/fixtures/constructs.odt'))
     = (SELECT count(*) FROM read_odt_blocks('test/fixtures/constructs.odt'));
----
true

# ---------------------------------------------------------------------------
# ROUND-1 REVIEW FIXES. Four regressions found in review, each covered here and each also
# verified in isolation (its own scratch file, run alone) because sqllogictest aborts at
# the first failing assertion in a file -- a whole-file pass proves only that something
# before the last assertion did not fail, not that any one assertion is doing its job.
# ---------------------------------------------------------------------------

# CRITICAL 1 (autoload gate) is covered by the mixed-format assertion above, which now
# runs with no preceding INSTALL/LOAD webbed.

# CRITICAL 2: a format with no registry function (pdf, toml, yaml, zim, and every
# KIND_TABLE format) inside a plural call is REFUSED LOUDLY, not silently dropped.
# Before this fix: read_panduck_doc(['constructs.odt', 'two_pages.pdf']) returned 54 rows
# -- exactly constructs.odt alone -- because array_to_string skips the NULL arm a reader
# with no registry function produces.
statement error
SELECT count(*) FROM read_panduck_doc(['test/fixtures/constructs.odt', 'test/fixtures/two_pages.pdf']);
----
cannot be read in a multi-document call yet

# IMPORTANT 1: `pages` is no longer silently ignored on a glob.
#
# ROUND 2: this now raises via the pages-on-a-plural-source guard added ahead of the
# single-format pages guard (round 2 review), which subsumes the glob case entirely --
# a glob no longer needs to reach format resolution at all before being refused. The
# assertion below was originally written against the older single-format guard's message
# ("pages applies only to paginated formats"); it still exists and still fires for a
# non-plural, non-pdf source, but a glob is now caught one guard earlier.
statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/*.odt', pages := 'nonsense');
----
pages applies to a single document

# IMPORTANT 2: a glob NESTED inside a list that matches nothing raises, naming that
# element specifically -- not silently dropped by flatten(). Before this fix:
# read_panduck_doc(['test/fixtures/constructs.odt', 'test/fixtures/*.nomatch']) returned
# rows for constructs.odt alone, with no error, because the length check ran only on the
# flattened (and therefore already-collapsed) list.
statement error
SELECT count(*) FROM read_panduck_doc(['test/fixtures/constructs.odt', 'test/fixtures/*.nomatch']);
----
no files matched

# ---------------------------------------------------------------------------
# ROUND-2 REVIEW FIX. `error(NULL) IS NULL` is true in DuckDB -- error() does not throw
# on a NULL argument, it silently returns NULL. Round 1's own fix for the finding above
# built its named error as 'panduck: ' || p || ' needs the ' ||
# panduck_reader_extension_for(p) || ' extension', and panduck_reader_extension_for(p) is
# NULL for a reader registered with an empty reader_ext (panduck_register_doc_reader('',
# fn, exts) -- "no companion extension needed"). That reintroduced the exact silent loss
# this file already tests above, through a different route: the arm went NULL, and
# array_to_string skipped it. constructs_dup.no_ext_needed is a byte-identical copy of
# constructs.odt under a name nothing else claims, registered here as a second path to
# the same reader with no extension requirement.
# ---------------------------------------------------------------------------
statement ok
SELECT * FROM panduck_register_doc_reader('', 'read_odt_blocks', ['no_ext_needed']);

query I
SELECT panduck_reader_extension_for('x.no_ext_needed') IS NULL;
----
true

# Both documents read successfully -- NULL reader_extension_for means "nothing to ensure",
# not "refuse this path". 54 (one ODT) would mean the second arm went missing again.
query I
SELECT count(*) FROM read_panduck_doc(['test/fixtures/constructs.odt', 'test/fixtures/constructs_dup.no_ext_needed']);
----
108

# ---------------------------------------------------------------------------
# ROUND-3 REVIEW ADDITIONS. Two fixes from round 2 had no permanent assertion: the
# READ_TABLE_MACRO hoist (found and fixed on our own initiative, and read_panduck_table
# otherwise has ZERO coverage anywhere in test/, so a regression here would be caught by
# nothing at all) and the `p IS NULL` path guard in panduck_read_arms (verified by hand
# during review, never pinned).
# ---------------------------------------------------------------------------

# READ_TABLE_MACRO's NULL-reader_ext hoist: a table reader registered with an empty
# reader_ext must reach the reader function it names, not collapse into error(NULL) ->
# query(NULL) -> a generic parser error. read_csv is registered against a path that does
# not exist, so the assertion is that the FAILURE comes from read_csv's own file
# resolution (an IO Error naming the pattern) -- proof dispatch actually built and ran
# 'SELECT * FROM read_csv(...)' rather than silently producing a NULL query string.
statement ok
SELECT * FROM panduck_register_table_reader('', 'read_csv', ['tbl_no_ext']);

statement error
SELECT * FROM read_panduck_table('test/fixtures/does_not_exist.tbl_no_ext');
----
No files found that match the pattern

# panduck_read_arms refuses a NULL path element outright rather than letting
# panduck_reader_function_for(NULL) -> NULL fall into the "cannot be read" arm with the
# path itself NULL, which would have nulled that message out through the same
# error(NULL) trap the round-2 fixes above are about.
statement error
SELECT count(*) FROM read_panduck_doc(['test/fixtures/constructs.odt', NULL]);
----
a multi-document source contains a NULL path

# ---------------------------------------------------------------------------
# THE JUNCTION. Every test above verifies panduck against panduck. What actually broke in
# two sibling extensions this week was the junction: an emitter in one repo producing a
# shape a consumer in another repo refuses. No repo's own suite can catch that, because
# each verifies its own behaviour -- webbed had 3940 assertions and shipped it.
#
# panduck's own writer is a real consumer that binds the canonical struct STRUCTURALLY, so
# it is a junction check that needs no second extension installed.
# ---------------------------------------------------------------------------
query I
SELECT length(panduck_blocks_to_pandoc_ast(
    (SELECT list(b ORDER BY b.element_order)
     FROM read_panduck_doc('test/fixtures/constructs.odt') b))::VARCHAR) > 0;
----
true

# THE EXACT EMITTED TYPE, asserted as a full string. This is the producer-side instrument
# that webbed and markdown both lacked: it fails HERE, in the producer, if the provenance
# column ever moves, instead of three repos away at someone else's binder.
query I
SELECT typeof(list(b)) FROM read_panduck_doc('test/fixtures/constructs.odt', filename := true) b;
----
STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR, VARCHAR), element_order INTEGER, filename VARCHAR)[]

# And the seven-field shape is unchanged when provenance is off.
query I
SELECT typeof(list(b)) FROM read_panduck_doc('test/fixtures/constructs.odt') b;
----
STRUCT(kind VARCHAR, element_type VARCHAR, "content" VARCHAR, "level" INTEGER, "encoding" VARCHAR, attributes MAP(VARCHAR, VARCHAR), element_order INTEGER)[]

# ---------------------------------------------------------------------------
# THE SECOND CONSUMER. panduck_blocks_to_pandoc_ast above is panduck checking itself against
# its own writer -- a real binder, but one repo. duck_block_utils is the other side of the
# junction that actually broke: an independent extension whose table macros consume the
# canonical struct by field name. Explicit INSTALL/LOAD rather than `require duck_block_utils`,
# because the unittest binary is built with ENABLE_EXTENSION_AUTOLOADING=0 -- a test that
# relies on the developer's own ~/.duckdb profile already having it loaded passes locally and
# fails in CI, which is exactly the defect doc_namespace.test documents and this file must not
# repeat. See doc_namespace.test for the fuller account of that failure and the two-clock
# problem (panduck's submodule pin vs. whatever build is actually installed).
# ---------------------------------------------------------------------------
statement ok
INSTALL duck_block_utils;

statement ok
LOAD duck_block_utils;

# duck_blocks_toc binds against read_panduck_doc's single-document output -- the same
# canonical seven-field struct panduck_blocks_to_pandoc_ast bound above, now bound by code
# panduck does not own.
query I
SELECT len(duck_blocks_toc(
    (SELECT list(b ORDER BY b.element_order)
     FROM read_panduck_doc('test/fixtures/constructs.odt') b))) > 0;
----
true

# And it binds across a GLOB read -- multiple documents concatenated into one list, consumed
# end to end by an independent extension. Six .odt fixtures, twelve headings total across
# them. NOT run with filename := true: measured against duck_block_utils 3f2a0f0
# (duck_block_spec_version 6.3), the build published today, duck_blocks_toc binds the
# canonical SEVEN-field struct only, and the eight-field filename-bearing struct is a
# Binder Error against it ("No function matches the given name and argument types"). This
# is a property of THAT build, not of duck_block_utils generally: 6.4 adds registered
# implicit casts for the 8-field struct (the exact struct to duck_block, and the LIST
# form), so this assertion's justification expires when 6.4 publishes and should be
# re-measured then rather than assumed. That is not a bug for this task to fix -- the
# design doc separately notes this shape is why filename defaults to off, which is a
# different and still-true claim from what duck_blocks_toc's binder currently accepts.
query I
SELECT len(duck_blocks_toc(
    (SELECT list(b ORDER BY b.element_order)
     FROM read_panduck_doc('test/fixtures/*.odt') b)));
----
12

# ---------------------------------------------------------------------------
# READER OPTIONS ARE STRUCTURED DATA, NEVER A STORED SQL FRAGMENT.
#
# A registry entry is process-wide and lives as long as the process, so a fragment stored
# by one caller would be interpolated into the SQL of EVERY later read_panduck_doc --
# including calls from other sessions sharing that process, which never registered anything
# and cannot see what was stored. That is an arbitrary-SQL injection point with
# session-crossing reach, which is why the first design was rejected.
#
# So a registration carries typed FIELDS -- intent, value, param, arg, arg_type -- and
# panduck renders the argument itself. `param` must be a bare identifier and `arg` must
# actually hold a value of `arg_type`, both checked AT REGISTRATION so a malformed row
# cannot be stored at all.
# ---------------------------------------------------------------------------
statement ok
CALL panduck_register_doc_reader('webbed', 'read_html_blocks', ['.htmltest'],
     options := [{intent: 'attributes', value: 'all',
                  param: 'capture_attributes', arg: 'classes', arg_type: 'VARCHAR'}]);

# The intent reaches the sibling's parameter; the caller never types capture_attributes.
query I
SELECT panduck_read_arms_opt(['x.htmltest'], false, 'attributes', 'all');
----
SELECT * FROM read_html_blocks('x.htmltest', capture_attributes := 'classes')

# THE 'default' SENTINEL RENDERS NOTHING, and it does so WITHOUT consulting the registry --
# which is what keeps an unchanged call byte-identical to the SQL panduck generated before
# options existed, for every format, including the ones that map no option at all and would
# otherwise raise. panduck_read_arms is now literally panduck_read_arms_opt with this
# sentinel, so the string assertions earlier in this file are that property, asserted.
query I
SELECT panduck_read_arms_opt(['x.htmltest'], false, 'attributes', 'default')
     = panduck_read_arms(['x.htmltest'], false);
----
true

# A non-identifier param is REJECTED AT REGISTRATION, so a malformed row cannot be stored.
statement error
CALL panduck_register_doc_reader('webbed', 'read_html_blocks', ['.badopt'],
     options := [{intent: 'a', value: 'b',
                  param: 'x := 1) UNION SELECT', arg: 'c', arg_type: 'VARCHAR'}]);
----
param must be an identifier

# ... and it is ABSENT afterwards. Asserting the error alone would pass on a warning, or on
# an implementation that raised after writing the row.
query I
SELECT count(*) FROM panduck_reader_registry() WHERE ext = '.badopt';
----
0

# BOOLEAN AND INTEGER ARE RENDERED BARE -- unquoted -- so an unchecked `arg` under either
# type is a direct injection: only VARCHAR is quoted, and quoting is what makes it safe.
# The bare types are therefore constrained to values that cannot be anything but a literal,
# and that too is checked at registration.
statement error
CALL panduck_register_doc_reader('webbed', 'read_html_blocks', ['.badbool'],
     options := [{intent: 'a', value: 'b',
                  param: 'flag', arg: 'true) UNION SELECT 1 --', arg_type: 'BOOLEAN'}]);
----
is not a BOOLEAN

query I
SELECT count(*) FROM panduck_reader_registry() WHERE ext = '.badbool';
----
0

statement error
CALL panduck_register_doc_reader('webbed', 'read_html_blocks', ['.badint'],
     options := [{intent: 'a', value: 'b',
                  param: 'n', arg: '1; DROP TABLE t', arg_type: 'INTEGER'}]);
----
is not a INTEGER

statement error
CALL panduck_register_doc_reader('webbed', 'read_html_blocks', ['.badtype'],
     options := [{intent: 'a', value: 'b',
                  param: 'n', arg: '1', arg_type: 'BLOB'}]);
----
unknown arg_type

# The types that ARE accepted render as literals of their own kind: bare for BOOLEAN and
# INTEGER, quoted-and-escaped for VARCHAR. The quote in the VARCHAR arg is the assertion
# that panduck escapes rather than concatenates -- the same property the path assertions
# above make for panduck_quote.
statement ok
CALL panduck_register_doc_reader('webbed', 'read_html_blocks', ['.optkinds'],
     options := [{intent: 'b', value: 'on', param: 'flag', arg: 'true', arg_type: 'BOOLEAN'},
                 {intent: 'i', value: 'two', param: 'n', arg: '2', arg_type: 'INTEGER'},
                 {intent: 's', value: 'quoted', param: 's', arg: 'o''brien', arg_type: 'VARCHAR'}]);

query III
SELECT panduck_reader_option_for('x.optkinds', 'b', 'on'),
       panduck_reader_option_for('x.optkinds', 'i', 'two'),
       panduck_reader_option_for('x.optkinds', 's', 'quoted');
----
flag := true	n := 2	s := 'o''brien'

# A requested intent with no mapping RAISES rather than being dropped. This is the
# pages-was-a-lie lesson applied in advance: a parameter accepted and ignored reads as a
# feature at the call site, which is exactly how `pages` survived unimplemented.
statement error
SELECT panduck_read_arms_opt(['a.odt'], false, 'attributes', 'all');
----
has no mapping for

# ---------------------------------------------------------------------------
# THE OPTION REACHES DISPATCH, not merely panduck_read_arms_opt's own test. An option the
# dispatcher cannot be asked for is a feature that exists solely inside its own assertion.
# `attributes` is read_panduck_doc's named parameter for the intent, defaulting to the
# 'default' sentinel.
# ---------------------------------------------------------------------------

# Both the single-path and the plural branch carry it. Asserted through the generated SQL
# via panduck_read_arms_opt, since the reader that would honour it is not published yet
# (see the gated section below).
query I
SELECT panduck_read_arms_opt(['x.htmltest', 'y.htmltest'], true, 'attributes', 'all');
----
SELECT *, 'x.htmltest' AS filename FROM read_html_blocks('x.htmltest', capture_attributes := 'classes') UNION ALL SELECT *, 'y.htmltest' AS filename FROM read_html_blocks('y.htmltest', capture_attributes := 'classes')

# THE DEFAULT IS UNCHANGED SQL, asserted through dispatch itself rather than through the
# builder: a read that names no option must produce exactly what it produced before options
# existed. 54 is constructs.odt's block count, the same number the byte-identity assertion
# above compares against read_odt_blocks directly.
query I
SELECT count(*) FROM read_panduck_doc('test/fixtures/constructs.odt', attributes := 'default');
----
54

# A FORMAT THAT MAPS NO OPTION REFUSES BY NAME rather than reading the document and quietly
# omitting what was asked for. odt has no attributes mapping.
statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/constructs.odt', attributes := 'all');
----
has no mapping for

# EVERY SPECIAL-CASED BRANCH REFUSES TOO. pdf, zim, toml/yaml and the text and code
# fallbacks build their own SQL rather than going through panduck_read_arms_opt, so
# `attributes` would be ACCEPTED AND SILENTLY IGNORED there -- the exact shape `pages` had
# for the whole life of this macro. Refusing by name closes the class off for every intent
# added later, not just this one.
statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/two_pages.pdf', attributes := 'all');
----
attributes is not supported for

# ---------------------------------------------------------------------------
# NULL IS NOT A VALUE, AND `<>` CANNOT SAY SO. `NULL <> 'default'` is NULL, not TRUE, so
# every guard written with `<>` was skipped outright by a caller passing NULL instead of a
# value -- the parameter accepted and silently ignored, which is the exact defect the guard
# exists to close, reached through the one input the guard cannot see. MEASURED before the
# fix: attributes := NULL returned 45 rows from a PDF, pages := NULL returned 54 from an
# ODT and 180 from a glob, all without a word.
#
# This is the round-2 error() audit's twin one level up: that one found error(NULL)
# silently returning NULL in a MESSAGE, this one finds NULL silently falsifying a
# CONDITION. The `pages` guards inherited it and are fixed in the same change, because
# fixing the new guard and leaving the old one would keep this plan's headline defect alive
# in the precise place the plan claims to have closed it.
# ---------------------------------------------------------------------------
statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/two_pages.pdf', attributes := NULL);
----
attributes is not supported for

statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/constructs.odt', pages := NULL);
----
pages applies only to paginated formats

statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/*.odt', pages := NULL);
----
pages applies to a single document

# THE ONE HOLE THE TWO `pages` GUARDS CANNOT REACH: a single PDF. Neither selects for it --
# the first needs a plural source, the second a non-pdf format -- so a NULL fell through to
# the pdf branch, where panduck_quote coalesces it to '' and every page came back. Dispatch
# and read_pdf_blocks disagreed about the same argument: called directly, read_pdf_blocks
# raises this message on its own. They now refuse identically, in the same words.
statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/two_pages.pdf', pages := NULL);
----
pages must be N or N-M, got <NULL>

# AND ON A FORMAT THAT DOES MAP THE OPTION, where the dispatch guards above never run --
# the generic branch selects first and the NULL reaches the renderer. Treating a NULL value
# as the 'default' sentinel there would have reopened the hole on exactly the formats where
# the option works, which is the worst possible place to leave it.
statement error
SELECT panduck_read_arms_opt(['x.htmltest'], false, 'attributes', NULL);
----
must name a value

# ---------------------------------------------------------------------------
# EVERY OPTION FIELD IS REQUIRED, AND AN OMITTED ONE ARRIVES AS NULL RATHER THAN AS A BIND
# ERROR. Measured: DuckDB casts the struct BY NAME, so fields written in any order land
# correctly, and a field that is absent or misspelled is filled with NULL rather than
# refused. Folding that NULL to '' made a row with no `arg` at all storable under
# arg_type 'VARCHAR' -- it rendered `p := ''`. The design's claim is that a malformed row
# cannot be STORED, and a row missing a field is malformed.
# ---------------------------------------------------------------------------
statement error
CALL panduck_register_doc_reader('', 'read_odt_blocks', ['.noarg'],
     options := [{intent: 'a', value: 'b', param: 'p', arg_type: 'VARCHAR'}]);
----
an option needs a non-NULL 'arg'

query I
SELECT count(*) FROM panduck_reader_registry() WHERE ext = '.noarg';
----
0

# A MISSPELLED FIELD IS THE SAME SHAPE, and it is worth pinning separately because the
# error it produces names the field that is MISSING rather than the one that was typed --
# `parm:` reaches the bind as param = NULL, not as "no such field parm".
statement error
CALL panduck_register_doc_reader('', 'read_odt_blocks', ['.misspelled'],
     options := [{intent: 'a', value: 'b', parm: 'p', arg: 'c', arg_type: 'VARCHAR'}]);
----
an option needs a non-NULL 'param'

# FIELDS IN ANY ORDER STILL REGISTER CORRECTLY, because the cast is by name. This is the
# assertion behind the claim that the by-name read in RegisterBind is belt-and-braces
# rather than the only thing standing between a reordered declaration and a mis-assigned
# `param` -- both hold, and a test says which.
statement ok
CALL panduck_register_doc_reader('', 'read_odt_blocks', ['.reordered'],
     options := [{arg_type: 'VARCHAR', arg: 'c', param: 'p', value: 'b', intent: 'a'}]);

query I
SELECT panduck_reader_option_for('x.reordered', 'a', 'b');
----
p := 'c'

# AN EXPLICITLY EMPTY `arg` IS STILL ACCEPTED. `p := ''` is a legitimate literal to want,
# and it is distinguishable from an absent one -- which is why the check refuses NULL
# rather than refusing emptiness.
statement ok
CALL panduck_register_doc_reader('', 'read_odt_blocks', ['.emptyarg'],
     options := [{intent: 'a', value: 'b', param: 'p', arg: '', arg_type: 'VARCHAR'}]);

query I
SELECT panduck_reader_option_for('x.emptyarg', 'a', 'b');
----
p := ''

# ---------------------------------------------------------------------------
# NULL IS NOT A VALUE FOR ANY NAMED PARAMETER, and DuckDB CORE is the standard:
#
#   read_csv('a.csv', filename := NULL)  ->  Cannot use NULL as argument for "filename"
#
# panduck silently defaulting was two defects at once -- accept-and-ignore, and a divergence
# from core on the very parameter whose name, column and deliberate refusal of the
# string-rename form were all settled by "same as core". MEASURED before the fix:
# filename := NULL returned SEVEN columns from a single path, a glob and a pdf alike, with
# provenance silently off, and format := NULL read the document by auto-detection.
#
# THIS IS THE SAME DEFECT IN ITS FOURTH COSTUME, which is why the whole named-parameter
# surface was swept rather than the reported instances patched. It has appeared as a `<>`
# comparison (NULL falsifies the condition), as a renderer sentinel (NULL read as
# 'default'), as `CASE WHEN filename` (NULL is not TRUE, so provenance is quietly off), and
# as coalesce inside panduck_resolved_format (NULL reads as 'auto'). The shape never
# changes: a NULL takes the same path the DEFAULT takes, so the caller cannot tell that
# what they asked for did not happen.
# ---------------------------------------------------------------------------
statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/constructs.odt', filename := NULL);
----
cannot use NULL as argument for "filename"

statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/*.odt', filename := NULL);
----
cannot use NULL as argument for "filename"

statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/two_pages.pdf', filename := NULL);
----
cannot use NULL as argument for "filename"

# BOTH CALL SITES AGREE, in the same words. panduck_read_arms_opt is directly callable and
# directly tested, so a guard living only in dispatch would leave the two disagreeing about
# the same argument -- the defect shape fixed for `pages` one round earlier, where dispatch
# coalesced a NULL that read_pdf_blocks refused.
statement error
SELECT panduck_read_arms_opt(['a.odt'], NULL, 'attributes', 'default');
----
cannot use NULL as argument for "filename"

statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/constructs.odt', format := NULL);
----
cannot use NULL as argument for "format"

# doc_toc AND doc_render ARE GUARDED SEPARATELY, because they do not pass `format` along as
# a VALUE -- they render it into SQL text through panduck_quote, which coalesces NULL to ''.
# Dispatch therefore never saw a NULL to refuse: it saw the string '', resolved the format
# to '' and raised "resolves to format '' ... This is a panduck bug", blaming panduck for
# the caller's NULL. A misdiagnosis is worse than a silent default, because it sends the
# next person to read the wrong code.
statement error
SELECT count(*) FROM doc_toc('test/fixtures/constructs.odt', format := NULL);
----
cannot use NULL as argument for "format"

statement error
SELECT length(doc_render('test/fixtures/constructs.odt', 'md', format := NULL));
----
cannot use NULL as argument for "format"

# The macros that DO pass it as a value inherit the refusal, which is the point of guarding
# at the dispatcher rather than in each of them.
statement error
SELECT len(panduck_read_blocks('test/fixtures/constructs.odt', format := NULL));
----
cannot use NULL as argument for "format"

statement error
SELECT count(*) FROM doc_section('test/fixtures/sections.html', 'Alpha', format := NULL);
----
cannot use NULL as argument for "format"

statement error
SELECT count(*) FROM doc_container('test/fixtures/containers.html', 'art', format := NULL);
----
cannot use NULL as argument for "format"

# ---------------------------------------------------------------------------
# AND `filename` IS THE SAME DEFECT WITH A NON-NULL VALUE, found by looking for the pattern
# rather than for another NULL. Only the generic/plural branches (through
# panduck_read_arms_opt) and the pdf branch actually PROJECT the provenance column, so every
# other branch ACCEPTED filename := true and silently returned seven columns.
# ---------------------------------------------------------------------------
statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/config.toml', filename := true);
----
filename is not supported for toml

statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/config.yaml', filename := true);
----
filename is not supported for yaml

statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/constructs.odt', format := 'pandoc', filename := true);
----
filename is not supported for pandoc

# PDF IS EXCLUDED BY NAME from the guard above, because it is the one special-cased branch
# that DOES project the column. That assertion lives in pdf_reader.test, not here: it has to
# BIND read_pdf_elements, and this file is ungated. The refusals above are safe here because
# error() aborts the CASE before any SQL string is built, so nothing pdf-shaped is ever bound.

# ... and the branches that DO honour it still do, which is the assertion that none of the
# guards above swallowed a working case.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_panduck_doc('test/fixtures/constructs.odt', filename := true));
----
8

query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_panduck_doc('test/fixtures/*.odt', filename := true));
----
8

# ---------------------------------------------------------------------------
# THE ESCAPE HATCH. panduck has no intent for `ignore_errors` and should never grow one --
# there are dozens of such parameters across the readers panduck dispatches to, and a
# vocabulary entry per sibling option is a maintenance burden with no upside.
#
# Same identifier discipline as the registry mapping: a key that is not a bare identifier is
# rejected, so there is still no path from caller input to arbitrary SQL.
# ---------------------------------------------------------------------------
query I
SELECT panduck_render_params(MAP{'ignore_errors': 'true'});
----
, ignore_errors := 'true'

query I
SELECT panduck_render_params(MAP{});
----
(empty)

statement error
SELECT panduck_render_params(MAP{'x := 1) UNION SELECT': 'y'});
----
must be an identifier

# A NULL VALUE for a key is not one, the same ruling panduck_reader_option_for makes for an
# option value: silently dropping the entry is the parameter accepted and ignored, and
# rendering the bare word NULL would emit `key := NULL` -- syntactically a value, not what a
# caller who never asked for that keyword meant.
statement error
SELECT panduck_render_params(MAP{'ignore_errors': NULL});
----
must name a value

# THE OPTION REACHES DISPATCH, through the ONE builder both the plural and generic branches
# of read_panduck_doc share -- panduck_read_arms_opt -- exactly the way `attributes` does.
# Positive control: a legitimate reader_params call still renders correctly, appended AFTER
# the Task 6 option in the same reader call.
query I
SELECT panduck_read_arms_opt(['x.htmltest'], false, 'attributes', 'all',
                              reader_params := MAP{'ignore_errors': 'true'});
----
SELECT * FROM read_html_blocks('x.htmltest', capture_attributes := 'classes', ignore_errors := 'true')

# reader_params ALONE, no Task 6 option requested -- still appends, and the comma it carries
# is the only one in the call.
query I
SELECT panduck_read_arms_opt(['x.htmltest'], false, 'attributes', 'default',
                              reader_params := MAP{'ignore_errors': 'true'});
----
SELECT * FROM read_html_blocks('x.htmltest', ignore_errors := 'true')

# THE DEFAULT (an empty MAP) RENDERS NOTHING, which is what keeps every call in this file
# that never mentions reader_params byte-identical to what it generated before this task --
# the same property `attributes := 'default'` holds for Task 6's option.
query I
SELECT panduck_read_arms_opt(['x.htmltest'], false, 'attributes', 'default')
     = panduck_read_arms_opt(['x.htmltest'], false, 'attributes', 'default', reader_params := MAP{});
----
true

# NULL IS NOT THE EMPTY MAP, and DuckDB core is the standard: read_csv('a.csv',
# filename := NULL) raises rather than defaulting. Without this guard,
# panduck_render_params's own null-propagation would turn the argument into a NULL
# rendering, which concatenates through the whole reader call and silently produces NULL
# SQL text for query() -- accepted, then destroyed before dispatch could see it, the same
# shape `attributes` and `filename` were already found in.
statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/constructs.odt', reader_params := NULL);
----
cannot use NULL as argument for "reader_params"

# panduck_read_arms_opt is directly callable and directly tested, so the same NULL refusal
# is repeated there rather than left to dispatch alone -- otherwise a caller going straight
# to the builder would reach panduck_render_params with no guard in front of it.
statement error
SELECT panduck_read_arms_opt(['a.odt'], false, 'attributes', 'default', reader_params := NULL);
----
cannot use NULL as argument for "reader_params"

# EVERY SPECIAL-CASED BRANCH REFUSES TOO, the same ruling `attributes` got: pdf, zim,
# toml/yaml and the text and code fallbacks build their own SQL rather than going through
# panduck_read_arms_opt, so a reader_params entry would otherwise be ACCEPTED AND SILENTLY
# IGNORED on exactly the branches that cannot thread it.
statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/two_pages.pdf', reader_params := MAP{'ignore_errors': 'true'});
----
reader_params is not supported for

# A default (empty) reader_params on the SAME special-cased branch still works -- the guard
# above must not refuse a call that names nothing, only one that names something the branch
# cannot honour.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_panduck_doc('test/fixtures/two_pages.pdf'));
----
7

# AND THE FORMAT THAT DOES HONOUR IT STILL DOES, end to end through dispatch rather than
# only through panduck_read_arms_opt's own test -- the positive control that no guard above
# swallowed a working case. constructs.odt reaches the generic branch, which threads
# reader_params through; an empty one is the default every other read in this file relies
# on, asserted here explicitly rather than only implicitly.
query I
SELECT count(*) FROM read_panduck_doc('test/fixtures/constructs.odt', reader_params := MAP{});
----
54
