# name: test/sql/pdf_reader.test
# description: read_pdf_blocks -- PDF into duck_blocks, with page selection that works
# group: [sql]

#
# WHY THIS FILE IS ENV-GATED, stated plainly rather than buried: the `pdf` community
# extension statically links Poppler and Tesseract and DECLARES excluded platforms --
# wasm_mvp, wasm_eh, wasm_threads, windows_amd64_mingw, windows_amd64_rtools,
# windows_arm64. An unconditional `INSTALL pdf` would therefore fail on CI jobs that are
# otherwise green, so this file runs only when PANDUCK_TEST_PDF is set. `make check-pdf`
# sets it.
#
# THAT IS A REAL COVERAGE GAP AND IT IS NAMED, NOT PAPERED OVER. Until this file is wired
# into a platform-restricted CI job, panduck's pdf path is verified locally and nowhere
# else. It is still strictly better than what preceded it: BEFORE this file, the pdf read
# path had ZERO behavioural coverage. Both existing mentions of pdf in the suite are
# registry-metadata assertions that explicitly exclude it from the "actually read it"
# checks -- reader_registry.test:273 has `format NOT IN (..., 'pdf', ...)`. Nothing ever
# read a PDF. That is why nobody noticed pdf_to_markdown cannot select pages.
require-env PANDUCK_TEST_PDF

require panduck

statement ok
INSTALL pdf FROM community;

statement ok
LOAD pdf;

# ---------------------------------------------------------------------------
# PAGE SELECTION ACTUALLY SELECTS. This is the assertion the whole function exists for.
#
# The parameter it replaces was a LIE: read_panduck_doc has declared `pages` since it was
# written and never referenced it in the macro body, so `pages := '2'` and
# `pages := 'utter nonsense'` both returned the full document -- measured, 8 rows each.
# A parameter that accepts anything and does nothing is worse than one that does not
# exist, because it reads as a feature at the call site.
#
# The fixture is two pages by CONSTRUCTION, not by luck: two_pages.source.md carries 34
# filler paragraphs whose only job is to push the second heading onto page 2. A one-page
# fixture would let a broken `pages` pass by returning everything.
# ---------------------------------------------------------------------------
query I
SELECT count(*) > (SELECT count(*) FROM read_pdf_blocks('test/fixtures/two_pages.pdf', pages := '2'))
FROM read_pdf_blocks('test/fixtures/two_pages.pdf');
----
true

# Every row of a page-2 slice really is from page 2.
query I
SELECT bool_and(attributes['page_number'] = '2')
FROM read_pdf_blocks('test/fixtures/two_pages.pdf', pages := '2');
----
true

# A range covering both pages is the whole document.
query I
SELECT (SELECT count(*) FROM read_pdf_blocks('test/fixtures/two_pages.pdf', pages := '1-2'))
     = (SELECT count(*) FROM read_pdf_blocks('test/fixtures/two_pages.pdf'));
----
true

# Garbage is REJECTED, not ignored. This is the assertion that the old parameter could
# never have passed, and the reason it is written as a separate case rather than folded
# into the one above: a silently-ignored parameter and a working one are indistinguishable
# on valid input, and differ only here.
statement error
SELECT count(*) FROM read_pdf_blocks('test/fixtures/two_pages.pdf', pages := 'utter nonsense');
----
pages must be N or N-M

# ---------------------------------------------------------------------------
# HEADING LEVELS ARE DOCUMENT-WIDE, AND SLICING DOES NOT PROMOTE THEM.
#
# PDF has no heading levels, only font sizes, so level is dense_rank over distinct heading
# font sizes. Rank within the SLICE and a mid-document section comes back with its
# headings promoted to 1, because it is the largest thing in its own slice. Measured on
# this fixture while building it: ranked per-slice, "Page Two Heading" read heading_level=1
# alone and 2 in the full document -- the same heading changing depth depending on what
# you asked for.
# ---------------------------------------------------------------------------
query I
SELECT attributes['heading_level']
FROM read_pdf_blocks('test/fixtures/two_pages.pdf', pages := '2')
WHERE element_type = 'heading';
----
2

# ---------------------------------------------------------------------------
# THE OUTPUT IS duck_blocks, NOT A LOOKALIKE. Asserted by handing it to consumers that
# bind the canonical seven-field struct structurally -- if the column order or types
# drifted, these are binder errors rather than wrong answers.
# ---------------------------------------------------------------------------
query I
SELECT bool_and(kind IN ('block', 'inline', 'value') AND encoding IS NOT NULL)
FROM read_pdf_blocks('test/fixtures/two_pages.pdf');
----
true

query I
SELECT (SELECT length(panduck_blocks_to_pandoc_ast(
            list(b ORDER BY b.element_order))::VARCHAR)
        FROM read_pdf_blocks('test/fixtures/two_pages.pdf') b) > 0;
----
true

# ---------------------------------------------------------------------------
# LIST STRUCTURE SURVIVES -- which is the reason this function uses read_pdf_elements
# rather than pdf_to_markdown. Measured on the same document through both routes:
# pdf_to_markdown flattens a list into ONE paragraph reading "• bullet one • bullet two",
# while the elements route keeps discrete list_items. The markers are stripped from the
# content and re-expressed as list_type, which is duck_block's spelling for it.
#
# The trade is inline emphasis, which the markdown route keeps and this one loses. That is
# recorded as a divergence rather than hidden; it is not asserted here because asserting
# an absence would pin a limitation in place.
# ---------------------------------------------------------------------------
query II
SELECT content, attributes['list_type']
FROM read_pdf_blocks('test/fixtures/two_pages.pdf', pages := '2')
WHERE element_type = 'list_item'
ORDER BY element_order;
----
one	ordered
two	ordered

# ---------------------------------------------------------------------------
# PAGINATION IS VISIBLE TO duck_block_utils, which is a different claim from "the rows
# know their page" and is the one that was wrong.
#
# This reader first shipped putting page_number on every block and no page_break anywhere.
# Every assertion above passed. duck_blocks_page_rows returned ZERO rows for this two-page
# fixture -- the pagination function could not see the pagination -- and renaming the
# per-block key from 'page' to 'page_number' did not help, because the mismatch was never
# the key. duck_block_utils models pages as page_break BLOCKS carrying page_number, with
# everything between breaks belonging to that page (doc_macros.cpp:201, :324). Two
# different models of one concept.
#
# Nothing could have caught it from inside panduck: the vocabulary publishes no ATTR_
# constant for page numbering, so check-vocabulary has nothing to compare against, and all
# three of its arms are about constants that ARE published rather than keys a producer
# invented. The only detector is calling the consumer, which is what this does.
#
# TYPE_PAGE = "page_break" is canonical and panduck's own EPUB reader already emitted it
# (epub_reader.cpp:629), so this reader was the outlier rather than the pioneer.
statement ok
INSTALL json;

statement ok
LOAD json;

statement ok
INSTALL duck_block_utils FROM community;

statement ok
LOAD duck_block_utils;

query I
SELECT count(*) FROM duck_blocks_page_rows(
    (SELECT list(b ORDER BY b.element_order) FROM read_pdf_blocks('test/fixtures/two_pages.pdf') b));
----
2

# The breaks are real blocks in the stream, one per page, each naming its number.
query II
SELECT content IS NULL, attributes['page_number']
FROM read_pdf_blocks('test/fixtures/two_pages.pdf')
WHERE element_type = 'page_break' ORDER BY element_order;
----
true	1
true	2

# ---------------------------------------------------------------------------
# read_panduck_doc's PDF branch honours `filename` too, not just the generic branch.
# Without this, read_panduck_doc('report.pdf', filename := true) would accept the
# parameter and silently ignore it -- exactly the `pages`-was-a-lie defect this plan
# exists to correct, on a column count instead of a page range.
# ---------------------------------------------------------------------------
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_panduck_doc('test/fixtures/two_pages.pdf', filename := true));
----
8

# PDF IS THE ONE SPECIAL-CASED DISPATCH BRANCH THAT PROJECTS `filename`. Every other one --
# pandoc, toml, yaml, zim, the text and code fallbacks -- accepted filename := true and
# silently returned seven columns, and dispatch now refuses those by name. This assertion is
# the other half of that guard: it is what stops the refusal from being widened into a
# refusal of a case that works.
#
# IT LIVES HERE RATHER THAN IN multidoc.test because it has to BIND read_pdf_elements, and
# multidoc.test is ungated. multidoc's own pdf assertions are all refusals, which raise
# before any SQL string is built, so nothing pdf-shaped is ever bound there.
query I
SELECT count(*) FROM (DESCRIBE SELECT * FROM read_panduck_doc('test/fixtures/two_pages.pdf', filename := true));
----
8

# And the NULL refusal reaches this branch too, in dispatch's words rather than by falling
# through to a seven-column read.
statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/two_pages.pdf', filename := NULL);
----
cannot use NULL as argument for "filename"

# ---------------------------------------------------------------------------
# element_order IS THE DOCUMENT'S ORDERING, STATED EXPLICITLY.
#
# read_pdf_blocks does not pass through read_pdf_elements' numbering. It assigns its own,
# because it INTERLEAVES synthetic page_break blocks into the stream -- so relative to that
# intermediate it renumbers, while relative to the PDF itself it preserves document order.
# That was correct incidentally: undocumented, unasserted, and only surfaced when
# duck_block_utils began writing an element_order recovery contract into the spec.
#
# These assertions pin the property either way the contract lands. If it means "unrenumbered
# relative to the SOURCE DOCUMENT", they are the proof panduck conforms. If it means
# "unrenumbered relative to whatever produced the rows", they are the assertions that will
# go red and say so, instead of the divergence being discovered by a consumer.
#
# WHY NOT JUST count(*): a count cannot tell a dense 0..n-1 run from a sparse one, and
# cannot see whether the page_break markers sit INSIDE the sequence or were appended after
# it. Both are the failure this pins.

# Dense, 0-based, contiguous, no duplicates -- asserted as one row so a gap, a repeat and an
# off-by-one are three different failures rather than one ambiguous count.
query IIII
SELECT count(*), min(element_order), max(element_order), count(DISTINCT element_order)
FROM read_pdf_blocks('test/fixtures/two_pages.pdf');
----
45	0	44	45

# The page_break markers are IN the sequence, not outside it. NEGATIVE CONTROL: dropping
# them must leave a HOLE. If page breaks were appended after the content blocks, or numbered
# on a separate axis, this would still be contiguous and the assertion above would not care.
query I
SELECT count(*) = 0 FROM (
  SELECT element_order FROM read_pdf_blocks('test/fixtures/two_pages.pdf')
  WHERE element_type <> 'page_break'
  EXCEPT
  SELECT * FROM range(0, 45)
);
----
true

query I
SELECT count(*) FROM (
  SELECT * FROM range(0, 45)
  EXCEPT
  SELECT element_order FROM read_pdf_blocks('test/fixtures/two_pages.pdf')
  WHERE element_type <> 'page_break'
);
----
2

# DOCUMENT ORDER IS MONOTONE ACROSS PAGES, asserted through the RANGE MACHINERY.
#
# These two assertions used to filter on attributes['page_number'] over content blocks. When
# that per-block attribute was dropped (markers became the only carrier), BOTH KEPT PASSING
# AND STOPPED MEANING ANYTHING: the monotone check silently degraded to comparing the two
# marker offsets (max=0 vs min=28), and the "marker opens its page" check became a tautology,
# a min over a single-row set. Caught by measuring what they evaluated after the change
# rather than by trusting that green meant unchanged.
#
# Rewritten to derive page membership the way a consumer must now derive it -- from
# duck_blocks_page_rows' ranges -- so they assert the property THROUGH the path that has to
# keep working, not through an attribute panduck happens to emit.

# The ranges PARTITION the stream: every one of the 45 blocks falls in exactly one page, and
# no block falls in none or two. A range that overlapped, or that stopped short of the end,
# fails here and cannot be masked by a count.
query I
WITH bl AS (SELECT list(b ORDER BY b.element_order) AS l FROM read_pdf_blocks('test/fixtures/two_pages.pdf') b),
     pr AS (SELECT * FROM duck_blocks_page_rows((SELECT l FROM bl)))
SELECT count(*) FROM read_pdf_blocks('test/fixtures/two_pages.pdf') x
WHERE (SELECT count(*) FROM pr
       WHERE x.element_order >= pr.start_order AND x.element_order <= pr.end_order) <> 1;
----
0

# ...and they run in document order with the sizes the fixture actually has. Pinning both
# page numbers and both counts means a reader that merged the pages, or that assigned the
# first page's blocks to the second, fails rather than still summing to 45.
query III
WITH bl AS (SELECT list(b ORDER BY b.element_order) AS l FROM read_pdf_blocks('test/fixtures/two_pages.pdf') b)
SELECT page_number, start_order,
       (SELECT count(*) FROM read_pdf_blocks('test/fixtures/two_pages.pdf') x
        WHERE x.element_order >= pr.start_order AND x.element_order <= pr.end_order)
FROM duck_blocks_page_rows((SELECT l FROM bl)) pr ORDER BY page_number;
----
1	0	28
2	28	17

# THE MARKER IS NOW THE ONLY CARRIER. Asserted directly, because it is the whole point of
# the change: content blocks must NOT carry page_number, or the redundancy is back.
query II
SELECT count(*) FILTER (WHERE attributes['page_number'] IS NOT NULL),
       count(*) FILTER (WHERE attributes['page_number'] IS NOT NULL AND element_type <> 'page_break')
FROM read_pdf_blocks('test/fixtures/two_pages.pdf');
----
2	0

# A DOCUMENT WITH NO MARKERS REPORTS ZERO PAGES, NOT ONE.
#
# duckeye's edge case, and the one that matters most to it: it renders markdown, HTML, docx
# and ZIM articles that have no pagination at all. "No page information" and "one page" are
# different facts, and a markerless document reporting one page would give every non-PDF
# document a phantom page -- the exact defect the page axis was created to remove. panduck
# is not the implementer of page_rows, but it is the producer whose emission decides the
# answer, so it is pinned on this side too.
query I
SELECT count(*) FROM duck_blocks_page_rows(
    (SELECT list(b ORDER BY b.element_order) FROM read_panduck_doc('test/fixtures/constructs.odt') b));
----
0

query I
SELECT count(*) FROM duck_blocks_page_rows(
    (SELECT list(b ORDER BY b.element_order) FROM read_panduck_doc('test/fixtures/pandoc_pstyle.docx') b));
----
0

# ---------------------------------------------------------------------------
# read_pdf_blocks HONOURS THE READER POLICY.
#
# It is a PUBLIC entry point, not only a dispatch target, so read_panduck_doc's gate does not
# cover it: before this, with pdf disabled, read_panduck_doc('x.pdf') refused while
# read_pdf_blocks('x.pdf') went straight to read_pdf_elements. A second door onto the same
# content. Asserted here rather than in reader_policy.test because that file cannot load the
# pdf community extension, which is why the gate shipped untested the first time.
statement ok
SET panduck_disabled_readers = 'pdf';

statement error
SELECT count(*) FROM read_pdf_blocks('test/fixtures/two_pages.pdf');
----
reader for format 'pdf' is disabled

# The allowlist reaches it too, not just the denylist.
statement ok
RESET panduck_disabled_readers;

statement ok
SET panduck_enabled_readers = 'odt';

statement error
SELECT count(*) FROM read_pdf_blocks('test/fixtures/two_pages.pdf');
----
reader for format 'pdf' is disabled

statement ok
RESET panduck_enabled_readers;

# NEGATIVE CONTROL: the exact same call reads once policy allows it.
query I
SELECT count(*) FROM read_pdf_blocks('test/fixtures/two_pages.pdf');
----
45

# ---------------------------------------------------------------------------
# THE DEPENDENCY GATE DOES NOT SWALLOW ARGUMENT VALIDATION.
#
# read_pdf_blocks now checks for the `pdf` extension before its body binds (#25), and the
# risk of a gate in front of a function is that every later mistake starts reporting as the
# gate's condition. With pdf PRESENT, a malformed `pages` must still be named as itself --
# the complementary half of pdf_missing_extension.test, which asserts the opposite ordering
# when the extension is absent. Neither file can make both claims.
statement error
SELECT * FROM read_pdf_blocks('test/fixtures/two_pages.pdf', pages := 'nonsense');
----
panduck: pages must be N or N-M, got nonsense

# ...including the NULL that the wrapper must pass through UNCHANGED. panduck_quote()
# coalesces NULL to '', which would have turned this into the valid empty default and lost
# the refusal entirely -- so the wrapper renders NULL as the literal NULL instead.
statement error
SELECT * FROM read_pdf_blocks('test/fixtures/two_pages.pdf', pages := NULL);
----
panduck: pages must be N or N-M, got <NULL>

# AND THE READ ITSELF IS UNCHANGED by the split into wrapper and impl.
query II
SELECT count(*), count(*) FILTER (WHERE element_type = 'page_break')
FROM read_pdf_blocks('test/fixtures/two_pages.pdf');
----
45	2

query I
SELECT count(*) FROM read_pdf_blocks('test/fixtures/two_pages.pdf', pages := '1');
----
28
