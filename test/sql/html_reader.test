# name: test/sql/html_reader.test
# description: html reaches duck_blocks through the GENERIC registry path, not a special case
# group: [sql]

#
# WHY THIS FILE EXISTS AT ALL. Until it was written, panduck had ZERO html coverage --
# no fixture, and no test that read a .html file. The registry row for html therefore
# claimed a reader nobody ever exercised, and it was stale for five days without anything
# noticing: webbed shipped read_html_blocks in v2.8.1 (2026-08-30) while panduck's row
# still said NULL and dispatch still unpacked the html_to_duck_blocks SCALAR in a
# special-case branch.
#
# That is the same two-clocks failure as the db_* -> duck_* rename earlier the same day:
# the registry is a COMPILE-TIME claim about a sibling's RUNTIME surface, and nothing
# measures it. check-vocabulary covers the vendored constants and stops there.
#
# UNGATED, unlike pdf_reader.test. webbed declares no excluded_platforms, and the
# PUBLISHED community build was measured to carry read_html_blocks before this row was
# changed -- so this runs on every CI platform rather than being locally-only coverage.

require panduck

statement ok
INSTALL webbed;

statement ok
LOAD webbed;

# ---------------------------------------------------------------------------
# THE GENERIC PATH RESOLVES. If the registry row were still NULL this would fall through
# to the removed special case and fail; if webbed renamed the function, this is where it
# goes red, naming what moved.
# ---------------------------------------------------------------------------
query I
SELECT panduck_reader_function_for('test/fixtures/constructs.html');
----
read_html_blocks

query I
SELECT panduck_reader_extension_for('test/fixtures/constructs.html');
----
webbed

# The dispatcher actually reads the file, and what comes back is duck_blocks.
query I
SELECT count(*) > 0 FROM read_panduck_doc('test/fixtures/constructs.html');
----
true

query I
SELECT bool_and(kind IN ('block', 'inline', 'value') AND encoding IS NOT NULL)
FROM read_panduck_doc('test/fixtures/constructs.html');
----
true

# Structure survives the trip -- asserted as presence of the constructs the fixture has,
# rather than as an exact row count, which would pin webbed's internal choices in place.
query I
SELECT count(*) > 0 FROM read_panduck_doc('test/fixtures/constructs.html')
WHERE element_type = 'heading';
----
true

# ---------------------------------------------------------------------------
# `pages` IS REJECTED HERE, NOT IGNORED. It was accepted and silently discarded by every
# format until now -- pages := 'utter nonsense' returned the whole document. HTML has no
# pages, and saying so is the point: silently swallowing a parameter is how it came to
# read as a working feature at the call site.
# ---------------------------------------------------------------------------
statement error
SELECT count(*) FROM read_panduck_doc('test/fixtures/constructs.html', pages := '2');
----
pages applies only to paginated formats

# ---------------------------------------------------------------------------
# doc_section: THE BLOCKS UNDER ONE HEADING, still as duck_blocks.
#
# sections.html exists specifically to exercise the STOP boundary, and that is not
# incidental. The first fixture tried (constructs.odt) had every section running to
# end-of-document -- 41 and 40 rows out of 54, both simply the tail -- so a slice with NO
# boundary logic at all would have passed. h1/h2/h1/h2 is the smallest shape where a
# section must actually stop before something.
#
# The boundary is "the next heading at the same level OR HIGHER", not "the next heading",
# because a section CONTAINS its subsections. Alpha therefore includes Alpha One and
# excludes Beta.
# ---------------------------------------------------------------------------
query I
SELECT count(*) FROM read_panduck_doc('test/fixtures/sections.html');
----
9

query I
SELECT count(*) FROM doc_section('test/fixtures/sections.html', 'Alpha');
----
4

# The subsection is INSIDE its parent, and nothing from the next h1 leaks in.
query I
SELECT bool_and(content IS NULL OR content NOT LIKE 'beta%')
FROM doc_section('test/fixtures/sections.html', 'Alpha');
----
true

query I
SELECT count(*) > 0 FROM doc_section('test/fixtures/sections.html', 'Alpha')
WHERE element_type = 'heading' AND content = 'Alpha One';
----
true

# Matched BY id, not only by heading text -- a heading's text is what a person names and
# its id is what a link names, and an HTML document has both.
query I
SELECT count(*) FROM doc_section('test/fixtures/sections.html', 'alpha-one');
----
2

# A section that is not there is EMPTY, not an error. Asking for a heading a document does
# not have is a legitimate question with the answer "nothing".
query I
SELECT count(*) FROM doc_section('test/fixtures/sections.html', 'no such heading');
----
0

# STILL duck_blocks -- the reason this slices panduck's own stream rather than wrapping
# duck_block_utils' section functions, which return rendered VARCHAR for every
# output_format including 'blocks'. A doc_* that reads a path should hand back a queryable
# table, and this one composes with every duck_block consumer because it IS one.
query I
SELECT bool_and(kind IN ('block', 'inline', 'value') AND encoding IS NOT NULL)
FROM doc_section('test/fixtures/sections.html', 'Alpha');
----
true

# FORMAT-AGNOSTIC: doc_section works over any format panduck reads, because it slices
# duck_blocks rather than anything HTML-specific.
query I
SELECT count(*) > 0 FROM doc_section('test/fixtures/constructs.odt', 'Heading Two');
----
true

# ---------------------------------------------------------------------------
# doc_container: WHAT IS INSIDE THIS BOX, a different axis from doc_section.
#
# doc_section walks HEADINGS and bounds on heading_level -- "the prose under this title".
# doc_container walks the STRUCTURAL nesting in `level` -- "what is inside this box". A
# document can disagree about the two: a <div> can hold three headings, and a heading's
# section can run across several divs. Neither is a special case of the other.
#
# THESE ASSERTIONS ARE DELIBERATELY LIMITED TO WHAT THE PUBLISHED webbed EMITS TODAY, which
# is div, section/article and heading. On community build 093856b a <p id="loose"> comes
# back with attributes {} -- the id is dropped -- so doc_container('loose') correctly finds
# nothing, and asserting otherwise would go red on every machine except one that had built
# webbed from source. webbed#142/#143 widens this to every block; when it publishes, the
# same macro simply finds more, with no change here. That is why the file asserts
# containers and a heading and stops there.
# ---------------------------------------------------------------------------
query I
SELECT count(*) FROM read_panduck_doc('test/fixtures/containers.html');
----
12

# A div owns its children and stops at the next thing at its own depth.
query I
SELECT count(*) FROM doc_container('test/fixtures/containers.html', 'intro');
----
2

# An article carries its heading and its body, and does not run into the next block.
query I
SELECT count(*) FROM doc_container('test/fixtures/containers.html', 'art');
----
3

query I
SELECT bool_and(content IS NULL OR content NOT LIKE 'loose%')
FROM doc_container('test/fixtures/containers.html', 'art');
----
true

# A LEAF carrying an id yields just itself -- the correct answer, not an empty one. This is
# why the macro matches ANY block with the id rather than only container types: a caller
# naming an id should get what that id labels, whatever the emitter called it.
query I
SELECT count(*) FROM doc_container('test/fixtures/containers.html', 'h');
----
1

# An id the document does not carry is empty, not an error -- same contract as doc_section.
query I
SELECT count(*) FROM doc_container('test/fixtures/containers.html', 'no-such-id');
----
0

# Still duck_blocks, so the slice composes with every consumer.
query I
SELECT bool_and(kind IN ('block', 'inline', 'value') AND encoding IS NOT NULL)
FROM doc_container('test/fixtures/containers.html', 'art');
----
true
