{
  "name": "duckdb-panduck",
  "version": "0.1.0",
  "dependencies": [
    "pugixml",
    {
      "name": "minizip-ng",
      "default-features": false,
      "features": [
        "zlib"
      ]
    },
    "yyjson"
  ],
  "vcpkg-configuration": {
    "overlay-ports": [
      "./vcpkg_ports",
      "./extension-ci-tools/vcpkg_ports"
    ],
    "overlay-triplets": [
      "./extension-ci-tools/toolchains"
    ]
  }
}
