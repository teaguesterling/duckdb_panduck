# name: test/sql/pandoc_writer.test
# description: the WRITE direction -- duck_blocks back out to a pandoc AST
# group: [sql]

require panduck

# ---------------------------------------------------------------------------
# WHY THIS EXISTS AT ALL.
#
# panduck shipped read-only: read_pandoc_blocks and nothing going the other way. The
# conversion code was here the whole time, unregistered, because Register() was neutered
# during the converter handoff to avoid claiming names duck_block_utils still owns.
#
# The requirement that forced it: panduck's readers are allowed to be MORE faithful than
# pandoc -- richer attributes, better block types -- but whatever they emit must still be
# writable back to VALID pandoc JSON. Valid, not identical. duck_blocks is the richer
# representation and the pandoc AST is a lossy export target; losing an attribute pandoc
# has no field for is fine, emitting a shape pandoc cannot parse is not.
#
# That requirement is untestable without a writer, which is why this file exists before
# the MediaWiki reader that prompted it.
#
# NAMES. Upstream still registers duck_blocks_to_pandoc_ast and write_pandoc_ast, and a
# name is owned by exactly one extension in this family, so panduck takes panduck_-
# prefixed names -- the same choice read_pandoc_blocks made rather than claiming
# read_pandoc_ast. When upstream drops its copy after a released panduck, the canonical
# names can be added as aliases.

# ---------------------------------------------------------------------------
# THE API VERSION IS A REGRESSION GUARD, NOT A TRIVIA CHECK.
#
# The installed duck_block_utils v1.4.3 emits [1,20], and pandoc 3.x refuses it outright:
#
#     Incompatible API versions: encoded with [1,20] but attempted to decode with [1,23,1]
#
# That is a total export failure with a clear error, which is the good case. It is pinned
# here because the failure is invisible from inside DuckDB -- the STRUCT looks perfectly
# well-formed, and only a real pandoc rejects it.
query I
SELECT (panduck_blocks_to_pandoc_ast(list(struct_pack(
    kind := kind, element_type := element_type, content := content, level := level,
    encoding := encoding, attributes := attributes, element_order := element_order)
  ORDER BY element_order)))['pandoc-api-version']
FROM read_org_blocks_string('Body text.');
----
[1, 23, 1]

# ---------------------------------------------------------------------------
# METADATA MUST SURVIVE THE WRITE.
#
# Every kind='value' row -- title, author, date, and the docx/odt/ipynb fields recovered
# by going beyond what pandoc extracts -- has to reach the AST's `meta` object. A writer
# that drops them turns "panduck recovers more metadata than pandoc" into a claim that is
# true only until you export.
query I
SELECT (panduck_blocks_to_pandoc_ast(list(struct_pack(
    kind := kind, element_type := element_type, content := content, level := level,
    encoding := encoding, attributes := attributes, element_order := element_order)
  ORDER BY element_order)))['meta'] != '{}'
FROM read_org_blocks_string(E'#+TITLE: A Title\n#+AUTHOR: A. Writer\n\nBody text.');
----
true

# The title itself has to be in there, not merely something non-empty.
query I
SELECT (panduck_blocks_to_pandoc_ast(list(struct_pack(
    kind := kind, element_type := element_type, content := content, level := level,
    encoding := encoding, attributes := attributes, element_order := element_order)
  ORDER BY element_order)))['meta'] LIKE '%A Title%'
FROM read_org_blocks_string(E'#+TITLE: A Title\n\nBody.');
----
true

# ---------------------------------------------------------------------------
# BLOCK TYPES THAT THE INSTALLED WRITER LOST.
#
# Round-tripping pandoc's own MediaWiki AST through duck_block_utils v1.4.3 collapsed
# DefinitionList into BulletList and Figure into Para -- 18 blocks in, 21 out. panduck's
# READ of the same input is correct, so the loss was the writer's.
#
# Whether panduck's newer copy shares those defects was untestable while it was
# unregistered. These two assertions are what make it testable, and they are written
# against the construct rather than the format: a definition list reaches this writer from
# org, rst, epub, latex and mediawiki alike.
query I
SELECT (panduck_blocks_to_pandoc_ast(list(struct_pack(
    kind := kind, element_type := element_type, content := content, level := level,
    encoding := encoding, attributes := attributes, element_order := element_order)
  ORDER BY element_order)))['blocks'] LIKE '%DefinitionList%'
FROM read_org_blocks_string('- term :: definition');
----
true

query I
SELECT (panduck_blocks_to_pandoc_ast(list(struct_pack(
    kind := kind, element_type := element_type, content := content, level := level,
    encoding := encoding, attributes := attributes, element_order := element_order)
  ORDER BY element_order)))['blocks'] LIKE '%BulletList%'
FROM read_org_blocks_string(E'- one\n- two');
----
true

# ---------------------------------------------------------------------------
# THE BLOCKS ARRAY IS REACHABLE ON ITS OWN, for a caller splicing panduck output into an
# AST it already has rather than exporting a whole document.
query I
SELECT panduck_blocks_to_pandoc_blocks(list(struct_pack(
    kind := kind, element_type := element_type, content := content, level := level,
    encoding := encoding, attributes := attributes, element_order := element_order)
  ORDER BY element_order)) LIKE '[%]'
FROM read_org_blocks_string('Body.');
----
true

# ---------------------------------------------------------------------------
# NULL INPUT PRODUCES AN EMPTY DOCUMENT, NOT AN ERROR OR A NULL.
#
# An empty document is a real answer -- a file with no readable blocks exports as a valid
# pandoc AST with no blocks. Returning NULL here would make the caller's own write fail
# somewhere further downstream, where the cause is no longer visible.
query I
SELECT (panduck_blocks_to_pandoc_ast(NULL))['blocks'];
----
[]

# ---------------------------------------------------------------------------
# THE FILE WRITER MUST NOT DROP METADATA EITHER.
#
# panduck_blocks_to_pandoc_ast composes `meta` with BuildMetaJson. WritePandocAstFun --
# the same conversion, one function further down the file -- wrote a HARDCODED "meta":{}
# instead, so every kind='value' row vanished on the way to disk.
#
# Two functions, one rule, and only one of them implemented it. That is the two-copies-of-
# one-rule shape: the divergence is invisible in review because each body reads correctly
# on its own, and nothing compares them.
statement ok
SELECT panduck_write_pandoc_ast('__TEST_DIR__/written_ast.json', list(struct_pack(
    kind := kind, element_type := element_type, content := content, level := level,
    encoding := encoding, attributes := attributes, element_order := element_order)
  ORDER BY element_order))
FROM read_org_blocks_string(E'#+TITLE: A Title\n#+AUTHOR: A. Writer\n\nBody.');

query I
SELECT content LIKE '%A Title%' AND content LIKE '%A. Writer%'
FROM read_text('__TEST_DIR__/written_ast.json');
----
true

# And the blocks are still there beside the metadata -- a writer that emitted metadata by
# dropping content would satisfy the assertion above.
query I
SELECT content LIKE '%Body.%'
FROM read_text('__TEST_DIR__/written_ast.json');
----
true

# ---------------------------------------------------------------------------
# NATIVE TABLES MUST BE CONVERTED, NOT PASSED THROUGH.
#
# A table carrying attributes['pandoc_ast'] round-trips through that preserved tuple. A
# table WITHOUT one -- which is every table any native reader produces -- fell through to a
# branch that dumped duck_block's own {"headers":…,"rows":…} straight into the pandoc `c`
# field. pandoc rejects it outright:
#
#     When parsing the constructor Table of type Text.Pandoc.Definition.Block
#     expected Array but got Object
#
# So every native reader's tables were unexportable, and the compatibility claim held only
# for tables that came from pandoc to begin with. It stayed invisible because nothing wrote
# fixtures back out until the write direction was registered, and because exactly ONE
# fixture in the tree contains a table at all.
#
# The duck_block key names are the tell: if `headers` appears anywhere in a pandoc AST,
# the native projection leaked instead of being converted.
query I
SELECT (panduck_blocks_to_pandoc_ast(list(struct_pack(
    kind := kind, element_type := element_type, content := content, level := level,
    encoding := encoding, attributes := attributes, element_order := element_order)
  ORDER BY element_order)))['blocks'] LIKE '%"headers"%'
FROM read_panduck_doc('test/fixtures/spine_order.epub');
----
false

# The table must still be THERE after conversion -- emitting nothing would satisfy the
# assertion above just as well as converting correctly.
#
# ColWidthDefault is the marker to look for, and it is one I got wrong first: I asserted
# "TableHead", which reads like the obvious tag and appears NOWHERE in pandoc's wire
# format -- the head is an untagged [attr, [rows]] pair. ColWidthDefault is a real tagged
# constructor, emitted once per column by the colspec builder, so it appears if and only
# if a table was actually converted.
query I
SELECT (panduck_blocks_to_pandoc_ast(list(struct_pack(
    kind := kind, element_type := element_type, content := content, level := level,
    encoding := encoding, attributes := attributes, element_order := element_order)
  ORDER BY element_order)))['blocks'] LIKE '%ColWidthDefault%'
FROM read_panduck_doc('test/fixtures/spine_order.epub');
----
true

# And a cell's text has to survive into the converted structure.
query I
SELECT (panduck_blocks_to_pandoc_ast(list(struct_pack(
    kind := kind, element_type := element_type, content := content, level := level,
    encoding := encoding, attributes := attributes, element_order := element_order)
  ORDER BY element_order)))['blocks'] LIKE '%cell one%'
FROM read_panduck_doc('test/fixtures/spine_order.epub');
----
true

# ---------------------------------------------------------------------------
# A RAW BLOCK MUST EXPORT AS RawBlock, AND KEEP ITS FORMAT -- at any depth.
#
# duck_block documents TYPE_RAW as "literal content in a NAMED format", and `encoding` is
# the field that names it. A nested raw block came out as `Div class="raw"` wrapping a
# Plain instead: the content survived, but the format name was discarded entirely, so
# ipynb's markdown cell reached the AST with the word "markdown" nowhere in it.
#
# That is the one fact `encoding` exists to carry, dropped on the way out. It is also
# exactly the defect this function's `hr` arm already fixed once, for the same reason
# written in its comment: a type pandoc can express exactly should be written exactly, and
# the same constructor should not depend on which container it sits in.
query I
SELECT (panduck_blocks_to_pandoc_ast(list(struct_pack(
    kind := kind, element_type := element_type, content := content, level := level,
    encoding := encoding, attributes := attributes, element_order := element_order)
  ORDER BY element_order)))['blocks'] LIKE '%RawBlock%'
FROM read_ipynb_blocks('test/fixtures/notebook.ipynb');
----
true

# ...and the format it names has to be the one the reader recorded, not the "html" default.
query I
SELECT (panduck_blocks_to_pandoc_ast(list(struct_pack(
    kind := kind, element_type := element_type, content := content, level := level,
    encoding := encoding, attributes := attributes, element_order := element_order)
  ORDER BY element_order)))['blocks'] LIKE '%"markdown"%'
FROM read_ipynb_blocks('test/fixtures/notebook.ipynb');
----
true

# The content must still be there -- emitting an empty RawBlock would satisfy both
# assertions above.
query I
SELECT (panduck_blocks_to_pandoc_ast(list(struct_pack(
    kind := kind, element_type := element_type, content := content, level := level,
    encoding := encoding, attributes := attributes, element_order := element_order)
  ORDER BY element_order)))['blocks'] LIKE '%Notebook Title%'
FROM read_ipynb_blocks('test/fixtures/notebook.ipynb');
----
true

# ---------------------------------------------------------------------------
# AN UNWRITABLE PATH MUST STILL SAY SO -- AND THE EXPECTATION IS SPELLED SO THAT IT
# CAN ACTUALLY TELL THE TWO CASES APART.
#
# DuckDB v2.0 checks that a scalar function which throws at execution time has declared
# that it can. One that has not gets its error replaced by
#
#     INTERNAL Error: Scalar function "panduck_write_pandoc_ast" threw an execution
#     error, but the function is not marked as fallible - the function must call
#     SetFallible(). Error: Could not open file for writing: ...
#
# NOTE WHAT THAT MESSAGE CONTAINS. ThrowNonFallibleFunctionError interpolates
# error.RawMessage(), so the ORIGINAL text is still in there -- which means the obvious
# expectation, "Could not open file for writing", matches the broken build just as well
# as the correct one and proves nothing. A sibling port shipped exactly that assertion
# and it passed while the function was mis-declared.
#
# RawMessage() drops the exception's TYPE PREFIX, and that is the discriminator: the
# correct build's message begins "IO Error: Could not open file for writing", while the
# internal one begins "INTERNAL Error: Scalar function ..." and never contains the
# "IO Error: " prefix immediately before the text. So the expectation below includes it
# deliberately. Do not shorten it.
#
# Verified live rather than assumed: with the expected text replaced by a string this
# build never emits, this assertion fails -- so it is being checked, not skipped.
#
# All three write functions are marked, not just this one: they share BuildBlocksJson,
# whose recursion calls CheckPandocDepth and raises InvalidInputException past 128 levels
# of nesting. The right question was which throwing HELPERS the registered functions
# reach, not which registration sites have a `throw` next to them.
#
# This passes on the pinned v1.5.5 either way, which has no such check at all -- that is
# why the missing declaration was invisible until something built against main.
statement error
SELECT panduck_write_pandoc_ast('__TEST_DIR__/no_such_directory/written.json', list(struct_pack(
    kind := kind, element_type := element_type, content := content, level := level,
    encoding := encoding, attributes := attributes, element_order := element_order)
  ORDER BY element_order))
FROM read_org_blocks_string('Body.');
----
IO Error: Could not open file for writing

# ---------------------------------------------------------------------------
# CODE AND MATH INLINES SURVIVE THE PANDOC AST BRIDGE, IN BOTH DIRECTIONS.
#
# duck_block_utils issue #21 is that THEIR pandoc_ast_to_blocks drops Code and Math inline
# content -- silent data loss, which is release-blocking on its own. panduck reads and
# writes the other end of the same bridge, so the question worth answering is not "do we
# have their bug" but "would our tests NOTICE if we did".
#
# Measured: we do not have it -- Code and Math both round-trip byte-exactly. But the only
# assertions that mentioned math were the LaTeX reader's, and nothing pinned EITHER inline
# across the pandoc path. A reader could have started dropping Math and this suite would
# have stayed green, which is exactly the condition that lets that class of bug live.
#
# The payloads are deliberately unique strings rather than plausible content: if a
# conversion drops them and substitutes something reasonable-looking, an eyeball check
# passes and this does not.
query II
SELECT element_type, content
FROM read_pandoc_blocks_string('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Para","c":[{"t":"Str","c":"before"},{"t":"Space"},{"t":"Code","c":[["",[],[]],"CODE_PAYLOAD"]},{"t":"Space"},{"t":"Math","c":[{"t":"InlineMath"},"MATH_PAYLOAD"]},{"t":"Space"},{"t":"Str","c":"after"}]}]}')
WHERE element_type IN ('code', 'math') ORDER BY element_order;
----
code	CODE_PAYLOAD
math	MATH_PAYLOAD

# ...AND BACK OUT AGAIN. The write direction is the half panduck owns: blocks in, pandoc
# AST out. Asserted on the rendered JSON rather than on a block count, because a count
# survives an inline being emitted with its content emptied -- which is precisely the shape
# of the upstream bug.
query II
WITH b AS (
  SELECT list(x ORDER BY x.element_order) AS bl
  FROM read_pandoc_blocks_string('{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Para","c":[{"t":"Code","c":[["",[],[]],"CODE_PAYLOAD"]},{"t":"Math","c":[{"t":"InlineMath"},"MATH_PAYLOAD"]}]}]}') x
)
SELECT contains(panduck_blocks_to_pandoc_ast((SELECT bl FROM b)).blocks::VARCHAR, '"Code","c":[["",[],[]],"CODE_PAYLOAD"]'),
       contains(panduck_blocks_to_pandoc_ast((SELECT bl FROM b)).blocks::VARCHAR, '"Math","c":[{"t":"InlineMath"},"MATH_PAYLOAD"]');
----
true	true

# ---------------------------------------------------------------------------
# panduck_pandoc_api_version() RETURNS THE SHAPE PANDOC WANTS, AND AGREES WITH THE STRUCT.
#
# It returned the VARCHAR '1.23' until #7 -- wrong for the one thing its name promises.
# Building an envelope with it yields `parsing [] failed, expected Array, but encountered
# String` and pandoc refuses the document. It also dropped the PATCH component that the AST
# struct carried, so two spellings of one fact disagreed.
#
# The equality is the assertion that matters: a hardcoded [1,23,1] here would pass while the
# two drifted apart again, which is exactly how they came to differ.
query II
SELECT panduck_pandoc_api_version(),
       panduck_pandoc_api_version()
         = (panduck_blocks_to_pandoc_ast(panduck_read_blocks('test/fixtures/pandoc_pstyle.docx')))."pandoc-api-version";
----
[1, 23, 1]	true

# ---------------------------------------------------------------------------
# panduck_pandoc_ast_json() EMITS A DOCUMENT PANDOC ACCEPTS.
#
# to_json() on the AST struct does not: `meta` and `blocks` hold JSON inside VARCHAR, so it
# escapes their contents as strings while pandoc-api-version serialises as a real array, and
# pandoc rejects the result with `parsing Map ~Text failed, expected Object, but encountered
# String`. Declaring the fields LogicalType::JSON() does not fix it -- measured, the alias
# does not survive a STRUCT here in either load order.
#
# ASSERTED ON STRUCTURE, NOT ON A PREFIX. The failing form starts with the same
# {"pandoc-api-version":[1,23,1] as the working one; what distinguishes them is whether meta
# and blocks are objects or escaped strings. So this checks the JSON parses AND that the two
# fields come back as container types.
statement ok
INSTALL json;

statement ok
LOAD json;

query III
SELECT json_valid(panduck_pandoc_ast_json(panduck_read_blocks('test/fixtures/pandoc_pstyle.docx'))),
       json_type(panduck_pandoc_ast_json(panduck_read_blocks('test/fixtures/pandoc_pstyle.docx')), '$.meta'),
       json_type(panduck_pandoc_ast_json(panduck_read_blocks('test/fixtures/pandoc_pstyle.docx')), '$.blocks');
----
true	OBJECT	ARRAY

# NEGATIVE CONTROL: to_json() on the struct still produces the broken shape, so the
# assertion above is discriminating between two live behaviours rather than describing one.
query II
SELECT json_type(to_json(panduck_blocks_to_pandoc_ast(panduck_read_blocks('test/fixtures/pandoc_pstyle.docx')))::VARCHAR, '$.meta'),
       json_type(to_json(panduck_blocks_to_pandoc_ast(panduck_read_blocks('test/fixtures/pandoc_pstyle.docx')))::VARCHAR, '$.blocks');
----
VARCHAR	VARCHAR

# NULL IN, NULL OUT -- and that DIVERGES FROM THE WRITER on purpose, which is worth stating
# because two functions built from the same pieces answering differently is how the
# meta-drift bug documented in WritePandocAstFun happened.
#
# panduck_write_pandoc_ast(path, NULL) writes {"pandoc-api-version":...,"meta":{},"blocks":[]}
# to disk: it was asked to produce a file, and an empty document is a file. This returns a
# VALUE, where NULL-in/NULL-out is what every other scalar in SQL does and what a caller
# composing an expression will expect. Asserted so the difference is a decision on the
# record rather than something discovered later and "fixed" in whichever direction.
query I
SELECT panduck_pandoc_ast_json(NULL) IS NULL;
----
true

#
# ONE CALL FROM BLOCKS TO A DOCUMENT PANDOC ACCEPTS (#37).
#
# The AST struct holds `meta` and `blocks` as JSON in VARCHAR, so to_json() on it escapes
# them as strings while pandoc-api-version serialises as a real array -- a document that
# looks right and that pandoc rejects with exit 64. panduck_blocks_to_pandoc_json assembles
# it properly.
#
# RENAMED FROM panduck_pandoc_ast_json, which shipped in v0.4.1 and reads as AST-IN when the
# argument is BLOCKS -- its sibling panduck_pandoc_ast_to_blocks genuinely is ast-in, so the
# pair implied a symmetry that does not exist. duckeye searched for a blocks-to-JSON route,
# did not find this, and hand-rolled the assembly with json_object and three ::JSON casts.
# The name cost exactly the work it existed to save.

query I
SELECT starts_with(panduck_blocks_to_pandoc_json(panduck_read_blocks('test/fixtures/pandoc_pstyle.docx')),
                   '{"pandoc-api-version":[1,23,1]');
----
true

# blocks IS AN ARRAY, NOT AN ESCAPED STRING. This is the whole defect in one assertion: the
# struct's to_json() renders it as "[{\"t\":...", which pandoc refuses.
query I
SELECT contains(panduck_blocks_to_pandoc_json(panduck_read_blocks('test/fixtures/pandoc_pstyle.docx')),
                '"blocks":[{"t":')
   AND NOT contains(panduck_blocks_to_pandoc_json(panduck_read_blocks('test/fixtures/pandoc_pstyle.docx')),
                    '"blocks":"[');
----
true

# THE OLD NAME STILL WORKS AND IS IDENTICAL. It is SERVED -- `INSTALL panduck FROM community`
# carries v0.4.1 -- so removing it to improve the name would trade someone else's breakage
# for our tidiness. Deprecated, not deleted.
query I
SELECT panduck_pandoc_ast_json(panduck_read_blocks('test/fixtures/pandoc_pstyle.docx'))
     = panduck_blocks_to_pandoc_json(panduck_read_blocks('test/fixtures/pandoc_pstyle.docx'));
----
true

# ...and it is the SAME document the file writer would have written, so the two routes cannot
# drift apart.
query I
SELECT panduck_blocks_to_pandoc_json(panduck_read_blocks('test/fixtures/pandoc_pstyle.docx'))
     LIKE '%"meta":{%';
----
true
