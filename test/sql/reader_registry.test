# name: test/sql/reader_registry.test
# description: derived reader dispatch — one reader per extension, no drift
# group: [sql]

#
# Everything here runs on panduck alone. Assertions that would need markdown, toml or
# sitting_duck installed are deliberately absent rather than gated with `require`, which
# would skip the whole file and take these with it.

require panduck

# ---------------------------------------------------------------------------
# The registry is DERIVED, not restated. .rtf appears because
# panduck_supported_extensions() says rtf is implemented and names read_rtf_blocks --
# nothing in reader_registry.cpp mentions rtf.
# ---------------------------------------------------------------------------
query IIII
SELECT ext, format, reader_ext, function FROM panduck_reader_registry() WHERE ext = '.rtf';
----
.rtf	rtf	panduck	read_rtf_blocks

# A planned-but-unimplemented format must NOT be routable: dispatch would name a function
# that does not exist. .rst is the current example -- .docx was, then .odt, then .epub,
# then .tex, each of which made this assertion correctly go red and demand promotion
# rather than a patch. The example moving down the roadmap is the ratchet working.
query I
SELECT count(*) FROM panduck_reader_registry() WHERE ext = '.rst';
----
0

# ...and .tex IS routable now, through the same derivation. Both extensions the latex
# format claims resolve to the one reader, which is what a format claiming more than one
# suffix has to mean.
query III
SELECT ext, reader_ext, function FROM panduck_reader_registry()
WHERE ext IN ('.tex', '.latex') ORDER BY ext;
----
.latex	panduck	read_latex_blocks
.tex	panduck	read_latex_blocks

# ...and .epub IS routable now, through the same derivation. A book is a ZIP whose spine
# names its reading order, and none of that is visible here: the registry learned about it
# from the self-description alone.
query III
SELECT ext, reader_ext, function FROM panduck_reader_registry() WHERE ext = '.epub';
----
.epub	panduck	read_epub_blocks

# ...and an implemented one IS routable, derived from the self-description with no edit
# to reader_registry.cpp. read_panduck_doc contains no branch naming docx.
query III
SELECT ext, reader_ext, function FROM panduck_reader_registry() WHERE ext = '.docx';
----
.docx	panduck	read_docx_blocks

# THE DRIFT TEST. Holds by construction here -- Register() replaces rather than appends --
# but asserted because "by construction" is a property of today's implementation.
query I
SELECT count(*) FROM (SELECT ext FROM panduck_reader_registry() GROUP BY ext HAVING count(*) > 1);
----
0

# Every registered entry names a reader extension and a kind.
query I
SELECT count(*) FROM panduck_reader_registry()
WHERE reader_ext IS NULL OR reader_ext = '' OR kind NOT IN ('doc', 'table');
----
0

# Extensions are lowercase and dot-prefixed, matching sitting_duck's convention so the
# two registries union without per-registry normalisation.
query I
SELECT count(*) FROM panduck_reader_registry()
WHERE ext <> lower(ext) OR NOT starts_with(ext, '.') OR length(ext) < 2;
----
0

# ---------------------------------------------------------------------------
# Lookups. Pure string work -- no I/O, so these answer for files that do not exist.
# ---------------------------------------------------------------------------
query III
SELECT panduck_format_for('a.rtf'), panduck_format_for('a.csv'), panduck_format_for('a.md');
----
rtf	data	markdown

# Unclaimed extensions are NULL, not a guess. If this answered 'code' for everything,
# panduck_can_read would be true for every path and would mean nothing.
query II
SELECT panduck_format_for('a.nope') IS NULL, panduck_can_read('a.nope');
----
true	false

# Case and directories do not matter.
query II
SELECT panduck_format_for('/tmp/DIR.d/A.RTF'), panduck_format_for('no_extension_at_all') IS NULL;
----
rtf	true

# ---------------------------------------------------------------------------
# THE IDENTITY. For a format panduck reads natively, the dispatcher must be
# indistinguishable from the reader it dispatches to. Symmetric, because a
# one-directional EXCEPT would miss rows the dispatcher DROPS.
#
# This is the check a DESCRIBE-style schema guard cannot make: a transposed column list
# inside panduck_block_cols() keeps the canonical names and types while corrupting every
# row, and only a value comparison sees it.
# ---------------------------------------------------------------------------
query I
SELECT (SELECT count(*) FROM ((SELECT * FROM read_panduck_doc('test/fixtures/pandoc_outlinelevel.rtf'))
                       EXCEPT (SELECT * FROM read_rtf_blocks('test/fixtures/pandoc_outlinelevel.rtf'))))
     + (SELECT count(*) FROM ((SELECT * FROM read_rtf_blocks('test/fixtures/pandoc_outlinelevel.rtf'))
                       EXCEPT (SELECT * FROM read_panduck_doc('test/fixtures/pandoc_outlinelevel.rtf'))));
----
0

# POSITIVE COMPANION, and it is load-bearing. The identity above is satisfied by MUTUAL
# EMPTINESS -- two readers that both return nothing agree perfectly. Verified: against an
# empty RTF the EXCEPT assertion still reports 0. A negative assertion is satisfied by
# absence, so it certifies nothing without a positive one beside it.
query II
SELECT element_type, content FROM read_panduck_doc('test/fixtures/pandoc_outlinelevel.rtf')
WHERE element_type = 'heading' ORDER BY element_order;
----
heading	Heading One
heading	Heading Two

# The dispatcher's schema is the canonical duck_block schema, so a row casts to duck_block
# and `SELECT *` pass-through in the flat branches is safe.
query I
SELECT count(*) FROM read_panduck_doc('test/fixtures/pandoc_outlinelevel.rtf')
WHERE kind NOT IN ('block', 'inline', 'value') OR encoding IS NULL;
----
0

# An explicit format overrides extension sniffing.
query I
SELECT count(*) > 0 FROM read_panduck_doc('test/fixtures/pandoc_outlinelevel.rtf', format := 'rtf');
----
true

# The LIST-shaped companion returns the same document.
query I
SELECT len(panduck_read_blocks('test/fixtures/pandoc_outlinelevel.rtf'))
     = (SELECT count(*) FROM read_panduck_doc('test/fixtures/pandoc_outlinelevel.rtf'));
----
true

# ...IN DOCUMENT ORDER. doc_section slices this list by position, so element_order must
# equal list position at every row. The wrapper orders explicitly rather than relying on
# a table function's emission order, which nothing in the contract guarantees.
query I
SELECT count(*) FROM (
  SELECT e, row_number() OVER () AS rn FROM (
    SELECT unnest(panduck_read_blocks('test/fixtures/pandoc_outlinelevel.rtf')) AS e
  )
) WHERE (e).element_order <> rn - 1;
----
0

# ...and the list is not empty, which the mismatch count alone would not tell us.
query I
SELECT len(panduck_read_blocks('test/fixtures/pandoc_outlinelevel.rtf')) > 0;
----
true

# Heading level lives in attributes['heading_level'], NOT the level field. The two are
# different facts about the same element and always were: heading_level is SEMANTIC (an
# h2 is an h2 wherever it sits), while level is STRUCTURAL nesting depth.
#
# This assertion used to read `level IS NULL`, on the reasoning that a heading has no
# hierarchy depth. That conflated the two: it took "no semantic level in this field" for
# "no structural level at all", and a NULL there is not the absence of a heading level --
# it is the absence of a fact about where the heading sits. Every element now carries a
# structural level, so an RTF heading at the top of a flat document is 1.
query II
SELECT level, attributes['heading_level']
FROM read_panduck_doc('test/fixtures/pandoc_outlinelevel.rtf')
WHERE element_type = 'heading' ORDER BY element_order LIMIT 1;
----
1	1

# ---------------------------------------------------------------------------
# Documents vs data. A .csv has no document structure; refusing it by name beats
# returning something shaped like a document that isn't one.
# ---------------------------------------------------------------------------
statement error
SELECT * FROM read_panduck_doc('test/fixtures/pandoc_outlinelevel.rtf', format := 'data');
----
is a data format

# A format the registry CLAIMS but dispatch has no branch for must fail loudly. Guarded
# on format_for IS NULL rather than a bare ELSE: a catch-all would route it to the code
# fallback and return a parse tree instead of a document -- silently wrong rather than
# loudly missing. .yaml behaved exactly that way until it got a branch.
statement error
SELECT * FROM read_panduck_doc('test/fixtures/pandoc_outlinelevel.rtf', format := 'epub');
----
has no branch for it

# Every format the registry claims for a document must be dispatchable. This is the
# general form of the assertion above: it fails when a format is added to the registry
# without a branch, rather than waiting for someone to read such a file.
query I
SELECT count(*) FROM panduck_reader_registry()
WHERE kind = 'doc'
  AND format NOT IN ('markdown', 'html', 'pdf', 'pandoc_ast', 'toml', 'yaml', 'code')
  AND function IS NULL;
----
0

# ---------------------------------------------------------------------------
# Runtime registration. A user reader REPLACES the entry for an extension rather than
# competing with it, so one-reader-per-extension survives customisation.
# ---------------------------------------------------------------------------
statement ok
CALL panduck_register_doc_reader('panduck', 'read_rtf_blocks', ['.fixture', 'DOTLESS']);

# Both spellings normalise: dot-prefixed and bare, upper and lower.
query II
SELECT ext, function FROM panduck_reader_registry() WHERE source = 'user' ORDER BY ext;
----
.dotless	read_rtf_blocks
.fixture	read_rtf_blocks

# Overriding a builtin REPLACES it -- still exactly one row for the extension, now
# owned by the user entry rather than competing with the builtin.
statement ok
CALL panduck_register_doc_reader('panduck', 'read_rtf_blocks', ['.rtf']);

query III
SELECT count(*), max(source), max(reader_ext) FROM panduck_reader_registry() WHERE ext = '.rtf';
----
1	user	panduck

# ...and dispatch goes through the user entry, producing the same document. This is the
# generic branch: the registry named a function, so it was called, with no branch in
# read_panduck_doc mentioning rtf at all.
query I
SELECT (SELECT count(*) FROM ((SELECT * FROM read_panduck_doc('test/fixtures/pandoc_outlinelevel.rtf'))
                       EXCEPT (SELECT * FROM read_rtf_blocks('test/fixtures/pandoc_outlinelevel.rtf'))))
     + (SELECT count(*) FROM ((SELECT * FROM read_rtf_blocks('test/fixtures/pandoc_outlinelevel.rtf'))
                       EXCEPT (SELECT * FROM read_panduck_doc('test/fixtures/pandoc_outlinelevel.rtf'))));
----
0

# Registering nothing is an error rather than a silent no-op.
statement error
CALL panduck_register_doc_reader('x', 'y', []::VARCHAR[]);
----
at least one file extension

# ---------------------------------------------------------------------------
# EVERY READER EMITS A RECONSTRUCTIBLE TREE. `level` and adjacency are the WHOLE of
# duck_block's structure -- there is no parent pointer and no child list -- so a depth-first
# emission must obey three rules, all of which duck_block_utils' validator enforces as of
# spec 3.0:
#
#   level is never NULL      a NULL is not a depth; it is the absence of the one fact
#                            that says where an element sits
#   level is never below 1   the document root is 1
#   level never JUMPS by >1  depth-first descends one at a time, so a jump means the
#                            parent is not in the list at all and the tree cannot be
#                            rebuilt -- this is what a reader emitting list_items with no
#                            enclosing list looks like from the outside
#
# A decrease of any size is legal: that is simply closing several containers at once.
#
# This is asserted across all four readers at once because it is a property of the
# vocabulary rather than of any one format, and because the cheap version of this test --
# checking a single reader -- would have passed while three others were broken. It would
# have FAILED before the structural-level migration, when every block carried NULL.
query IIII
WITH r AS (
  SELECT 'a_docx' AS src, element_order, level FROM read_docx_blocks('test/fixtures/pandoc_pstyle.docx')
  UNION ALL SELECT 'b_odt', element_order, level FROM read_odt_blocks('test/fixtures/pandoc.odt')
  UNION ALL SELECT 'c_rtf', element_order, level FROM read_rtf_blocks('test/fixtures/pandoc_outlinelevel.rtf')
  UNION ALL SELECT 'd_epub', element_order, level FROM read_epub_blocks('test/fixtures/pandoc.epub')
  UNION ALL SELECT 'e_epub_spine', element_order, level FROM read_epub_blocks('test/fixtures/spine_order.epub')
  UNION ALL SELECT 'f_epub_libre', element_order, level FROM read_epub_blocks('test/fixtures/libreoffice.epub')
  UNION ALL SELECT 'g_latex', element_order, level FROM read_latex_blocks('test/fixtures/handwritten.tex')
  UNION ALL SELECT 'h_latex_pandoc', element_order, level FROM read_latex_blocks('test/fixtures/pandoc.tex')
  -- ...AND A NESTED ONE, which no fixture on disk supplies: handwritten.tex and pandoc.tex
  -- both write \textbf{bold} flat, so neither exercises the case this invariant is most
  -- likely to catch. Inline nesting is the one place a panduck reader emits a level deeper
  -- than block+1, and a jump of 2 there means the parent run is missing from the stream and
  -- the tree cannot be rebuilt. Asserted through the string form because putting nesting in
  -- a fixture would change what the two-writer equivalence tests compare.
  UNION ALL SELECT 'i_latex_nested', element_order, level
    FROM read_latex_blocks_string('deep \textbf{a \emph{b \texttt{c \textsc{d}}}} tail.')
), d AS (
  SELECT src, level, level - lag(level) OVER (PARTITION BY src ORDER BY element_order) AS delta FROM r
)
SELECT src,
       count(*) FILTER (WHERE level IS NULL),
       count(*) FILTER (WHERE level < 1),
       count(*) FILTER (WHERE delta > 1)
FROM d GROUP BY src ORDER BY src;
----
a_docx	0	0	0
b_odt	0	0	0
c_rtf	0	0	0
d_epub	0	0	0
e_epub_spine	0	0	0
f_epub_libre	0	0	0
g_latex	0	0	0
h_latex_pandoc	0	0	0
i_latex_nested	0	0	0

# ---------------------------------------------------------------------------
# EVERY HEADING CARRIES attributes['heading_level']. Under spec 3.0 a heading without it
# has NO rank information at all, and consumers are forbidden from falling back to `level`
# -- that fallback was a fair reading of 1.x, and under 3.0 it renders a heading sitting
# inside two containers as an h3 whatever it actually is.
#
# `level` and heading_level DIFFERING IS NORMAL, not a conflict: a top-level h2 is level 1,
# heading_level 2. They are two independent facts -- structural depth and semantic rank --
# and the second column below exists so that is asserted rather than assumed.
#
# The heading COUNT is the positive companion and it is load-bearing. "No heading is
# missing its level" is satisfied perfectly by a document with no headings, and one of
# these fixtures (libreoffice.epub) genuinely has none -- it marks headings only in CSS.
# Without the count this whole assertion could pass while every reader emitted nothing.
query III
WITH r AS (
  SELECT 'a_docx' AS src, element_type, attributes['heading_level'] AS hl FROM read_docx_blocks('test/fixtures/pandoc_pstyle.docx')
  UNION ALL SELECT 'b_docx_outline', element_type, attributes['heading_level'] FROM read_docx_blocks('test/fixtures/libreoffice_outlinelvl.docx')
  UNION ALL SELECT 'c_odt', element_type, attributes['heading_level'] FROM read_odt_blocks('test/fixtures/pandoc.odt')
  UNION ALL SELECT 'd_rtf', element_type, attributes['heading_level'] FROM read_rtf_blocks('test/fixtures/pandoc_outlinelevel.rtf')
  UNION ALL SELECT 'e_rtf_style', element_type, attributes['heading_level'] FROM read_rtf_blocks('test/fixtures/libreoffice_stylesheet.rtf')
  UNION ALL SELECT 'f_epub', element_type, attributes['heading_level'] FROM read_epub_blocks('test/fixtures/pandoc.epub')
  UNION ALL SELECT 'g_epub_spine', element_type, attributes['heading_level'] FROM read_epub_blocks('test/fixtures/spine_order.epub')
  UNION ALL SELECT 'h_latex', element_type, attributes['heading_level'] FROM read_latex_blocks('test/fixtures/handwritten.tex')
  UNION ALL SELECT 'i_latex_pandoc', element_type, attributes['heading_level'] FROM read_latex_blocks('test/fixtures/pandoc.tex')
)
SELECT src,
       count(*) FILTER (WHERE element_type = 'heading'),
       count(*) FILTER (WHERE element_type = 'heading' AND hl IS NULL)
FROM r GROUP BY src ORDER BY src;
----
a_docx	2	0
b_docx_outline	2	0
c_odt	2	0
d_rtf	2	0
e_rtf_style	2	0
f_epub	2	0
g_epub_spine	2	0
h_latex	2	0
i_latex_pandoc	2	0

