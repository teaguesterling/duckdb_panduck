# name: test/sql/odt_reader.test
# description: read_odt_blocks() over ODT produced by two different real writers
# group: [sql]

#
# ODT HAS NO HEADING AMBIGUITY, and that is the interesting result. RTF and DOCX each mark
# headings two mutually exclusive ways, with pandoc and LibreOffice on opposite sides in
# the two formats. Both writers emit identical ODT:
#
#   <text:h text:style-name="Heading_20_1" text:outline-level="1">
#
# ODF has a DEDICATED heading element with an explicit level, so there is nothing to
# disagree about. The lesson from the other two formats is not "always expect two
# mechanisms" -- it is "expect them wherever headings are a paragraph wearing a hat."

require panduck

# ---------------------------------------------------------------------------
# Both writers, same markup, same result.
# ---------------------------------------------------------------------------
query II
SELECT content, attributes['heading_level'] AS lvl
FROM read_odt_blocks('test/fixtures/pandoc.odt')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	1
Heading Two	2

query II
SELECT content, attributes['heading_level'] AS lvl
FROM read_odt_blocks('test/fixtures/libreoffice.odt')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	1
Heading Two	2

# ---------------------------------------------------------------------------
# Inline formatting resolves through <office:automatic-styles>: a run names a style
# (text:style-name="T1") and the style carries fo:font-weight and friends.
# ---------------------------------------------------------------------------
query II
SELECT element_type, trim(content) FROM read_odt_blocks('test/fixtures/pandoc.odt')
WHERE kind = 'inline' AND element_type <> 'text' ORDER BY element_order;
----
bold	bold
italic	italic
strikethrough	strike

# ---------------------------------------------------------------------------
# LIST CONTENT IS PRESERVED. ODF nests it as text:list > text:list-item > text:p, and an
# earlier version of this reader skipped text:list wholesale -- losing the WORDS, not just
# the list structure. The differential validator caught it at the text level. List
# structure is still unmodelled; the text is not optional.
# ---------------------------------------------------------------------------
query I
SELECT count(*) FROM read_odt_blocks('test/fixtures/pandoc.odt') WHERE content LIKE '%bullet one%';
----
1

query I
SELECT count(*) FROM read_odt_blocks('test/fixtures/pandoc.odt') WHERE content LIKE '%bullet two%';
----
1

# ---------------------------------------------------------------------------
# Unicode survives the ZIP + XML path.
# ---------------------------------------------------------------------------
query II
SELECT length(content) < strlen(content), contains(content, 'café')
FROM read_odt_blocks('test/fixtures/pandoc.odt') WHERE content LIKE 'Unicode:%';
----
true	true

# ---------------------------------------------------------------------------
# Canonical duck_block shape, so read_panduck_doc's flat branch passes it straight through.
# ---------------------------------------------------------------------------
query I
SELECT count(*) FROM read_odt_blocks('test/fixtures/pandoc.odt')
WHERE kind NOT IN ('block', 'inline', 'value') OR encoding <> 'text';
----
0

# POSITIVE COMPANION: the guard above is satisfied by an empty document.
query I
SELECT count(*) > 8 FROM read_odt_blocks('test/fixtures/pandoc.odt');
----
true

# ---------------------------------------------------------------------------
# The dispatcher is indistinguishable from the reader, both fixtures. Symmetric, because a
# one-directional EXCEPT would miss rows the dispatcher drops.
# ---------------------------------------------------------------------------
query I
SELECT (SELECT count(*) FROM ((SELECT * FROM read_panduck_doc('test/fixtures/pandoc.odt'))
                       EXCEPT (SELECT * FROM read_odt_blocks('test/fixtures/pandoc.odt'))))
     + (SELECT count(*) FROM ((SELECT * FROM read_odt_blocks('test/fixtures/pandoc.odt'))
                       EXCEPT (SELECT * FROM read_panduck_doc('test/fixtures/pandoc.odt'))));
----
0

query I
SELECT (SELECT count(*) FROM ((SELECT * FROM read_panduck_doc('test/fixtures/libreoffice.odt'))
                       EXCEPT (SELECT * FROM read_odt_blocks('test/fixtures/libreoffice.odt'))))
     + (SELECT count(*) FROM ((SELECT * FROM read_odt_blocks('test/fixtures/libreoffice.odt'))
                       EXCEPT (SELECT * FROM read_panduck_doc('test/fixtures/libreoffice.odt'))));
----
0

# ---------------------------------------------------------------------------
# Errors distinguish "not a ZIP" from "a ZIP that is not an ODT" -- ZipContainer, shared
# with the DOCX reader, names the member it expected.
# ---------------------------------------------------------------------------
statement error
SELECT * FROM read_odt_blocks('test/fixtures/pandoc_outlinelevel.rtf');
----
not a readable ZIP archive

statement error
SELECT * FROM read_odt_blocks('test/fixtures/pandoc_pstyle.docx');
----
has no content.xml

# ---------------------------------------------------------------------------
# DOCUMENT METADATA -> kind='value'. Same approved exception as the DOCX reader: pandoc
# returns an EMPTY meta for both ODT fixtures while meta.xml carries real fields, so this
# reader exceeds the reference and marks every field it emits with
# attributes['source_type'].
#
# BOTH FIXTURES CARRY meta:generator, which is how a document says what wrote it, and it
# is the field most likely to be wanted from an ODT -- the two values differ (LibreOffice
# vs Pandoc), so the pair also proves the reader is reading the file rather than a default.
query IIII
SELECT kind, attributes['key'], attributes['source_type'], content
FROM read_odt_blocks('test/fixtures/pandoc.odt')
WHERE element_order >= (SELECT min(element_order) FROM read_odt_blocks('test/fixtures/pandoc.odt') WHERE kind = 'value')
ORDER BY element_order;
----
value	date	dc:date	NULL
inline	NULL	NULL	2026-09-01T01:11:24Z
value	generator	meta:generator	NULL
inline	NULL	NULL	Pandoc/3.1.3

# dc:date WINS OVER meta:creation-date when both are present, and libreoffice.odt has
# both. They carry the same instant in every fixture measured, and two sources feeding one
# key is how the two drift apart -- so the Dublin Core spelling is preferred and
# meta:creation-date is a fallback rather than a peer. source_type is what makes that
# choice visible: a consumer can see WHICH element the date came from.
query II
SELECT attributes['key'], attributes['source_type']
FROM read_odt_blocks('test/fixtures/libreoffice.odt')
WHERE kind = 'value' ORDER BY element_order;
----
date	dc:date
generator	meta:generator

# ---------------------------------------------------------------------------
# ORDERED AND NESTED LISTS. See docx_reader.test for why this fixture exists: every
# binary-format fixture held one flat bullet list, so per-level orderedness resolution and
# the nesting logic were both unexercised.
#
# ODF makes the ordered question specifically easy to get wrong: a list style declares ALL
# TEN levels up front and routinely mixes bullet and number among them, so orderedness is a
# property of the LEVEL. A reader asking the style as a whole is right on a uniform document
# and wrong on this one.
query III
SELECT element_type, level, attributes['list_type'] FROM read_odt_blocks('test/fixtures/lists.odt')
WHERE element_type = 'list' ORDER BY element_order;
----
list	1	ordered
list	3	bullet
list	1	bullet

query III
SELECT element_type, level, content FROM read_odt_blocks('test/fixtures/lists.odt')
WHERE element_type = 'list_item' ORDER BY element_order;
----
list_item	2	first
list_item	2	second
list_item	4	nested bullet
list_item	4	nested two
list_item	2	third
list_item	2	plain bullet

# ---------------------------------------------------------------------------
# TABLES. A table:table is a sibling of text:p and was never collected, so every cell's
# text vanished -- content loss, not a structure gap.
#
# ODF marks header rows STRUCTURALLY, in their own table:table-header-rows element, rather
# than with an attribute on the row. A table without one has no header.
query III
SELECT element_type, encoding, content FROM read_odt_blocks('test/fixtures/rich.odt')
WHERE element_type = 'table';
----
table	json	{"headers":["Name","Value"],"rows":[["a","1"],["b","2"]]}

# ---------------------------------------------------------------------------
# IMAGES AND FOOTNOTES. ODF points straight at the file with xlink:href -- no relationship
# indirection, unlike OOXML -- so the href IS the src.
query III
SELECT kind, element_type, attributes['src'] FROM read_odt_blocks('test/fixtures/rich.odt')
WHERE element_type = 'image';
----
inline	image	Pictures/0.png

# text:note-citation is the RENDERED marker -- the number a reader sees -- and
# text:note-body is the note. Collecting the whole element puts the citation digit into the
# note's text.
query III
SELECT kind, element_type, content FROM read_odt_blocks('test/fixtures/rich.odt')
WHERE element_type = 'note';
----
inline	note	The footnote body.

# ---------------------------------------------------------------------------
# MALFORMED INPUT. A file that is not a ZIP at all fails with the reader's name in it.
statement error
SELECT count(*) FROM read_odt_blocks('test/fixtures/malformed/notzip.odt');
----
not a readable ZIP archive
