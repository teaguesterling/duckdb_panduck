# name: test/sql/epub_reader.test
# description: read_epub_blocks() over EPUB produced by two real writers plus one built by hand
# group: [sql]

#
# EPUB NEEDS NO HTML PARSER. The open question when this reader was scheduled was how much
# to delegate to the webbed extension, since EPUB content documents are "HTML". They are
# not: the specification requires XHTML, which is well-formed XML by definition, so the
# same pugixml that reads DOCX and ODT reads a book. An arbitrary .html file still needs
# webbed; an EPUB's content documents never do.
#
# THE TWO WRITERS DISAGREE ABOUT EVERYTHING. RTF and DOCX each offered two ways to mark a
# heading and ODT offered one. EPUB is the first format where one writer emits no
# semantics at all: pandoc writes <h1>, <ul>, <li>, <strong>; LibreOffice writes
# <p class="paraN"><span class="spanN"> and puts the meaning in a CSS file.

require panduck

# ---------------------------------------------------------------------------
# pandoc's EPUB is semantic XHTML, so the structure reads straight off the tags.
# ---------------------------------------------------------------------------
query II
SELECT content, attributes['heading_level'] AS lvl
FROM read_epub_blocks('test/fixtures/pandoc.epub')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	1
Heading Two	2

# EPUB is the first format panduck models structurally: XHTML says <ul><li> and
# <blockquote> outright, where RTF, DOCX and ODT only had paragraphs wearing hats.
#
# A TIGHT LIST ITEM OWNS A `plain`, NOT A PARAGRAPH -- duck_block spec 4.0. `plain` is a
# block-level text run with NO paragraph semantics: Pandoc's Plain constructor, which is
# exactly what <li>bullet one</li> is. <li><p>x</p></li> stays a paragraph. Before `plain`
# existed there was nowhere honest to put a bare run, so readers either hung the text on
# the list_item or invented a paragraph the source never wrote.
query II
SELECT element_type, content FROM read_epub_blocks('test/fixtures/pandoc.epub')
WHERE element_type IN ('list', 'list_item', 'blockquote', 'div', 'section') ORDER BY element_order;
----
section	NULL
section	NULL
list	NULL
list_item	bullet one
list_item	bullet two
blockquote	NULL

# ---------------------------------------------------------------------------
# THE DEPTHS ARE THE DOCUMENT'S OWN, not a flattening. pandoc nests its sections to mirror
# the heading hierarchy -- <section class="level1"> wrapping <section class="level2"> --
# so the list and the quote genuinely sit three deep, and reading the file confirms it
# rather than the reader inventing it:
#
#   section level1   -> section    1
#     h1             -> heading    2
#     p              -> paragraph  2
#     section level2 -> section    2
#       h2           -> heading    3
#       ul           -> list       3
#       blockquote   -> blockquote 3
#
# Asserting absolute depths rather than "one deeper than its parent" is deliberate: a
# relative check passes just as happily when EVERY level is wrong by the same amount.
query III
SELECT element_type, content, level FROM read_epub_blocks('test/fixtures/pandoc.epub')
WHERE kind = 'block' AND element_order <= 2 ORDER BY element_order;
----
section	NULL	1
heading	Heading One	2
paragraph	NULL	2

# ---------------------------------------------------------------------------
# CONTAINERS OWN THEIR CHILDREN BY LEVEL -- duck_block spec 2.0. A blockquote carries no
# content of its own; its text lives in a paragraph one level deeper, and the container
# ends at the first element back at its own level.
#
# Emitting both at NULL is not a cosmetic difference. `level` IS the containment
# mechanism, so a consumer has nothing else to read: duckdb_webbed's writer resolves a
# NULL level to depth 1, which puts the blockquote and its paragraph at the SAME depth,
# and its close-first rule then pops the quote before the paragraph renders. The quoted
# text lands OUTSIDE the blockquote as a sibling.
#
# That failure is invisible to inspection, which is why it survived: on a rendered page
# the quoted text still sits in the right place and reads correctly. Only the structure
# is wrong. Asserting the levels here is the only thing that catches it.
query III
SELECT element_type, content, level FROM read_epub_blocks('test/fixtures/pandoc.epub')
WHERE element_type = 'blockquote' OR content = 'A block quote.'
ORDER BY element_order;
----
blockquote	NULL	3
paragraph	A block quote.	4

# ---------------------------------------------------------------------------
# LIBREOFFICE'S EPUB EXPORT EMITS NO SEMANTIC MARKUP AT ALL. Not one <h1>, <ul> or
# <strong> in the whole book -- every block is <p class="paraN"> and every run is
# <span class="spanN">, with the meaning banished to CSS. pandoc reading this file finds
# no headings and no emphasis either.
# ---------------------------------------------------------------------------
query I
SELECT count(*) FROM read_epub_blocks('test/fixtures/libreoffice.epub')
WHERE element_type = 'heading';
----
0

# POSITIVE COMPANION: the zero above must mean "this writer marks no headings", not "the
# reader returned nothing". The words are all present, as paragraphs.
query I
SELECT count(*) FROM read_epub_blocks('test/fixtures/libreoffice.epub')
WHERE element_type = 'paragraph';
----
7

# ...and the run formatting IS recovered, from CSS, where pandoc recovers none.
# .span2 { font-weight: bold } states the formatting; it does not merely imply it.
query II
SELECT element_type, content FROM read_epub_blocks('test/fixtures/libreoffice.epub')
WHERE kind = 'inline' AND element_type <> 'text' ORDER BY element_order;
----
bold	Heading One
bold	bold
italic	italic
strikethrough	strike
bold	Heading Two

# WHERE THE LINE IS DRAWN, asserted rather than described. 'Heading One' comes back a BOLD
# PARAGRAPH and not a heading: .span0 says font-size: 16pt, and a font size is evidence
# for a heading rather than a statement of one. font-weight: bold is read for the opposite
# reason -- "bold" is the answer, not evidence for it.
query II
SELECT element_type, attributes['heading_level'] IS NULL
FROM read_epub_blocks('test/fixtures/libreoffice.epub')
WHERE content = 'Heading One';
----
bold	true

# ---------------------------------------------------------------------------
# THE SPINE IS THE READING ORDER, and no writer's output can test that: pandoc and
# LibreOffice both emit books whose ZIP member order happens to match their spine, so
# neither can tell "follows the spine" from "reads members in archive order".
# spine_order.epub stores chapter two FIRST and puts it second in the spine.
# ---------------------------------------------------------------------------
query II
SELECT content, attributes['heading_level'] FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE element_type = 'heading' ORDER BY element_order;
----
First Chapter	1
Second Chapter	1

# The same fixture's package document lives in its own directory, so every manifest href
# climbs out with ../ and one chapter's name carries a percent-encoded space. Finding the
# second chapter at all is the assertion. pandoc cannot read this book: it concatenates
# without normalising and fails with "No entry on path: OEBPS/pkg/../text/ch1.xhtml",
# which is why this fixture is panduck-only and not in the differential suite.
query I
SELECT count(*) FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE content = 'Read me second, stored me first.';
----
1

# ---------------------------------------------------------------------------
# Link and image attributes. NOTE THERE IS NO [1] HERE: map['key'] already yields the
# VARCHAR, and attributes['heading_level'][1] -- which three reader tests and the
# differential validator all used -- indexes the STRING and takes its first character. It
# passed everywhere because every heading level is one digit. This is the first
# multi-character attribute in the suite, and it is what exposed that.
# ---------------------------------------------------------------------------
query III
SELECT element_type, content, attributes['href'] FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE element_type = 'link';
----
link	cross reference	ch%202.xhtml#top

# src is resolved to an ARCHIVE MEMBER because a consumer extracting the image needs that
# and '../images/cover.png' is meaningless without knowing which chapter said it. href
# above is deliberately left as authored: a link may point outside the book, and carries a
# #fragment that resolution would drop.
query III
SELECT element_type, content, attributes['src'] FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE element_type = 'image';
----
image	a cover	OEBPS/images/cover.png

# ---------------------------------------------------------------------------
# CSS is read only as far as it NAMES formatting. font-weight: 700 is bold (the spec puts
# the boundary at 600); a descendant selector and an id selector are ignored, because
# being half-right about the cascade is worse than not reading it.
# ---------------------------------------------------------------------------
query II
SELECT element_type, content FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE content IN ('loud', 'quiet', 'struck', 'bold') ORDER BY element_order;
----
bold	loud
italic	quiet
strikethrough	struck
bold	bold

# ---------------------------------------------------------------------------
# CSS RULES ARE PER CONTENT DOCUMENT. Chapter two links a different stylesheet and USES a
# class only chapter one's sheet defines, so a shared rule map would report that run bold
# where it must come back plain text.
#
# The first version of this assertion used a class BOTH chapters define, expecting a leak
# to show as the wrong formatting -- and seeding chapter two with chapter one's rules did
# not turn it red, because chapter two's own rule overwrites the leaked one and masks it.
# Scoping is only observable through a name the second document uses and does NOT define.
# A negative that cannot distinguish the two cases is not a negative.
#
# The third row is a PARAGRAPH, not a plain inline run: a block whose runs carry no
# formatting flattens into content with no inline children at all, so a leak would change
# the row's element_type from paragraph to bold rather than merely its formatting.
query II
SELECT element_type, content FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE content IN ('loud', 'Read me second, stored me first.', 'Chapter one cannot reach me.')
ORDER BY element_order;
----
bold	loud
italic	Read me second, stored me first.
paragraph	Chapter one cannot reach me.

# ---------------------------------------------------------------------------
# <li>text</li> and <li><p>text</p></li> mean the same thing and are both legal, so the
# item's text is read wherever the writer put it.
#
# THEY MUST NOT CONVERGE, and an earlier version of this test asserted that they did.
# Normalising both to the paragraph form looked like an improvement -- same content, one
# shape -- but the two spellings are the TIGHT and LOOSE list forms and they render
# differently. Pandoc encodes the distinction as Plain versus Para inside the item, so
# collapsing them discards information the source carried.
#
# `plain` is where the tight run lives: a block-level text run carrying no paragraph
# semantics. The distinction is in the TYPE rather than an attribute because the gap was a
# constructor nothing represented, not a variation nothing annotated.
# ---------------------------------------------------------------------------
query II
SELECT element_type, content FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE element_order BETWEEN
  (SELECT min(element_order) FROM read_epub_blocks('test/fixtures/spine_order.epub') WHERE element_type = 'list_item')
  AND (SELECT max(element_order) FROM read_epub_blocks('test/fixtures/spine_order.epub') WHERE element_type = 'blockquote')
ORDER BY element_order;
----
list_item	tight item
list_item	NULL
paragraph	loose item
blockquote	NULL

# <pre> keeps its whitespace -- that is what a <pre> means -- where every other block
# folds runs of spaces.
query II
SELECT element_type, content FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE element_type = 'code';
----
code	  indented   code

# An empty <div> is layout scaffolding and is dropped; pandoc's own EPUB writer emits an
# empty <section class="titlepage"> in every book it makes. An <hr/> is kept, because
# writing one is an authorial act.
query I
SELECT count(*) FROM read_epub_blocks('test/fixtures/spine_order.epub') WHERE element_type = 'hr';
----
1

query I
SELECT count(*) FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE element_type = 'div' AND element_order > 20;
----
0

# ---------------------------------------------------------------------------
# Unicode survives the ZIP + XML path.
# ---------------------------------------------------------------------------
query II
SELECT length(content) < strlen(content), contains(content, 'café')
FROM read_epub_blocks('test/fixtures/pandoc.epub') WHERE content LIKE 'Unicode:%';
----
true	true

# ---------------------------------------------------------------------------
# Canonical duck_block shape, so read_panduck_doc's flat branch passes it straight through.
#
# `encoding` is 'text' for EVERYTHING EXCEPT `table`, which spec 5.0 makes the one
# element_type whose content is a JSON document. The exception is spelled out rather than
# the check being relaxed to "any declared encoding": a second element_type quietly
# acquiring a non-text encoding is exactly what this assertion should catch, and a
# permissive version would catch nothing.
# ---------------------------------------------------------------------------
query I
SELECT count(*) FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE kind NOT IN ('block', 'inline', 'value')
   OR (element_type = 'table' AND encoding <> 'json')
   OR (element_type <> 'table' AND encoding <> 'text');
----
0

# POSITIVE COMPANION: the guard above is satisfied by an empty document.
query I
SELECT count(*) > 25 FROM read_epub_blocks('test/fixtures/spine_order.epub');
----
true

# ---------------------------------------------------------------------------
# The dispatcher is indistinguishable from the reader, all three fixtures. Symmetric,
# because a one-directional EXCEPT would miss rows the dispatcher drops.
# ---------------------------------------------------------------------------
query I
SELECT (SELECT count(*) FROM ((SELECT * FROM read_panduck_doc('test/fixtures/pandoc.epub'))
                       EXCEPT (SELECT * FROM read_epub_blocks('test/fixtures/pandoc.epub'))))
     + (SELECT count(*) FROM ((SELECT * FROM read_epub_blocks('test/fixtures/pandoc.epub'))
                       EXCEPT (SELECT * FROM read_panduck_doc('test/fixtures/pandoc.epub'))));
----
0

query I
SELECT (SELECT count(*) FROM ((SELECT * FROM read_panduck_doc('test/fixtures/spine_order.epub'))
                       EXCEPT (SELECT * FROM read_epub_blocks('test/fixtures/spine_order.epub'))))
     + (SELECT count(*) FROM ((SELECT * FROM read_epub_blocks('test/fixtures/spine_order.epub'))
                       EXCEPT (SELECT * FROM read_panduck_doc('test/fixtures/spine_order.epub'))));
----
0

# ---------------------------------------------------------------------------
# Errors distinguish three failures: not a ZIP, a ZIP that is not an EPUB, and an EPUB
# whose container.xml points at a package document that is not there.
# META-INF/container.xml is the only path the format fixes, which is what makes its
# absence mean "a ZIP, but not a book".
# ---------------------------------------------------------------------------
statement error
SELECT * FROM read_epub_blocks('test/fixtures/pandoc_outlinelevel.rtf');
----
not a readable ZIP archive

statement error
SELECT * FROM read_epub_blocks('test/fixtures/pandoc_pstyle.docx');
----
has no META-INF/container.xml

# ---------------------------------------------------------------------------
# A LIST IS A CONTAINER AND SO IS EACH ITEM -- duck_block spec 2.0. <ul> becomes a `list`
# carrying attributes['list_type'], each <li> is a `list_item` that owns no content, and
# the item's words live in a `paragraph` one level deeper again.
#
# Before this, panduck emitted bare list_items carrying their text with NO list container
# at all: <ul> fell through the walker's unknown-element branch and simply recursed, so
# the grouping was lost and nothing recorded whether the list was bulleted or ordered. A
# consumer could not tell two adjacent lists from one, and duckdb_webbed's writer -- which
# renders containment from `level` -- had nothing to build a <ul> out of.
query IIII
SELECT element_type, content, level, attributes['list_type']
FROM read_epub_blocks('test/fixtures/pandoc.epub')
WHERE element_type IN ('list', 'list_item', 'plain') OR content LIKE 'bullet%'
ORDER BY element_order;
----
list	NULL	3	bullet
list_item	bullet one	4	NULL
list_item	bullet two	4	NULL

# ---------------------------------------------------------------------------
# ORDERED LISTS, AND BOTH SPELLINGS OF ORDEREDNESS. attributes['ordered'] is the CANONICAL
# name -- spec v1.0 documented it -- and 'list_type' is an alias that arrived later with
# duck_block_utils' Pandoc reader. For a while that reader emitted only list_type, so a
# consumer written against the published v1 spec read nothing at all from a Pandoc list.
# Both producers now emit both names, and so does panduck: prefer `ordered` when writing
# new code, tolerate either when reading.
#
# start/number_style/number_delim are emitted ALWAYS on an ordered list, including at their
# defaults, matching the stricter of the two upstream producers so there is one shape
# rather than two. `start` here is 3 rather than 1 precisely so a reader that ignored the
# attribute and hardcoded the default would still be caught.
#
# This fixture carries the only ordered list in the suite. Every <ol> in the two
# real-writer EPUBs sits in a nav or toc document, which is outside the spine and therefore
# never read -- so this whole code path was unexercised until the fixture gained one.
#
# The trailing definition list is the spec 5.0 <dl> shape, and it appears HERE rather than
# only in the deflist assertion below because this query is the one that says how many
# lists exist. A <dl> that stopped being a `list` would leave the row count here unchanged
# only if something else broke in a compensating way -- so this is the assertion that the
# definition list is a list AT ALL, separate from the one that checks its items.
query IIIIII
SELECT element_type, level, attributes['ordered'], attributes['list_type'],
       attributes['start'], attributes['number_style']
FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE element_type = 'list' ORDER BY element_order;
----
list	2	false	bullet	NULL	NULL
list	2	true	ordered	3	Decimal
list	2	false	bullet	NULL	NULL
list	4	false	bullet	NULL	NULL
list	2	false	bullet	NULL	NULL
list	4	false	bullet	NULL	NULL
list	2	false	definition	NULL	NULL

# ---------------------------------------------------------------------------
# A DEFINITION LIST IS NOT A BULLET LIST, and the reader must not claim it is. <dl> briefly
# shared the <ul>/<ol> branch here, which emitted it as a `list` carrying
# list_type='bullet' -- a straight falsehood about the document, and invisible because no
# fixture contained a <dl> at all.
#
# It then stayed on the TRANSPARENT path, deliberately, on the grounds that duck_block had
# no settled shape for definition lists and guessing a parent type is how a format grows a
# shape nobody can consume. That was correct when written and is now STALE: spec 5.0
# settled it. `deflist` is deprecated -- duck_blocks_lint warns on it -- and a definition
# list is a LIST KIND:
#
#     <dl>  ->  list       attributes['list_type'] = 'definition'
#     <dt>  ->  list_item  attributes['role'] = 'term'
#     <dd>  ->  list_item  attributes['role'] = 'definition'
#
# So the deferral is discharged, not abandoned. Note the LEVELS move: while <dl> was
# transparent its <dt>/<dd> sat at the dl's own depth; now that the list is a real
# container they are one deeper. That shift is the assertion that the container actually
# exists, rather than the items merely being relabelled.
#
# The `plain` rule now DOES reach them, because dt/dd being list_items is no longer a
# placeholder standing in for a gap -- 5.0 says a definition list IS a list, so its items
# are list_items in fact and the content rule applies to them like any other.
query IIIII
SELECT element_type, content, level, attributes['list_type'], attributes['role']
FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE content IN ('term', 'definition')
   OR (element_type = 'list' AND attributes['list_type'] IN ('ordered', 'definition'))
ORDER BY element_order;
----
list	NULL	2	ordered	NULL
list	NULL	2	definition	NULL
list_item	term	3	NULL	term
list_item	definition	3	NULL	definition

# ---------------------------------------------------------------------------
# <section> IS A `section`, NOT A `div`. duck_block has both and the distinction is a
# statement about the document: HTML's own spec calls div "an element of last resort",
# while `section` means the author marked semantic structure. Which kind lives in
# attributes['role'] -- section, article, aside, nav, header, footer, main -- following the
# heading+heading_level convention rather than minting a type per variant.
#
# Mapping <section> onto div asserted that the document had NO semantic sectioning when it
# demonstrably did. That is the same defect class as <dl> in the <ul> branch: a placeholder
# mapping used as though it were a real one, and invisible for the same reason -- the
# output was structurally well-formed and merely untrue.
query III
SELECT element_type, attributes['role'], level
FROM read_epub_blocks('test/fixtures/pandoc.epub')
WHERE element_type IN ('div', 'section') ORDER BY element_order;
----
section	section	1
section	section	2

# ---------------------------------------------------------------------------
# A TABLE'S TEXT SURVIVES EVEN THOUGH ITS STRUCTURE CANNOT. duck_block has no structural
# table -- `table` still carries an opaque JSON tuple, and table_row/table_cell do not
# exist -- so panduck cannot represent the grid. It can still refuse to throw the words
# away.
#
# <table> used to sit in the SKIPPED set beside <script> and <style>, so every cell's text
# was discarded outright. That contradicted this reader's own rule, written a few hundred
# lines up: losing structure is a gap, losing text is a bug. It was shipping the bug in
# order to avoid a gap it had anyway.
#
# It was then fixed halfway: cells came through as bare `plain` runs -- honestly wrong
# about shape, honestly right about content -- with the deferral stated as "when a
# structural table lands upstream this becomes a real mapping". Spec 5.0 landed it, and
# this is that mapping. Third deferral in this codebase discharged on its own written
# condition; nothing re-reads a held decision, so all three were found by working nearby.
#
#     table  content = {"headers": [...], "rows": [[...]]}  encoding = 'json'
#
# `table` is the ONLY element_type whose content is JSON. The cells are no longer separate
# rows, so the `plain` runs this used to assert are gone -- asserted below, because a
# mapping that emitted BOTH would double every cell's text into search results.
query IIII
SELECT element_type, level, encoding, content
FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE element_type = 'table' ORDER BY element_order;
----
table	2	json	{"headers":["Head A","Head B"],"rows":[["cell one","cell two"],["r2c1","r2c2"]]}
table	2	json	{"headers":[],"rows":[["bare one","bare two"]]}

# THE HEADERLESS TABLE IS THE SECOND ROW ABOVE, and it is a distinct case rather than a
# duplicate: `headers` is an empty array, not absent and not a first data row promoted to a
# header. A reader keyed on <thead> alone and one keyed on a leading all-<th> row behave
# identically on the headed table and differently here.

# CELL TEXT APPEARS EXACTLY ONCE. Before 5.0 these were `plain` rows; they are inside the
# table's JSON now. Emitting both shapes would put every cell's words in the document twice
# -- which is the defect the pre-5.0 raw Pandoc tuple caused in reverse, where cell text was
# unsearchable while AlignDefault matched everything.
query I
SELECT count(*) FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE content IN ('cell one', 'cell two', 'r2c1', 'r2c2', 'bare one', 'bare two');
----
0

# ---------------------------------------------------------------------------
# THE ROLE VOCABULARY IS HTML5'S SECTIONING SET, exactly and on purpose: section, article,
# aside, nav, header, footer, main. So every one of them is a `section` carrying its own
# role, rather than six elements silently contributing nothing.
#
# They WERE transparent -- emitting no block at all -- which is worse than the
# <section>-as-div bug fixed alongside it. A wrong-but-visible element can be corrected by
# a consumer or caught by a lint; an element that emits nothing cannot be distinguished
# from a document that never contained one. The information is not wrong, it is gone.
#
# Worth recording that the names lining up with HTML5 is evidence worth nothing on its own
# -- it is the reason this was asked upstream rather than inferred -- and it happens to be
# correct here only because the spec deliberately adopted that set.
# The two list_item rows are NOT strays. This query asks for everything carrying a role,
# and since spec 5.0 `role` has two users here: the seven sectioning kinds, and the two
# halves of a definition list. That is the vocabulary's own design -- one type plus a role
# rather than a type per variant -- so the query is left broad deliberately. Narrowing it
# to sections would hide the next producer that starts using role, which is exactly what
# this assertion is for.
query III
SELECT element_type, attributes['role'], content
FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE attributes['role'] IS NOT NULL OR content IN ('art','side','navi','head','foot','mainly')
ORDER BY element_order;
----
section	section	NULL
list_item	term	term
list_item	definition	definition
section	article	NULL
paragraph	NULL	art
section	aside	NULL
paragraph	NULL	side
section	nav	NULL
paragraph	NULL	navi
section	header	NULL
paragraph	NULL	head
section	footer	NULL
paragraph	NULL	foot
section	main	NULL
paragraph	NULL	mainly

# ---------------------------------------------------------------------------
# A NESTED LIST IS A CHILD OF ITS ITEM, sitting two levels below the outer list rather than
# one. That off-by-one is not academic: duck_block_utils' exporter dropped every nested
# list because its branch required list_level+1, and panduck could not have found it --
# no fixture contained a nested list at all, so the reader never produced the shape.
#
#   list        3   the outer list
#     list_item 4   has block children, so it is a container
#       ...     5   its own bare text
#       list    5   the nested list, a CHILD OF THE ITEM
#         list_item 6
#           plain   7
#
# THE ITEM'S OWN RUN DISCRIMINATES TIGHT FROM LOOSE, and this is the assertion that
# matters. An item can hold block children and STILL BE TIGHT -- pandoc emits
# BulletList > Plain > Str for `- outer` with an indented sublist, not Para -- so
# "has block children, therefore loose" is false at its first step. Tight/loose is a
# property of the RUN, not of the item's shape.
#
# Asserting only one spelling would pass against the wrong rule: a reader keyed on "has
# block children" makes both forms identical, and either row alone looks correct. The two
# DIFFERING is what discriminates.
#
# Note what each row shows. `outer` stays `plain` because its run has a BLOCK SIBLING --
# the nested list -- so it genuinely has nowhere else to live. `inner` is a lone run in a
# tight item, so it becomes that item's CONTENT and no child is emitted. Both follow from
# one rule applied to different neighbourhoods, which is why the pair is the assertion
# rather than either half.
query III
SELECT element_type, content, level FROM read_epub_blocks('test/fixtures/spine_order.epub')
WHERE content IN ('outer', 'inner', 'louter', 'linner')
ORDER BY element_order;
----
plain	outer	4
list_item	inner	5
paragraph	louter	4
list_item	linner	5

