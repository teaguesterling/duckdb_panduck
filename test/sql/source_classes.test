# name: test/sql/source_classes.test
# description: a class the source document gave a block lands in attributes['class'] (#182)
# group: [sql]

require panduck

# ---------------------------------------------------------------------------
# WHY. duck_block has one key for "a class the document gave this block":
# attributes['class'], space-separated as in HTML. The DCS transform language that
# duckeye uses selects `.block-text` the same way on a .docx, a .md and a web page,
# so each reader must put its format's own class there (#182).
#
# THE SLUG. A style NAME, not its id ("Block Text", not "BlockText"), lowercased;
# every run of characters that is not a letter, a digit, a non-ASCII byte or `_`
# becomes one `-`; leading and trailing `-` are dropped. A name that slugs to
# nothing gives no class. Ids keep pandoc's rule (slugify.hpp HeadingSlug); this is
# a separate rule, because a class has no `section` fallback and no letter-first
# requirement.
#
# ONLY WHAT THE DOCUMENT SAID. A paragraph with no style gets no class, and a
# container panduck builds (list, blockquote) gets none: the document did not
# style it.
# ---------------------------------------------------------------------------

# --- DOCX: the w:pStyle name, resolved through word/styles.xml -----------------

query II
SELECT content, attributes['class'] FROM read_docx_blocks('test/fixtures/constructs.docx')
WHERE element_type = 'heading' ORDER BY element_order
----
Heading One	heading-1
Heading Two	heading-2
Heading Three	heading-3

# FirstParagraph is the style id; the name is "First Paragraph".
query I
SELECT attributes['class'] FROM read_docx_blocks('test/fixtures/constructs.docx') WHERE element_order = 1
----
first-paragraph

query II
SELECT content, attributes['class'] FROM read_docx_blocks('test/fixtures/constructs.docx')
WHERE content IN ('first', 'Term', 'The definition of the term.', 'A quote.') ORDER BY element_order
----
first	compact
Term	definition-term
The definition of the term.	definition
A quote.	block-text

query I
SELECT attributes['class'] FROM read_docx_blocks('test/fixtures/constructs.docx') WHERE element_type = 'code' AND kind = 'block'
----
source-code

# LibreOffice styles every paragraph "Normal", which is still a class it gave.
query I
SELECT attributes['class'] FROM read_docx_blocks('test/fixtures/libreoffice_outlinelvl.docx')
WHERE content = 'A block quote.'
----
normal

# Not styled by the document: the table, and the containers panduck builds.
query I
SELECT count(*) FROM read_docx_blocks('test/fixtures/constructs.docx')
WHERE element_type IN ('table', 'list', 'blockquote') AND attributes['class'] IS NOT NULL
----
0

# Inline rows are not paragraphs and take no paragraph style.
query I
SELECT count(*) FROM read_docx_blocks('test/fixtures/constructs.docx')
WHERE kind = 'inline' AND attributes['class'] IS NOT NULL
----
0

# --- ODT: the paragraph style's NAME -----------------------------------------
# A paragraph usually names an AUTOMATIC style (P5, P8) that content.xml makes
# per document; its parent-style-name is the style the author chose. The name
# is styles.xml's style:display-name ("Text body") where it has one, else the
# style name with ODF's _XX_ escapes decoded ("Quotations").

query II
SELECT content, attributes['class'] FROM read_odt_blocks('test/fixtures/constructs.odt')
WHERE element_type = 'heading' ORDER BY element_order
----
Heading One	heading-1
Heading Two	heading-2
Heading Three	heading-3

query II
SELECT content, attributes['class'] FROM read_odt_blocks('test/fixtures/constructs.odt')
WHERE content IN ('first', 'Term', 'The definition of the term.', 'A quote.', 'A caption') ORDER BY element_order
----
first	text-body
Term	definition-term-tight
The definition of the term.	definition-definition-tight
A quote.	quotations
A caption	figurecaption

query I
SELECT attributes['class'] FROM read_odt_blocks('test/fixtures/constructs.odt') WHERE element_type = 'code' AND kind = 'block'
----
preformatted-text

query II
SELECT content, attributes['class'] FROM read_odt_blocks('test/fixtures/libreoffice.odt')
WHERE content IN ('bullet one', 'A block quote.') OR content LIKE 'Unicode%' ORDER BY element_order
----
bullet one	compact
A block quote.	block-text
Unicode: café — em-dash, and a tab.	first-paragraph

query I
SELECT count(*) FROM read_odt_blocks('test/fixtures/constructs.odt')
WHERE (element_type IN ('table', 'list', 'blockquote') OR kind = 'inline') AND attributes['class'] IS NOT NULL
----
0

# --- EPUB: XHTML class tokens, then EPUB 3 epub:type tokens --------------------
# Both are already class-shaped, so they are kept VERBATIM, not slugged, joined by
# one space, class first. The containers here are the document's own elements
# (<section>, <blockquote>, <aside>), so unlike DOCX/ODT they DO carry a class.
# epub_types.epub is built by test/fixtures/make_epub_types_epub.py.

query III
SELECT element_type, coalesce(content, '-'), attributes['class'] FROM read_epub_blocks('test/fixtures/epub_types.epub')
WHERE kind = 'block' ORDER BY element_order
----
section	-	level1 chapter
heading	The First Chapter	chapter-title
blockquote	-	epigraph
paragraph	An opening line.	NULL
paragraph	The lead paragraph.	lead first
paragraph	A plain paragraph.	NULL
section	-	footnote
paragraph	The note text.	NULL

# A real writer: pandoc wraps each heading's section in class="level1" / "level2".
query II
SELECT element_order, attributes['class'] FROM read_epub_blocks('test/fixtures/pandoc.epub')
WHERE element_type = 'section' ORDER BY element_order
----
0	level1
10	level2

# LibreOffice gives every paragraph a generated class (para0, para1, ...).
query I
SELECT count(*) FROM read_epub_blocks('test/fixtures/libreoffice.epub')
WHERE element_type = 'paragraph' AND NOT regexp_full_match(coalesce(attributes['class'], ''), 'para[0-9]+')
----
0

# --- LaTeX: the environment name on the block an environment makes --------------
# Slugged by ClassSlug, which drops a star: figure* is `figure`. Only environments
# that make a block get one; a TRANSPARENT environment (center, abstract, an
# unknown one such as theorem) makes none, so there is nothing to carry it.

query III
SELECT element_order, element_type, attributes['class'] FROM read_latex_blocks_string(E'\\begin{itemize}\\item a\\end{itemize}\n\n\\begin{quotation}Q.\\end{quotation}\n\n\\begin{verbatim}\nx = 1\n\\end{verbatim}\n\n\\begin{tabular}{ll}a & b\\end{tabular}\n\n\\begin{figure*}\\caption{Cap}\\end{figure*}\n\n\\begin{description}\\item[T] D\\end{description}')
WHERE kind = 'block' AND element_type IN ('list', 'blockquote', 'code', 'table', 'figure') ORDER BY element_order
----
0	list	itemize
2	blockquote	quotation
4	code	verbatim
5	table	tabular
6	figure	figure
9	list	description

# The blocks inside an environment are not the environment.
query I
SELECT count(*) FROM read_latex_blocks_string(E'\\begin{itemize}\\item a\\end{itemize}\n\n\\begin{quote}Q.\\end{quote}')
WHERE element_type IN ('list_item', 'paragraph') AND attributes['class'] IS NOT NULL
----
0

# --- LaTeX: an environment with no meaning of its own is a div (#182) ----------
# pandoc 3.1.3 makes every such environment a Div with class = its name: a
# \newtheorem one, a lemma with no \newtheorem, proof, center, a custom myenv.
# Only `document` (the body) and `abstract` (pandoc's metadata) are not divs. The
# environment's paragraphs nest one level inside it.

query IIII
SELECT element_order, element_type, level, coalesce(attributes['class'], content) FROM read_latex_blocks_string(E'\\documentclass{article}\n\\newtheorem{theorem}{Theorem}\n\\begin{document}\n\\begin{theorem}Every T.\\end{theorem}\n\\begin{lemma}L.\\end{lemma}\n\\begin{proof}P.\\end{proof}\n\\begin{center}C.\\end{center}\n\\begin{myenv}M.\\end{myenv}\n\\end{document}')
WHERE kind = 'block' ORDER BY element_order
----
0	div	1	theorem
1	paragraph	2	Every T.
2	div	1	lemma
3	paragraph	2	L.
4	div	1	proof
5	paragraph	2	P.
6	div	1	center
7	paragraph	2	C.
8	div	1	myenv
9	paragraph	2	M.

# `document` is the body, not a div; `table` is a float around its tabular, which
# pandoc reads as the Table itself.
query III
SELECT element_type, level, attributes['class'] FROM read_latex_blocks_string(E'\\begin{document}\\begin{table}\\begin{tabular}{ll}a & b\\end{tabular}\\end{table}\\end{document}')
WHERE kind = 'block' ORDER BY element_order
----
table	1	tabular

# An empty environment is withdrawn, as every empty container is.
query I
SELECT count(*) FROM read_latex_blocks_string(E'\\begin{myenv}\\end{myenv}')
----
0
