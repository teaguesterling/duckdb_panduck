# name: test/sql/heading_ids.test
# description: org, latex, docx and odt headings carry pandoc's identifier as attributes['id'] (#85)
# group: [sql]

require panduck

# ---------------------------------------------------------------------------
# WHY AN ID AT ALL. doc_section matches `content = section OR attributes['id'] = section`,
# and webbed's renderer writes `<h1 id=...>` whenever the block carries one. rst, textile
# and mediawiki already emitted the id; these four did not, so the same heading was
# findable by anchor in one format and not in another, and doc_render html lost the anchor
# that pandoc's HTML has.
#
# EVERY EXPECTED VALUE BELOW WAS MEASURED against pandoc 3.1.3 (`pandoc -t json`, the
# Header's Attr id), not derived from slugify.hpp. The rule is what they verify.
#
# DUPLICATES ARE OUT OF SCOPE. pandoc writes `a` then `a-1`; panduck writes `a` twice in
# every reader, and Teague ruled on 2026-11-11 that the suffix is a separate change.
# ---------------------------------------------------------------------------

# ---- org: the slug, and an explicit CUSTOM_ID ------------------------------

query II
SELECT content, attributes['id'] FROM read_org_blocks('test/fixtures/pandoc.org')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	heading-one
Heading Two	heading-two

# The slug is taken from the FLATTENED title, so markup contributes nothing.
query I
SELECT attributes['id'] FROM read_org_blocks_string(E'* *Bold* Title\n') WHERE element_type = 'heading';
----
bold-title

# The AUTHOR'S id wins over the slug: a :CUSTOM_ID: in the drawer directly under the
# heading. pandoc: ['my-anchor'].
query I
SELECT attributes['id'] FROM read_org_blocks_string(
    E'* Heading\n:PROPERTIES:\n:CUSTOM_ID: my-anchor\n:END:\nBody\n') WHERE element_type = 'heading';
----
my-anchor

# Surrounding space is not part of the id. pandoc: ['spaced'].
query I
SELECT attributes['id'] FROM read_org_blocks_string(
    E'* Heading\n:PROPERTIES:\n:CUSTOM_ID:  spaced  \n:END:\n') WHERE element_type = 'heading';
----
spaced

# A drawer AFTER body text belongs to no heading. pandoc: ['heading'].
query I
SELECT attributes['id'] FROM read_org_blocks_string(
    E'* Heading\nBody\n:PROPERTIES:\n:CUSTOM_ID: late\n:END:\n') WHERE element_type = 'heading';
----
heading

# ---- latex: the slug, and an explicit \label ------------------------------

# pandoc's own LaTeX: \hypertarget{heading-one}{\section{Heading One}\label{heading-one}}.
query II
SELECT content, attributes['id'] FROM read_latex_blocks('test/fixtures/pandoc.tex')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	heading-one
Heading Two	heading-two

# A person's LaTeX: \section{Heading One} then \label{sec:one} on the next line, and a
# \subsection with no label. pandoc: ['sec:one', 'heading-two'].
query II
SELECT content, attributes['id'] FROM read_latex_blocks('test/fixtures/handwritten.tex')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	sec:one
Heading Two	heading-two

query I
SELECT attributes['id'] FROM read_latex_blocks_string(E'\\section{\\textbf{Bold} Title}\n')
WHERE element_type = 'heading';
----
bold-title

# The leading run up to the first letter is skipped, and punctuation is dropped.
query I
SELECT attributes['id'] FROM read_latex_blocks_string(E'\\section{2019 Annual Report!}\n')
WHERE element_type = 'heading';
----
annual-report

query I
SELECT attributes['id'] FROM read_latex_blocks_string(E'\\section*{Starred}\n')
WHERE element_type = 'heading';
----
starred

# A \label inside the following PARAGRAPH labels the paragraph's position, not the
# heading. pandoc: ['lab'].
query I
SELECT attributes['id'] FROM read_latex_blocks_string(E'\\section{Lab}\nText \\label{inpara}.\n')
WHERE element_type = 'heading';
----
lab

# The FIRST of two labels wins. pandoc: ['a'].
query I
SELECT attributes['id'] FROM read_latex_blocks_string(E'\\section{Lab}\\label{a}\\label{b}\n')
WHERE element_type = 'heading';
----
a

# ---- docx and odt: the slug -----------------------------------------------

query II
SELECT content, attributes['id'] FROM read_docx_blocks('test/fixtures/constructs.docx')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	heading-one
Heading Two	heading-two
Heading Three	heading-three

query II
SELECT content, attributes['id'] FROM read_docx_blocks('test/fixtures/rich.docx')
WHERE element_type = 'heading' ORDER BY element_order;
----
Rich Document	rich-document

query II
SELECT content, attributes['id'] FROM read_odt_blocks('test/fixtures/constructs.odt')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	heading-one
Heading Two	heading-two
Heading Three	heading-three

query II
SELECT content, attributes['id'] FROM read_odt_blocks('test/fixtures/libreoffice.odt')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	heading-one
Heading Two	heading-two

# ---- RTF and EPUB: pandoc gives no id; panduck gives pandoc's slug (#182) ----
# pandoc 3.1.3 reads these headings with an empty id. panduck may be MORE faithful
# than pandoc, and Teague ruled 2026-11-13 that every heading gets an id by pandoc's
# rule, so a .rtf, an .epub and a .md agree on `#heading-one`.

query II
SELECT content, attributes['id'] FROM read_rtf_blocks('test/fixtures/pandoc_outlinelevel.rtf')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	heading-one
Heading Two	heading-two

query II
SELECT content, attributes['id'] FROM read_epub_blocks('test/fixtures/pandoc.epub')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	heading-one
Heading Two	heading-two

# An EPUB heading's own id attribute is the author's anchor, and it wins.
query II
SELECT content, attributes['id'] FROM read_epub_blocks('test/fixtures/epub_types.epub')
WHERE element_type = 'heading';
----
The First Chapter	first-ch

# ---- BEGIN shared slug cases (generated by scripts/sync_slug_cases.py) ----
# pandoc's identifier rule, character by character. Teague ruled on 2026-11-14 that ids
# follow pandoc's auto_identifiers rule in every reader and in markdown, webbed and dmb,
# and those four repos check this ONE list: test/fixtures/slug_pandoc_cases.txt, copied
# from duckdb_markdown's test/data/. 41 headings, each id measured with pandoc
# 3.1.3. One function (slugify.hpp HeadingSlug) serves every panduck reader, so the org
# string reader stands for all of them.

# The literals below ARE the shared file, in both directions. Re-run the script after
# copying a new fixture.
query I
SELECT count(*) FROM (
  SELECT title, id FROM read_csv('test/fixtures/slug_pandoc_cases.txt', delim = chr(1), header = false,
                                 quote = '', escape = '', columns = {'title': 'VARCHAR', 'id': 'VARCHAR'},
                                 strict_mode = false)
  EXCEPT
  SELECT * FROM (VALUES
    ('Zoë''s notes', 'zoës-notes'),
    ('Café', 'café'),
    ('  Hello,  World -- 2026! ', 'hello-world----2026'),
    ('snake_case Field guide', 'snake_case-field-guide'),
    ('1. Introduction', 'introduction'),
    ('ÉCOLE Ünd', 'école-ünd'),
    ('a -- b', 'a----b'),
    ('!!!', 'section'),
    ('日本語の見出し', '日本語の見出し'),
    ('v1.2 release', 'v1.2-release'),
    ('Field guide', 'field-guide'),
    ('Ünïcödé — dash', 'ünïcödé-dash'),
    ('tab	separated', 'tab-separated'),
    ('x²', 'x²'),
    ('İstanbul', 'istanbul'),
    ('naïve café', 'naïve-café'),
    ('1. Café, naïve!', 'café-naïve'),
    ('Notes', 'notes'),
    ('Ελληνικά κείμενα', 'ελληνικά-κείμενα'),
    ('Русский заголовок', 'русский-заголовок'),
    ('emoji 🦆 duck', 'emoji-duck'),
    ('under_score.and.dots', 'under_score.and.dots'),
    ('-- leading dashes', 'leading-dashes'),
    ('CamelCase_Word', 'camelcase_word'),
    ('3.14 is pi', 'is-pi'),
    ('Ⅻ roman twelve', 'roman-twelve'),
    ('A — B', 'a-b'),
    ('Emoji 🦆 duck', 'emoji-duck'),
    ('ΑΘΗΝΑ Πόλη', 'αθηνα-πόλη'),
    ('МОСКВА Город', 'москва-город'),
    ('Straße ẞIG', 'straße-ßig'),
    ('Ǆemal', 'ǆemal'),
    ('Ⅻ Roman', 'roman'),
    ('Ｆｕｌｌ', 'ｆｕｌｌ'),
    ('日本語　テキスト', '日本語-テキスト'),
    ('١٢٣ Arabic', 'arabic'),
    ('« Quoted »', 'quoted'),
    ('日本', '日本'),
    ('Version 1.2 notes', 'version-1.2-notes'),
    ('a.b.c', 'a.b.c'),
    ('end.', 'end.')) v(title, id)
) UNION ALL SELECT count(*) FROM (
  SELECT * FROM (VALUES
    ('Zoë''s notes', 'zoës-notes'),
    ('Café', 'café'),
    ('  Hello,  World -- 2026! ', 'hello-world----2026'),
    ('snake_case Field guide', 'snake_case-field-guide'),
    ('1. Introduction', 'introduction'),
    ('ÉCOLE Ünd', 'école-ünd'),
    ('a -- b', 'a----b'),
    ('!!!', 'section'),
    ('日本語の見出し', '日本語の見出し'),
    ('v1.2 release', 'v1.2-release'),
    ('Field guide', 'field-guide'),
    ('Ünïcödé — dash', 'ünïcödé-dash'),
    ('tab	separated', 'tab-separated'),
    ('x²', 'x²'),
    ('İstanbul', 'istanbul'),
    ('naïve café', 'naïve-café'),
    ('1. Café, naïve!', 'café-naïve'),
    ('Notes', 'notes'),
    ('Ελληνικά κείμενα', 'ελληνικά-κείμενα'),
    ('Русский заголовок', 'русский-заголовок'),
    ('emoji 🦆 duck', 'emoji-duck'),
    ('under_score.and.dots', 'under_score.and.dots'),
    ('-- leading dashes', 'leading-dashes'),
    ('CamelCase_Word', 'camelcase_word'),
    ('3.14 is pi', 'is-pi'),
    ('Ⅻ roman twelve', 'roman-twelve'),
    ('A — B', 'a-b'),
    ('Emoji 🦆 duck', 'emoji-duck'),
    ('ΑΘΗΝΑ Πόλη', 'αθηνα-πόλη'),
    ('МОСКВА Город', 'москва-город'),
    ('Straße ẞIG', 'straße-ßig'),
    ('Ǆemal', 'ǆemal'),
    ('Ⅻ Roman', 'roman'),
    ('Ｆｕｌｌ', 'ｆｕｌｌ'),
    ('日本語　テキスト', '日本語-テキスト'),
    ('١٢٣ Arabic', 'arabic'),
    ('« Quoted »', 'quoted'),
    ('日本', '日本'),
    ('Version 1.2 notes', 'version-1.2-notes'),
    ('a.b.c', 'a.b.c'),
    ('end.', 'end.')) v(title, id)
  EXCEPT
  SELECT title, id FROM read_csv('test/fixtures/slug_pandoc_cases.txt', delim = chr(1), header = false,
                                 quote = '', escape = '', columns = {'title': 'VARCHAR', 'id': 'VARCHAR'},
                                 strict_mode = false)
);
----
0
0

query I
SELECT attributes['id'] FROM read_org_blocks_string(E'* Zoë''s notes\n* Café\n*   Hello,  World -- 2026! \n* snake_case Field guide\n* 1. Introduction\n* ÉCOLE Ünd\n* a -- b\n* !!!\n* 日本語の見出し\n* v1.2 release\n* Field guide\n* Ünïcödé — dash\n* tab	separated\n* x²\n* İstanbul\n* naïve café\n* 1. Café, naïve!\n* Notes\n* Ελληνικά κείμενα\n* Русский заголовок\n* emoji 🦆 duck\n* under_score.and.dots\n* -- leading dashes\n* CamelCase_Word\n* 3.14 is pi\n* Ⅻ roman twelve\n* A — B\n* Emoji 🦆 duck\n* ΑΘΗΝΑ Πόλη\n* МОСКВА Город\n* Straße ẞIG\n* Ǆemal\n* Ⅻ Roman\n* Ｆｕｌｌ\n* 日本語　テキスト\n* ١٢٣ Arabic\n* « Quoted »\n* 日本\n* Version 1.2 notes\n* a.b.c\n* end.')
WHERE element_type = 'heading' ORDER BY element_order;
----
zoës-notes
café
hello-world----2026
snake_case-field-guide
introduction
école-ünd
a----b
section
日本語の見出し
v1.2-release
field-guide
ünïcödé-dash
tab-separated
x²
istanbul
naïve-café
café-naïve
notes
ελληνικά-κείμενα
русский-заголовок
emoji-duck
under_score.and.dots
leading-dashes
camelcase_word
is-pi
roman-twelve
a-b
emoji-duck
αθηνα-πόλη
москва-город
straße-ßig
ǆemal
roman
ｆｕｌｌ
日本語-テキスト
arabic
quoted
日本
version-1.2-notes
a.b.c
end.

# ---- END shared slug cases ----

# ---- the consumer: doc_section finds a heading by its anchor ---------------

query I
SELECT count(*) > 0 FROM doc_section('test/fixtures/constructs.docx', 'heading-two');
----
true
