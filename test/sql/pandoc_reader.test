# name: test/sql/pandoc_reader.test
# description: read_pandoc_blocks() -- the Pandoc AST converter, now panduck's
# group: [sql]

require panduck

# ---------------------------------------------------------------------------
# THE POINT OF THIS READER: `json` is pandoc's own AST, so this makes all 42 of pandoc's
# input formats reachable with no per-format code, for anyone who has pandoc installed.
# It is not an eighth format alongside the seven -- it is the thing that makes the format
# list finite.
#
# A TABLE FUNCTION, like every other panduck reader, so a filter pushes down into it. The
# upstream surface is a SCALAR returning LIST(duck_block), which plants a blocking
# aggregate no predicate can pass -- fine for a README, not for a 400-page document.
query III
SELECT element_type, level, content FROM read_pandoc_blocks_string(
  '{"pandoc-api-version":[1,23,1],"meta":{},"blocks":[{"t":"Para","c":[{"t":"Str","c":"Hello"}]}]}')
ORDER BY element_order;
----
paragraph	1	Hello

# NOTE the shape above: a lone `Str` becomes the PARAGRAPH'S OWN CONTENT, not a `text`
# child. That is spec 6.0's content rule -- content is populated iff the container's only
# child is a plain text run -- and the converter applies it via
# CollapseLonePlainIntoParent, which travelled with it. The rule is SIBLING-DEPENDENT, so
# a converter walking Pandoc's tree cannot know at the run whether it applies; panduck's
# native readers enforce it at emission instead, where they do know.

# THE NAMES ARE PANDUCK'S OWN and deliberately do not match duck_block_utils'
# pandoc_ast_to_blocks / read_pandoc_ast.
#
# A NAME IS OWNED BY EXACTLY ONE EXTENSION IN THIS FAMILY. Measured: when two loaded
# extensions register the same name, BOTH registrations survive as ambiguous overloads and
# every call then fails at BIND TIME with "Could not choose a best candidate function" --
# naming a construct the caller never wrote. It does not degrade, it breaks. So for the
# window in which both copies exist, the two surfaces must not overlap.
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name IN ('pandoc_ast_to_blocks', 'read_pandoc_ast', 'duck_blocks_to_pandoc_ast');
----
0

# ---------------------------------------------------------------------------
# THE CONVERTER AND THE NATIVE READER MUST AGREE. Reading one document two ways is the
# only check that can catch a conversion which is consistently wrong -- round-trip
# stability cannot, because a stable wrong answer round-trips perfectly.
#
# handwritten.org and handwritten.org.pandoc.json are THE SAME DOCUMENT: the second is
# `pandoc -f org -t json` of the first. EVERY block's text must match, `code` included.
query I
SELECT count(*) FROM (
  (SELECT content FROM read_org_blocks('test/fixtures/handwritten.org')
   WHERE kind = 'block' AND coalesce(content, '') <> '')
  EXCEPT
  (SELECT content FROM read_pandoc_blocks('test/fixtures/handwritten.org.pandoc.json')
   WHERE kind = 'block' AND coalesce(content, '') <> '')
);
----
0

# ...AND THE REVERSE, because EXCEPT in one direction is satisfied by the converter simply
# producing MORE. Both directions is what makes this an equality rather than a containment.
query I
SELECT count(*) FROM (
  (SELECT content FROM read_pandoc_blocks('test/fixtures/handwritten.org.pandoc.json')
   WHERE kind = 'block' AND coalesce(content, '') <> '')
  EXCEPT
  (SELECT content FROM read_org_blocks('test/fixtures/handwritten.org')
   WHERE kind = 'block' AND coalesce(content, '') <> '')
);
----
0

# ---------------------------------------------------------------------------
# THE TRAILING NEWLINE, which is the disagreement this cross-check found on its first run
# and which is now RESOLVED rather than pinned.
#
# Pandoc keeps a code block's trailing newline -- its own Org reader gives 12 bytes for an
# 11-byte line. panduck's org, latex, rst, ipynb and epub readers ALL trim it: five
# independently written readers reaching the same conclusion, which makes it a convention
# rather than an accident. A source line's TERMINATOR is not its content.
#
# So the converter trims too, and that is the one place it deliberately diverges from the
# AST it was handed. Left alone, panduck answered one question two ways depending on which
# route a user took -- and a route-dependent answer is worse than a documented divergence
# from the reference. The pandoc-faithful behaviour is a `pandoc_compat` candidate.
#
# Asserted as LENGTHS: the byte that matters cannot be written inside a tab-delimited
# value, so a naive comparison shows two identical-looking strings and fails invisibly.
query II
SELECT 'converter' AS path, length(content)
FROM read_pandoc_blocks('test/fixtures/handwritten.org.pandoc.json') WHERE element_type = 'code'
UNION ALL
SELECT 'native org', length(content)
FROM read_org_blocks('test/fixtures/handwritten.org') WHERE element_type = 'code'
ORDER BY 1;
----
converter	11
native org	11

# ---------------------------------------------------------------------------
# DISPATCH: reachable by format := 'pandoc', and NEVER by extension.
#
# `.json` is already claimed as a DATA format, a Pandoc AST file is also a .json, and
# dispatch cannot tell them apart by suffix -- the overwhelming majority of .json files in
# the world are data. Auto-routing would silently change what every existing .json query
# returns to serve a rare case, which is the wrong direction to be wrong in.
query II
SELECT element_type, content FROM read_panduck_doc(
  'test/fixtures/handwritten.org.pandoc.json', format := 'pandoc')
WHERE kind = 'block' AND element_type = 'heading' ORDER BY element_order;
----
heading	Heading One
heading	Heading Two

# THE NEGATIVE IS THE LOAD-BEARING HALF. .json must still resolve to `data`, and the
# pandoc format must claim NO registry row -- a format with no extension is unroutable by
# suffix by construction, which is the property that keeps existing .json reads working.
query I
SELECT format FROM panduck_reader_registry() WHERE ext = '.json';
----
data

query I
SELECT count(*) FROM panduck_reader_registry() WHERE format = 'pandoc';
----
0

# ...and it is still DECLARED, so `panduck_supported_extensions()` reports a format panduck
# can read even though nothing routes to it automatically. Declared-but-unroutable is the
# right shape here, and is different from planned-but-unimplemented: there IS a reader.
query II
SELECT format, reader FROM panduck_supported_extensions() WHERE format = 'pandoc';
----
pandoc	read_pandoc_blocks
