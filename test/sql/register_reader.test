# name: test/sql/register_reader.test
# description: panduck_register_doc_reader end to end, via the .parquet_duck_blocks bridge
# group: [sql]

#
# TWO THINGS AT ONCE, and both were untested before this file.
#
# FIRST, runtime reader registration. panduck_register_doc_reader has always been
# registered and its registry ROW was asserted, but nothing ever registered a reader and
# then READ THROUGH IT. A registry entry that dispatch cannot actually use would have
# passed every existing assertion.
#
# SECOND, and the reason the format is parquet: this is how duck_blocks cross a DuckDB ABI
# BOUNDARY. Extensions in this portfolio pin different DuckDB commits -- webbed pins
# b155d6f63c (v1.5.5-dev154) while panduck is on released v1.5.5 -- and an extension built
# for one refuses to load in the other, so "does panduck work with webbed's new output"
# cannot be answered by loading both. Writing one side's blocks to parquet and reading them
# from the other side answers it, because parquet is understood by both without either
# extension.
#
# That is how webbed#143 was verified before it published: its fixed emitter wrote blocks
# from webbed's binary, panduck's binary read them back, and doc_section matched headings
# by an id that only exists because of that fix. Without the bridge that verification would
# have had to wait for a published build -- which is the wrong order, since publishing is
# what it was meant to gate.
#
# WHAT THE BRIDGE DOES NOT PROVE, stated so nobody over-reads it: it establishes DATA
# compatibility, not linkage. Parquet carries rows across regardless of whether the two
# .so files could ever coexist, so an ABI-level problem would be invisible to it. For
# duck_block semantics it is sufficient; for linkage only aligned DuckDB pins would do.

require panduck

# parquet is explicitly installed rather than assumed: the unittest binary is built with
# ENABLE_EXTENSION_AUTOLOADING=0, so a COPY ... (FORMAT parquet) fails with a catalog error
# instead of quietly autoloading, exactly as duck_block_utils does in doc_namespace.test.
statement ok
INSTALL parquet;

statement ok
LOAD parquet;

# duck_block_utils is installed explicitly for the same reason parquet is: the unittest
# binary is built with ENABLE_EXTENSION_AUTOLOADING=0, so doc_toc's runtime lookup of
# duck_blocks_toc fails with a catalog error rather than autoloading.
#
# THIS FILE PASSED LOCALLY AND FAILED IN CI WITHOUT IT. The developer machine's shared
# ~/.duckdb profile already had duck_block_utils installed, so the doc_toc assertion below
# resolved for a reason the test never stated; CI's clean container had nothing. That is the
# same installed-vs-declared confusion this suite keeps finding in panduck's own dependencies
# -- doc_namespace.test installs it explicitly three times for exactly this reason, one file
# away, and passed the CI run this file failed.
statement ok
INSTALL duck_block_utils;

statement ok
LOAD duck_block_utils;

# A duck_block stream from any panduck reader, written out as parquet. Self-contained on
# purpose -- no second extension is needed to demonstrate the mechanism, and using a real
# reader means the columns are the canonical seven rather than something hand-built.
statement ok
COPY (SELECT * FROM read_odt_blocks('test/fixtures/constructs.odt') ORDER BY element_order)
  TO '__TEST_DIR__/bridge.parquet_duck_blocks' (FORMAT parquet);

# The extension is claimed at RUNTIME. Nothing in panduck's C++ knows this suffix exists.
query IIII
SELECT * FROM panduck_register_doc_reader('parquet', 'read_parquet', ['.parquet_duck_blocks']);
----
.parquet_duck_blocks	parquet	read_parquet	doc

# The registry answers for it exactly as it does for a builtin reader.
query I
SELECT panduck_format_for('__TEST_DIR__/bridge.parquet_duck_blocks');
----
parquet

query I
SELECT panduck_can_read('__TEST_DIR__/bridge.parquet_duck_blocks');
----
true

query I
SELECT panduck_reader_function_for('__TEST_DIR__/bridge.parquet_duck_blocks');
----
read_parquet

# DISPATCH ACTUALLY GOES THERE. This is the assertion the registry row could not make:
# read_panduck_doc resolves the suffix, calls the registered function, and returns the same
# document that went in.
query I
SELECT (SELECT count(*) FROM read_panduck_doc('__TEST_DIR__/bridge.parquet_duck_blocks'))
     = (SELECT count(*) FROM read_odt_blocks('test/fixtures/constructs.odt'));
----
true

# And what comes back is duck_blocks, not merely rows with the right column names.
query I
SELECT bool_and(kind IN ('block', 'inline', 'value') AND encoding IS NOT NULL)
FROM read_panduck_doc('__TEST_DIR__/bridge.parquet_duck_blocks');
----
true

# The doc_* family works over a registered reader with no special-casing, which is what
# makes the bridge useful rather than merely possible -- doc_toc and doc_section are how a
# verification actually asks its question.
query I
SELECT (SELECT count(*) FROM doc_toc('__TEST_DIR__/bridge.parquet_duck_blocks'))
     = (SELECT count(*) FROM doc_toc('test/fixtures/constructs.odt'));
----
true

query I
SELECT count(*) > 0 FROM doc_section('__TEST_DIR__/bridge.parquet_duck_blocks', 'Heading Two');
----
true

# Round-trip through the pandoc writer, so the bridged blocks are provably still writable.
query I
SELECT length(panduck_blocks_to_pandoc_ast(
    (SELECT list(b ORDER BY b.element_order)
     FROM read_panduck_doc('__TEST_DIR__/bridge.parquet_duck_blocks') b))::VARCHAR) > 0;
----
true

# AN EMPTY reader_ext MEANS "no companion extension needed" -- and until this assertion
# existed, it also meant "unreachable". panduck_register_doc_reader('', fn, exts) stores an
# empty reader_ext, RegistryFieldFun maps empty to NULL, so panduck_format_for answers NULL
# for the suffix. read_panduck_doc's generic WHEN compared
# panduck_resolved_format(src, 'auto') = panduck_format_for(src), which for this entry is
# NULL = NULL -> NULL -> never TRUE. Dispatch fell straight through to the CODE fallback:
# the caller asked for their registered reader and got a syntax-highlighted parse tree, with
# no error to say so. The comparison is IS NOT DISTINCT FROM for that reason.
#
# The bridge file is written again under a second suffix so this entry is independent of the
# '.parquet_duck_blocks' registration above -- that one names a reader_ext and would pass
# whether or not the NULL case works.
statement ok
CALL panduck_register_doc_reader('', 'read_parquet', ['.noext_duck_blocks']);

# The registry has the entry and names the function, but has no format for it -- this is the
# state the old comparison could not act on, asserted so the fix is anchored to its cause.
query II
SELECT panduck_format_for('x.noext_duck_blocks'), panduck_reader_function_for('x.noext_duck_blocks');
----
NULL	read_parquet

statement ok
COPY (SELECT * FROM read_odt_blocks('test/fixtures/constructs.odt') ORDER BY element_order)
  TO '__TEST_DIR__/noext.noext_duck_blocks' (FORMAT parquet);

# THE OUTPUT, not the row count. A code-fallback read returns tree-sitter node types, or --
# in the unittest binary, which is built with ENABLE_EXTENSION_AUTOLOADING=0 -- fails to bind
# ast_to_blocks at all. The registered reader returns the document's own block vocabulary.
query II
SELECT element_order, element_type
FROM read_panduck_doc('__TEST_DIR__/noext.noext_duck_blocks')
ORDER BY element_order LIMIT 4;
----
0	heading
1	paragraph
2	text
3	bold

query I
SELECT content FROM read_panduck_doc('__TEST_DIR__/noext.noext_duck_blocks')
WHERE element_type = 'heading' ORDER BY element_order LIMIT 1;
----
Heading One

query I
SELECT (SELECT count(*) FROM read_panduck_doc('__TEST_DIR__/noext.noext_duck_blocks'))
     = (SELECT count(*) FROM read_odt_blocks('test/fixtures/constructs.odt'));
----
true
