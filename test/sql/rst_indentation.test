# name: test/sql/rst_indentation.test
# description: RST containment by indentation -- block quotes, list item bodies, comment bodies, bare ::
# group: [sql]

#
# RST EXPRESSES CONTAINMENT BY INDENTATION ALONE, and one question decides every case here:
# what does an indented run belong to? Before #64 the reader answered "nothing" for most of
# them, so the text survived but the structure did not:
#
#   a block quote                    -> level-1 paragraphs            (pandoc: BlockQuote)
#   a list item's second paragraph   -> level-1 paragraph, list SPLIT (pandoc: one list)
#   a comment's indented body        -> leaked into the document      (pandoc: dropped)
#   a bare `::` literal block        -> hr + paragraph                (pandoc: CodeBlock)
#
# They are one file because they are one rule, and fixing the first alone would have MOVED
# the other three: a continuation paragraph or a comment body would have become a false
# QUOTE instead of a false paragraph. Every expected shape below was measured against
# pandoc 3.1.3 first; the levels follow this reader's existing convention -- a container's
# children at level+1, a list item's children at the item's level+1.

require panduck

# ---------------------------------------------------------------------------------------
# GUARDS: indented shapes the reader ALREADY got right. They pass before and after #64; they
# are here so the new rule cannot quietly take them over.
# ---------------------------------------------------------------------------------------

# A definition: a term with its body on the NEXT line, no blank between. Not a quote.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'Term\n   The definition, no blank line.\n\nAfter.\n') ORDER BY element_order;
----
1	list	(empty)
2	list_item	Term
2	list_item	The definition, no blank line.
1	paragraph	After.

# An attached `::` literal block. Not a quote.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'Code follows::\n\n   literal text\n\nAfter.\n') ORDER BY element_order;
----
1	paragraph	Code follows:
1	code	literal text
1	paragraph	After.

# A directive body is the directive's, not a quote.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'.. note::\n\n   A note body.\n\nAfter.\n') ORDER BY element_order;
----
1	div	(empty)
2	paragraph	A note body.
1	paragraph	After.

# ---------------------------------------------------------------------------------------
# BLOCK QUOTES (#64): an indented run that nothing above it claims.
# ---------------------------------------------------------------------------------------

# The reported case. Before #64: `1 paragraph A quoted warning.` -- and duck_blocks_to_md
# gave `A quoted warning.` where the pandoc route gave `> A quoted warning.`
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'Title\n=====\n\nBefore the quote.\n\n   A quoted warning.\n\nAfter the quote.\n') ORDER BY element_order;
----
1	heading	Title
1	paragraph	Before the quote.
1	blockquote	(empty)
2	paragraph	A quoted warning.
1	paragraph	After the quote.

# An attribution is a second paragraph INSIDE the quote, as pandoc has it.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'Para.\n\n   Quoted line one.\n   Quoted line two.\n\n   -- Attribution\n\nAfter.\n') ORDER BY element_order;
----
1	paragraph	Para.
1	blockquote	(empty)
2	paragraph	Quoted line one. Quoted line two.
2	paragraph	-- Attribution
1	paragraph	After.

# Deeper indentation inside a quote is a quote inside the quote.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'Para.\n\n   Outer quote.\n\n      Inner quote.\n\nAfter.\n') ORDER BY element_order;
----
1	paragraph	Para.
1	blockquote	(empty)
2	paragraph	Outer quote.
2	blockquote	(empty)
3	paragraph	Inner quote.
1	paragraph	After.

# The quote's base is the DOCUMENT's column, not the first line's: a quote can open the
# document, and a document indented throughout is one quote (pandoc agrees on both).
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'   A quote as the very first block.\n\nAfter.\n') ORDER BY element_order;
----
1	blockquote	(empty)
2	paragraph	A quote as the very first block.
1	paragraph	After.

query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'   Whole document is indented.\n\n   Second paragraph, same indent.\n') ORDER BY element_order;
----
1	blockquote	(empty)
2	paragraph	Whole document is indented.
2	paragraph	Second paragraph, same indent.

# A quote holds any block, not only paragraphs.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'Para.\n\n   - a bullet inside a quote\n   - second\n\nAfter.\n') ORDER BY element_order;
----
1	paragraph	Para.
1	blockquote	(empty)
2	list	(empty)
3	list_item	a bullet inside a quote
3	list_item	second
1	paragraph	After.

# The `..` + blank line idiom: an EMPTY comment ends a definition list so the indented run
# after it is a quote rather than more definition. constructs.rst uses exactly this.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'Term\n   Def.\n\n..\n\n   A quote after a comment.\n') ORDER BY element_order;
----
1	list	(empty)
2	list_item	Term
2	list_item	Def.
1	blockquote	(empty)
2	paragraph	A quote after a comment.

# ---------------------------------------------------------------------------------------
# LIST ITEM BODIES. An item owns what is indented to its TEXT COLUMN or deeper. Before #64 a
# second paragraph fell out to level 1 and SPLIT the list in two.
# ---------------------------------------------------------------------------------------

query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'- item one\n\n  continuation of item one\n\n- item two\n') ORDER BY element_order;
----
1	list	(empty)
2	list_item	item one
3	paragraph	continuation of item one
2	list_item	item two

# The text column is the MARKER'S width, not a fixed 2: `10. ` puts it at 4.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'10. item ten\n\n    continuation of ten\n\n11. item eleven\n') ORDER BY element_order;
----
1	list	(empty)
2	list_item	item ten
3	paragraph	continuation of ten
2	list_item	item eleven

# ...and so is extra space after a bullet: `-   item` puts it at 4.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'-   item one\n\n    continuation, text column 4\n\n-   item two\n') ORDER BY element_order;
----
1	list	(empty)
2	list_item	item one
3	paragraph	continuation, text column 4
2	list_item	item two

# THE CASE THAT FIXES THE RULE: indented past the bullet but SHORT of the text column is
# not the item's. pandoc ends the list, quotes the run, and starts a new list -- so a rule of
# "indented under an item belongs to it" would be wrong here.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'-   item one\n\n  indent 2, less than text column 4\n\n-   item two\n') ORDER BY element_order;
----
1	list	(empty)
2	list_item	item one
1	blockquote	(empty)
2	paragraph	indent 2, less than text column 4
1	list	(empty)
2	list_item	item two

# Deeper than the text column is a quote INSIDE the item.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'- item one\n\n     deeper than the item text\n\n- item two\n') ORDER BY element_order;
----
1	list	(empty)
2	list_item	item one
3	blockquote	(empty)
4	paragraph	deeper than the item text
2	list_item	item two

# A nested list after a blank line stays in its item. Before #64 this was THREE lists.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'- a\n\n  - b\n  - c\n\n- d\n') ORDER BY element_order;
----
1	list	(empty)
2	list_item	a
3	list	(empty)
4	list_item	b
4	list_item	c
2	list_item	d

# ---------------------------------------------------------------------------------------
# COMMENT BODIES. A comment owns an indented run that starts on the VERY NEXT line; a blank
# line ends the comment. Before #64 the body leaked into the document as prose.
# ---------------------------------------------------------------------------------------

query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'Para.\n\n..\n   A multi-line comment body,\n   not a quote.\n\nAfter.\n') ORDER BY element_order;
----
1	paragraph	Para.
1	paragraph	After.

# The body continues across a blank line while it stays indented.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'.. comment\n   body\n\n   more after blank\n\nAfter.\n') ORDER BY element_order;
----
1	paragraph	After.

# ...but a blank line straight after the comment line means the comment has NO body, and the
# indented run is a quote, even when the comment has text.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'.. comment text\n\n   indented after a blank\n') ORDER BY element_order;
----
1	blockquote	(empty)
2	paragraph	indented after a blank

# A comment inside a quote is dropped, and the quote continues past it.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'Para.\n\n   Quoted.\n\n   .. a comment inside the quote\n\n   Still quoted.\n') ORDER BY element_order;
----
1	paragraph	Para.
1	blockquote	(empty)
2	paragraph	Quoted.
2	paragraph	Still quoted.

# ---------------------------------------------------------------------------------------
# BARE `::`. rst_reader.test has long SAID "a bare `::` paragraph disappears entirely" but only
# tested the attached `Follows::` form. The scanner read a lone `::` as a two-character
# adornment, so it became an hr and its literal block became a paragraph.
# ---------------------------------------------------------------------------------------

query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'Para.\n\n::\n\n   literal text\n\nAfter.\n') ORDER BY element_order;
----
1	paragraph	Para.
1	code	literal text
1	paragraph	After.

# A real transition is still an hr: the fix is for a lone `::`, not for adornment lines.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'A\n\n----\n\nB\n') ORDER BY element_order;
----
1	paragraph	A
1	hr	(empty)
1	paragraph	B

# ---------------------------------------------------------------------------------------
# WRAPPED LINES. The line that claims a run absorbs its WRAPS -- the lines that follow it with
# no blank between -- before any body begins. Measured when designing #64, and the reason the
# list rule is "wraps first, then the body": without it, a wrapped item's second line becomes
# a child paragraph, which pandoc does not do. Before #64 each of these SPLIT its list.
# ---------------------------------------------------------------------------------------

query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'- item one\n  wraps here\n- item two\n') ORDER BY element_order;
----
1	list	(empty)
2	list_item	item one wraps here
2	list_item	item two

query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'1. item one\n   wraps here\n2. item two\n') ORDER BY element_order;
----
1	list	(empty)
2	list_item	item one wraps here
2	list_item	item two

# Wrap first, THEN the body: the joined text stays on the item, the later paragraph is its child.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'- item one\n  wraps here\n\n  second paragraph\n\n- item two\n') ORDER BY element_order;
----
1	list	(empty)
2	list_item	item one wraps here
3	paragraph	second paragraph
2	list_item	item two

# A field value wraps the same way, and the field list stays ONE list.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E':Author: A. Writer\n   continued value\n:Version: 1.0\n\nAfter.\n') ORDER BY element_order;
----
1	list	(empty)
2	list_item	Author
2	list_item	A. Writer continued value
2	list_item	Version
2	list_item	1.0
1	paragraph	After.

# ...but after a BLANK line the indented run is not the field's: pandoc quotes it. (pandoc
# also reads the value `A. Writer` as an upper-alpha enumerated list; panduck keeps it as the
# text it is, which is a separate, pre-existing difference and not what this asserts.)
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E':Author: A. Writer\n\n   indented after blank\n\nAfter.\n') ORDER BY element_order;
----
1	list	(empty)
2	list_item	Author
2	list_item	A. Writer
1	blockquote	(empty)
2	paragraph	indented after blank
1	paragraph	After.

# A quote's own wrapped lines are one paragraph.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'Para.\n\n   Quote line one\n   quote line two\n\nAfter.\n') ORDER BY element_order;
----
1	paragraph	Para.
1	blockquote	(empty)
2	paragraph	Quote line one quote line two
1	paragraph	After.

# ---------------------------------------------------------------------------------------
# EXPLICIT MARKUP IS NOT ALL COMMENTARY. The scanner files every non-directive `..` line under
# COMMENT, but a FOOTNOTE or CITATION body is document text. The first cut of #64 dropped it
# with real comments' bodies, and the word-loss guard caught it on constructs.rst ("body") --
# these 31 targeted assertions had not. pandoc carries the body as a Note; panduck keeps it
# as prose at the current depth, which is what it emitted before #64.
# ---------------------------------------------------------------------------------------

query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'Text with a footnote. [1]_\n\n.. [1]\n   The footnote body.\n') ORDER BY element_order;
----
1	paragraph	Text with a footnote. [1]_
1	paragraph	The footnote body.

query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'See [CIT2002]_.\n\n.. [CIT2002]\n   A citation body.\n') ORDER BY element_order;
----
1	paragraph	See [CIT2002]_.
1	paragraph	A citation body.

# A hyperlink target's body is its URL, resolved into the link by pandoc and never text of its
# own. Dropped -- where before #64 the URL leaked into the document as a paragraph.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'A link_.\n\n.. _link:\n   https://example.com\n') ORDER BY element_order;
----
1	paragraph	A link_.

# ---------------------------------------------------------------------------------------
# THE BODY CAN SIT ON THE LABEL LINE (#67). Every assertion above puts it on the NEXT line,
# and that is exactly why nothing caught this: `.. [1] The body.` emitted NOTHING, and the
# wrapped form emitted only its continuation. The label line's text is document text, so it
# now seeds the paragraph -- which also joins a continuation into ONE paragraph, as pandoc
# reads it.
# ---------------------------------------------------------------------------------------

query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'Text with a footnote. [1]_\n\n.. [1] The footnote body.\n') ORDER BY element_order;
----
1	paragraph	Text with a footnote. [1]_
1	paragraph	The footnote body.

# ONE paragraph, not the label line and its continuation as two.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'.. [2] The footnote body\n   continues here.\n') ORDER BY element_order;
----
1	paragraph	The footnote body continues here.

query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'See [CIT2002]_.\n\n.. [CIT2002] A citation body.\n') ORDER BY element_order;
----
1	paragraph	See [CIT2002]_.
1	paragraph	A citation body.

# THE CONTROL that keeps the fix honest: an ordinary comment still produces nothing, whether
# its text is on the label line or indented below it. Only a `[` label makes it document text.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'Before.\n\n.. A comment with text on its own line.\n\n.. A comment\n   with an indented body.\n\nAfter.\n') ORDER BY element_order;
----
1	paragraph	Before.
1	paragraph	After.

# The fixture check_word_loss.py now reads: every footnote and citation form in one file, so a
# form that goes missing is caught by the guard as well as by the assertions above.
query III
SELECT count(*), count(*) FILTER (WHERE element_type = 'paragraph'), count(*) FILTER (WHERE element_type = 'heading')
FROM read_rst_blocks('test/fixtures/footnotes.rst');
----
9	8	1

# ---------------------------------------------------------------------------------------
# AN ENUMERATED SECTION TITLE IS A HEADING (#84, #87). `1. Table of Contents` under an
# underline was read as a one-item ordered list plus an `hr`: the heading lost, the number
# discarded, the rule invented. Measured on duckeye's fixture, panduck found 2 headings
# where pandoc found 4 -- lost structure, so doc_toc could not see the section.
#
# WHAT QUALIFIES IS THE RUN'S OWN LENGTH, measured against docutils 0.20.1 -- the RST
# reference implementation. #84 recorded a pandoc-derived rule here, "only ENUM, and only
# when the run is at least as long as the title", and BOTH halves were wrong:
#
#   run of 2 or 3 characters -> paragraph, NOT a title. This is the floor that keeps `::`
#                               opening a literal block: it is two characters.
#   run of 4 or more         -> TITLE, however short it is against the text. docutils
#                               warns "Title underline too short" and makes the section.
#
# The title's own length changes nothing but that warning. pandoc instead needs the run to
# reach the title's length, so pandoc reads a 4-dash run under an 18-character title as
# prose where docutils reads a section. panduck follows docutils (#87), which also recovers
# the `1.` that the list reading discarded.
# ---------------------------------------------------------------------------------------

query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'1. Table of Contents\n--------------------\n\nBody under it.\n') ORDER BY element_order;
----
1	heading	1. Table of Contents
1	paragraph	Body under it.

# The marker is kept as written: `1.` and `1)` are both ENUM with start=1, so the scanner
# carries the line's original text rather than rebuilding it.
query III
SELECT level, element_type, coalesce(content, '') FROM read_rst_blocks_string(
  E'1) Paren Title\n--------------\n\nBody.\n') ORDER BY element_order;
----
1	heading	1) Paren Title
1	paragraph	Body.

# CONTROL: an un-underlined enumerated list is still a list.
#
# `coalesce(content, '<none>')`, not `''`: a `list` row has empty content, and a row whose
# LAST column is empty ends in a trailing tab, which sqllogictest reads as one column short.
query III
SELECT level, element_type, coalesce(content, '<none>') FROM read_rst_blocks_string(
  E'1. a real list item\n2. another list item\n') ORDER BY element_order;
----
1	list	<none>
2	list_item	a real list item
2	list_item	another list item

# CONTROL: a list item followed by a lone `::` still opens a literal block -- `::` is an
# adornment run to the scanner, and two characters is below docutils' four-character floor
# for a section adornment.
query III
SELECT level, element_type, coalesce(content, '<none>') FROM read_rst_blocks_string(
  E'- item\n\n::\n\n   code\n') ORDER BY element_order;
----
1	list	<none>
2	list_item	item
1	code	code

# UNCHANGED, and NOT a defect: a bulleted line under an underline is a bullet list followed
# by a TRANSITION in docutils -- `bullet_list, list_item, transition, paragraph`, which is
# exactly panduck's `list, list_item, hr, paragraph`. pandoc is the outlier, reading the
# construct as a heading whose title text is `- Bulleted Title`, dash included. #87 was
# filed calling this `hr` invented; the reference implementation shows it is real. Pinned
# so the shape cannot drift unnoticed.
query I
SELECT string_agg(element_type, ',' ORDER BY element_order) FROM read_rst_blocks_string(
  E'- Bulleted Title\n----------------\n\nBody.\n');
----
list,list_item,hr,paragraph

# THE MARKER SURVIVES A SHORT UNDERLINE (#87). Four characters is above docutils' floor, so
# this is a section title even though the run is far shorter than the text. The list reading
# discarded the `1.` outright -- the one shape where panduck matched NEITHER reference and
# broke the "discard nothing" rule in README.md.
query III
SELECT level, element_type, coalesce(content, '<none>') FROM read_rst_blocks_string(
  E'1. Short Underline\n----\n\nBody.\n') ORDER BY element_order;
----
1	heading	1. Short Underline
1	paragraph	Body.

# BELOW THE THRESHOLD AN ENUMERATED LINE IS PROSE TOO (#88). These two records previously
# pinned `list, list_item, hr, paragraph` and `list, list_item, code`, recorded in #87 as
# a narrower residue left for later. Measured against docutils 0.20.1, BOTH were wrong:
# docutils reads one paragraph, `1. item` and the run together, and never makes a list.
#
#   `1. item` / `---`  -> docutils paragraph `1. item` + `---`;  pandoc `1. item ---`
#   `1. item` / `::`   -> docutils paragraph + literal_block;    pandoc `1. item :` + code
#
# So the list reading DISCARDED the `1.` here exactly as it did above the threshold -- the
# same breach of README's "discard nothing" that #87 fixed for long runs, surviving below
# it. The fold is the same one the TEXT path uses: the marker line and the run join `para`
# as prose, and no `hr` is invented.
query III
SELECT level, element_type, coalesce(content, '<none>') FROM read_rst_blocks_string(
  E'1. item\n---\n\nBody.\n') ORDER BY element_order;
----
1	paragraph	1. item ---
1	paragraph	Body.

query III
SELECT level, element_type, coalesce(content, '<none>') FROM read_rst_blocks_string(
  E'1. item\n--\n\nBody.\n') ORDER BY element_order;
----
1	paragraph	1. item --
1	paragraph	Body.

# `::` AFTER AN ENUMERATED ITEM still opens a literal block -- but as prose plus a literal,
# not as a list. flush()'s end-of-paragraph rule does the work once the line folds, and one
# colon stays in the prose: panduck's documented convention, and pandoc's reading. docutils
# drops both colons, which is the same one-character divergence declared on the TEXT path.
query III
SELECT level, element_type, coalesce(content, '<none>') FROM read_rst_blocks_string(
  E'1. item\n::\n\n   code\n') ORDER BY element_order;
----
1	paragraph	1. item :
1	code	code

# CONTROL: a BULLET below the threshold is NOT folded. docutils keeps the bullet_list and
# puts the run in a paragraph inside the item; pandoc reads the whole thing as prose; the
# two references disagree, and panduck matches neither exactly. That is the #87 transition
# story rather than this one, so it is pinned unchanged rather than swept into the fold.
query I
SELECT string_agg(element_type, ',' ORDER BY element_order) FROM read_rst_blocks_string(
  E'- item\n---\n\nBody.\n');
----
list,list_item,hr,paragraph

# ---------------------------------------------------------------------------------------
# THE ADORNMENT THRESHOLD IS `min(4, title length)` (#88), NOT A FLAT FLOOR.
#
# #87 recorded a flat four-character floor. That was right for every case #87 measured and
# WRONG in general, because an enumerated title is always at least four characters (`1. a`),
# so `min(4, len)` is always 4 there -- the flat rule was correct by accident. A plain TEXT
# title can be shorter, and docutils 0.20.1 makes a section of it:
#
#   `Doc`   / `===`   (3,3)  -> TITLE      3 >= min(4,3)
#   `Ab`    / `--`    (2,2)  -> TITLE      2 >= min(4,2)
#   `Abc`   / `--`    (3,2)  -> paragraph  2 <  min(4,3)
#   `Abcde` / `----`  (5,4)  -> TITLE      4 >= min(4,5)
#   `Abcde` / `---`   (5,3)  -> paragraph  3 <  min(4,5)
#
# panduck made a heading at EVERY run length, so it invented sections both references read
# as prose. pandoc differs from docutils in the band `4 <= run < title length` -- pandoc
# needs the run to reach the title -- and panduck follows docutils here, as it does for #87.
#
# BELOW THE THRESHOLD THE RUN IS PROSE, not a transition. Emitting an `hr` instead would
# trade an invented heading for an invented rule; both references fold the run into the
# paragraph, and panduck joins continuation lines with a space as it does for any wrapped
# paragraph.

query III
SELECT level, element_type, coalesce(content, '<none>') FROM read_rst_blocks_string(
  E'Plain item\n--\n\nBody.\n') ORDER BY element_order;
----
1	paragraph	Plain item --
1	paragraph	Body.

query III
SELECT level, element_type, coalesce(content, '<none>') FROM read_rst_blocks_string(
  E'Plain item\n---\n\nBody.\n') ORDER BY element_order;
----
1	paragraph	Plain item ---
1	paragraph	Body.

# AT the threshold: four characters is enough however long the title is.
query III
SELECT level, element_type, coalesce(content, '<none>') FROM read_rst_blocks_string(
  E'Plain item\n----\n\nBody.\n') ORDER BY element_order;
----
1	heading	Plain item
1	paragraph	Body.

# A SHORT TITLE NEEDS ONLY ITS OWN LENGTH. This record also guards a real fixture:
# test/fixtures/table_markup.rst opens with exactly `Doc` over `===`, so a flat floor of
# four would have turned that heading into a paragraph.
query III
SELECT level, element_type, coalesce(content, '<none>') FROM read_rst_blocks_string(
  E'Doc\n===\n\nBody.\n') ORDER BY element_order;
----
1	heading	Doc
1	paragraph	Body.

query III
SELECT level, element_type, coalesce(content, '<none>') FROM read_rst_blocks_string(
  E'Ab\n--\n\nBody.\n') ORDER BY element_order;
----
1	heading	Ab
1	paragraph	Body.

# ...and one character more of title puts the same run below the threshold.
query III
SELECT level, element_type, coalesce(content, '<none>') FROM read_rst_blocks_string(
  E'Abc\n--\n\nBody.\n') ORDER BY element_order;
----
1	paragraph	Abc --
1	paragraph	Body.

# `::` UNDER A LONG TITLE IS A LITERAL-BLOCK MARKER, not an underline. panduck read this as
# a heading plus a blockquote, where docutils reads `paragraph, literal_block` and pandoc
# reads `Para, CodeBlock`. Below the threshold the `::` folds into the paragraph, and the
# EXISTING end-of-paragraph rule takes it from there -- one colon stays in the prose, which
# is panduck's documented convention and matches pandoc. docutils drops both colons; that
# one character is a declared divergence, not a new invention.
query III
SELECT level, element_type, coalesce(content, '<none>') FROM read_rst_blocks_string(
  E'Plain item\n::\n\n   code\n') ORDER BY element_order;
----
1	paragraph	Plain item :
1	code	code

# CONTROL, and the reason the threshold is `min` rather than a floor: under a title short
# enough for it, `::` IS a section underline, and all three implementations agree. Pinned
# because the #87 comment claimed `::` could never reach the heading test -- true under a
# flat floor, false under this rule, and correct either way.
query I
SELECT string_agg(element_type, ',' ORDER BY element_order) FROM read_rst_blocks_string(
  E'Do\n::\n\n   code\n');
----
heading,blockquote,paragraph
