# name: test/sql/latex_reader.test
# description: read_latex_blocks() over the same document written by a person and by pandoc
# group: [sql]

require panduck

# THE CENTRAL ASSERTION. handwritten.tex and pandoc.tex are the SAME DOCUMENT written
# twice. pandoc buries \section two brace-levels deep inside \hypertarget{id}{% behind a
# comment token; a person writes \section at the top level. Both must yield the same
# headings at the same levels, and this is what proves TRANSPARENT works without any
# pandoc-specific rule in the reader.
query I
SELECT count(*) FROM (
  (SELECT content, attributes['heading_level'] FROM read_latex_blocks('test/fixtures/handwritten.tex')
   WHERE element_type = 'heading')
  EXCEPT
  (SELECT content, attributes['heading_level'] FROM read_latex_blocks('test/fixtures/pandoc.tex')
   WHERE element_type = 'heading')
);
----
0

# POSITIVE COMPANION, and it is load-bearing: the EXCEPT above is satisfied by MUTUAL
# EMPTINESS -- two readers that both return nothing agree perfectly. This is the same trap
# reader_registry.test documents for the dispatcher identity.
query II
SELECT content, attributes['heading_level'] FROM read_latex_blocks('test/fixtures/pandoc.tex')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	1
Heading Two	2

# \maketitle MUST EMIT NOTHING. handwritten.tex has \title/\author/\maketitle and
# pandoc.tex has none of them in its body, so the two documents are equivalent ONLY if
# \maketitle produces no block. Consistent with every other panduck reader: none extracts
# document metadata yet.
query I
SELECT count(*) FROM read_latex_blocks('test/fixtures/handwritten.tex')
WHERE content = 'Handwritten' OR content = 'Nobody';
----
0

# THE COMMENT MUST NOT LEAK, and the leading space it would leave is invisible on
# inspection. handwritten.tex carries "This comment must not appear in any block."
query I
SELECT count(*) FROM read_latex_blocks('test/fixtures/handwritten.tex')
WHERE content LIKE '%comment must not appear%';
----
0

# The preamble is discarded wholesale: no \usepackage line becomes a paragraph.
query I
SELECT count(*) FROM read_latex_blocks('test/fixtures/pandoc.tex')
WHERE content LIKE '%usepackage%' OR content LIKE '%documentclass%';
----
0

# ---------------------------------------------------------------------------
# read_latex_blocks_string. The string form is not scaffolding and not a second reader:
# it shares BuildRows with the file form, so the only thing that can differ between them
# is where the bytes come from. These are the rules that are unreadable as a fixture file.
# ---------------------------------------------------------------------------

# THE SAME EMITTER. Both forms go through one BuildRows, so the string form owes the same
# canonical column set and the same level rules -- a block at 1, its inlines at 2, heading
# rank in attributes and never in `level`. Asserted on VALUES rather than a count, because
# a count agrees while every value is wrong.
#
# A table function argument cannot be a subquery, so the file form's bytes cannot be piped
# into the string form to compare them directly; this asserts the shared contract instead.
query IIIIII
SELECT kind, element_type, content, level, encoding, element_order
FROM read_latex_blocks_string('\section{H} \textbf{bold}.') ORDER BY element_order;
----
block	heading	H	1	text	0
block	paragraph	NULL	1	text	1
inline	bold	bold	2	text	2
inline	text	.	2	text	3

# ...and the heading rank rides in attributes, not in `level`, for the string form too.
query II
SELECT level, attributes['heading_level'] FROM read_latex_blocks_string('\subsection{H}');
----
1	2

# A FRAGMENT IS A BODY. No \begin{document} and no evidence of a preamble, so the whole
# token stream is the document. This is what the string form exists for.
query II
SELECT element_type, content FROM read_latex_blocks_string('\section{Frag} and text') ORDER BY element_order;
----
heading	Frag
paragraph	and text

# ---------------------------------------------------------------------------
# AN UNCLOSED `[` MUST NOT EAT THE DOCUMENT.
#
# `[` and `]` are ORDINARY CHARACTERS to the tokenizer -- optional arguments are a
# convention macros implement, not TeX syntax -- so a `[` and its `]` routinely land in
# different tokens and the search for the close has to cross them. Unbounded, that search
# ran to the first `]` ANYWHERE in the rest of the document: it deleted the text on both
# sides and welded two paragraphs into one. Bounded at PAR_BREAK, at a brace group and at
# \begin/\end, an unclosed bracket is simply text.
# ---------------------------------------------------------------------------
query II
SELECT element_type, content FROM read_latex_blocks_string(E'one \\includegraphics[width=2cm{a.png} tail.\n\ntwo has a ] bracket.\n\nthree.')
WHERE kind = 'block' AND content IS NOT NULL ORDER BY element_order;
----
paragraph	two has a ] bracket.
paragraph	three.

# ...and in the PREAMBLE the same runaway consumed \begin{document} itself, so the body
# was never found and the reader returned NOTHING for a document it could mostly read.
query II
SELECT element_type, content FROM read_latex_blocks_string(E'\\documentclass[x\n\\begin{document}\nBody one [two] three\n\\end{document}')
ORDER BY element_order;
----
paragraph	Body one [two] three

# THE BOUND MUST NOT BREAK THE CASE IT EXISTS FOR. `[width=\textwidth]` genuinely spans
# three tokens -- TEXT "[width=", CONTROL_WORD textwidth, TEXT "]" -- and is still
# consumed whole, leaving the required argument to be read as the image source.
query II
SELECT element_type, attributes['src'] FROM read_latex_blocks_string('\includegraphics[width=\textwidth]{img.png}')
WHERE kind = 'inline';
----
image	img.png

# ---------------------------------------------------------------------------
# AN EMPTY HEADING IS NOT A HEADING. \section{} would emit a block with NULL content and
# no inline children to justify the NULL, which is the one shape a duck_block consumer can
# neither render nor index. The inline path already refuses an empty formatted run; the
# third column proves the guard drops the heading WITHOUT dropping the text around it.
# ---------------------------------------------------------------------------
query III
SELECT (SELECT count(*) FROM read_latex_blocks_string('\section{}')),
       (SELECT count(*) FROM read_latex_blocks_string('\section')),
       (SELECT count(*) FROM read_latex_blocks_string('kept. \section{}'));
----
0	0	1

# ---------------------------------------------------------------------------
# A PREAMBLE WITH NO \begin{document} IS STILL A PREAMBLE. Falling all the way back to
# token 0 for a truncated document re-parses \documentclass as prose -- an unknown macro's
# brace group is transparent, so the class name survives -- and the document then led with
# a paragraph reading "article".
# ---------------------------------------------------------------------------
query I
SELECT count(*) FROM read_latex_blocks_string(E'\\documentclass{article}\n\\usepackage{ulem}\n\\section{X}\nbody')
WHERE content = 'article';
----
0

# ...and the body after the preamble is still read, which is the thing the fragment
# fallback is protecting.
query II
SELECT element_type, content FROM read_latex_blocks_string(E'\\documentclass{article}\n\\usepackage{ulem}\n\\section{X}\nbody')
WHERE element_type = 'heading' OR content = 'body' ORDER BY element_order;
----
heading	X
paragraph	body

# ---------------------------------------------------------------------------
# INLINE FORMATTING, AND IT NESTS.
# ---------------------------------------------------------------------------

# Inline formatting, both fixtures, including the two spellings of strike -- \sout in the
# handwritten file and \st in pandoc's output.
query II
SELECT element_type, content FROM read_latex_blocks('test/fixtures/pandoc.tex')
WHERE kind = 'inline' AND element_type <> 'text' ORDER BY element_order;
----
bold	bold
italic	italic
strikethrough	strike

# NESTING IS EMITTED GENUINELY. \textbf{\emph{x}} is a tree in the source and stays one.
# Flattening to "strongest format wins" -- which every other panduck reader still does, and
# rtf_reader.cpp:77 documents as a limitation -- discards the one thing LaTeX states
# unambiguously. Before this task the inner \emph was dropped outright, yielding `bold x`.
#
# TWO ROWS, NOT THREE. bold's only child is an ITALIC, not a text run, so bold nests and
# carries no content. italic's only child IS a text run, so italic CARRIES it rather than
# growing a `text` child. That is duck_block's content rule -- populated iff the only child
# is plain text -- applied at each level independently.
query III
SELECT element_type, content, level FROM read_latex_blocks_string('\textbf{\emph{x}}')
WHERE kind = 'inline' ORDER BY element_order;
----
bold	NULL	2
italic	x	3

# ...AND THE SIMPLE CASE STAYS FLAT. \textbf{x} is ONE run, byte-identical to what the
# other four readers emit. Asserting only the nested case would pass against a reader that
# over-nested everything; the two together are what discriminate.
query III
SELECT element_type, content, level FROM read_latex_blocks_string('\textbf{x}')
WHERE kind = 'inline' ORDER BY element_order;
----
bold	x	2

# AN EMPTY LINK LABEL IS NOT A NULL LINK. \href{url}{} would otherwise emit the one shape
# left in this reader that a consumer can neither render nor index: NULL content with no
# children to justify the NULL -- the same objection that makes \section{} not a heading.
# \url{url} already labels a link with its target, so an empty \href label gets that same
# answer rather than a second convention. The second row proves the text after it survives.
query III
SELECT element_type, content, attributes['href'] FROM read_latex_blocks_string('\href{http://x}{} kept')
WHERE kind = 'inline' AND element_type = 'link' ORDER BY element_order;
----
link	http://x	http://x

query I
SELECT count(*) FROM read_latex_blocks_string('\href{http://x}{} kept')
WHERE element_type = 'text' AND trim(content) = 'kept';
----
1

# ---------------------------------------------------------------------------
# ENVIRONMENTS AND LISTS.
# ---------------------------------------------------------------------------

# LISTS ARE CONTAINERS AND SO ARE THEIR ITEMS. A bare \item text is a TIGHT item: its run
# is a `plain`, a block-level text run with NO paragraph semantics -- Pandoc's Plain
# constructor, and exactly what the source wrote. Both attribute spellings are emitted:
# list_type is canonical, `ordered` is the legacy alias a v1-era consumer reads.
query IIIII
SELECT element_type, content, level, attributes['list_type'], attributes['ordered']
FROM read_latex_blocks('test/fixtures/pandoc.tex')
WHERE element_type IN ('list', 'list_item', 'plain') ORDER BY element_order;
----
list	NULL	1	bullet	false
list_item	bullet one	2	NULL	NULL
list_item	bullet two	2	NULL	NULL

# ...and the handwritten spelling of the same list -- `\item bullet one` on ONE line rather
# than pandoc's `\item` + indented continuation -- reads identically. The two fixtures are
# the same document, so a list rule that depended on where the newline fell would show up
# here and nowhere else.
query III
SELECT element_type, content, level FROM read_latex_blocks('test/fixtures/handwritten.tex')
WHERE element_type IN ('list', 'list_item', 'plain') ORDER BY element_order;
----
list	NULL	1
list_item	bullet one	2
list_item	bullet two	2

# A blockquote owns its paragraph one level deeper and carries no content itself.
query III
SELECT element_type, content, level FROM read_latex_blocks('test/fixtures/pandoc.tex')
WHERE element_type = 'blockquote' OR content = 'A block quote.' ORDER BY element_order;
----
blockquote	NULL	1
paragraph	A block quote.	2

# \tightlist emits nothing -- it is pandoc's spacing hint, not content. If it leaked the
# two fixtures would stop being equivalent, since handwritten.tex has no such macro.
query I
SELECT count(*) FROM read_latex_blocks('test/fixtures/pandoc.tex')
WHERE content LIKE '%tightlist%';
----
0

# THE ASYMMETRY FOR UNKNOWN INPUT. An unknown MACRO is dropped with its arguments, because
# most unrecognised macros are presentational and descending would flood the output. An
# unknown ENVIRONMENT is descended into, because most still wrap prose. `tabular` is the
# documented exception: descending yields mangled cell text as sentences.
#
# THE ASYMMETRY STOPS AT THE DESCENT. Its run is a `paragraph`, the same as a KNOWN
# transparent environment's, because the same bytes must not read differently for being
# wrapped in a name that happens to be in the table -- and body text accumulating into a
# paragraph until a blank line is what LaTeX does inside every environment, modelled or
# not. `plain` is a LIST ITEM's shape and nothing else's.
query II
SELECT element_type, content FROM read_latex_blocks_string(
  '\begin{document}\vspace{2em}\begin{unknownenv}kept\end{unknownenv}\begin{tabular}{ll}a&b\\\end{tabular}\end{document}')
WHERE kind = 'block' ORDER BY element_order;
----
paragraph	kept

# ...and the KNOWN transparent half reads the same, which is the point.
query II
SELECT element_type, content FROM read_latex_blocks_string('\begin{center}centred\end{center}')
WHERE kind = 'block' ORDER BY element_order;
----
paragraph	centred

# THE FOLD THIS PREVENTS. An unknown environment inside an \item used to hand the item a
# `plain`, which the content rule then folded onto the item as though the item had written
# the text itself. Only a run the ITEM owns can become the item's content.
query III
SELECT element_type, content, level FROM read_latex_blocks_string(
  '\begin{itemize}\item \begin{foo}text\end{foo}\end{itemize}') ORDER BY element_order;
----
list	NULL	1
list_item	NULL	2
paragraph	text	3

# UTF-8 and the em-dash ligature both survive. handwritten.tex carries "café --- em-dash".
query I
SELECT count(*) FROM read_latex_blocks('test/fixtures/handwritten.tex')
WHERE content LIKE '%café — em-dash%';
----
1

# ---------------------------------------------------------------------------
# THE CONTENT RULE, AND THE THREE ROWS THAT DISCRIMINATE IT.
#
# content is populated IFF the container's only child is a plain text run, and a lone bare
# run IS that single text child -- so `\item text` carries its text and grows no child at
# all. `plain` is for a run with nowhere else to live: beside a block sibling.
#
# THE THIRD CASE IS THE WHOLE POINT. An item can hold a nested list and STILL be tight, so
# a rule keyed on "does the item have block children" gets a_bare and b_par right and
# c_nested wrong -- it would fold c_nested's text away or promote it to a paragraph. Only
# asserting all three together catches that, which is why they are one query.
# ---------------------------------------------------------------------------
query IIII
SELECT src, element_type, content, level FROM (
  SELECT 'a_bare' AS src, element_type, content, level, element_order
    FROM read_latex_blocks_string('\begin{itemize}\item text\end{itemize}')
  UNION ALL
  SELECT 'b_par', element_type, content, level, element_order
    FROM read_latex_blocks_string('\begin{itemize}\item \par text\end{itemize}')
  UNION ALL
  SELECT 'c_nested', element_type, content, level, element_order
    FROM read_latex_blocks_string('\begin{itemize}\item text\begin{itemize}\item sub\end{itemize}\end{itemize}')
) ORDER BY src, element_order;
----
a_bare	list	NULL	1
a_bare	list_item	text	2
b_par	list	NULL	1
b_par	list_item	NULL	2
b_par	paragraph	text	3
c_nested	list	NULL	1
c_nested	list_item	NULL	2
c_nested	plain	text	3
c_nested	list	NULL	3
c_nested	list_item	sub	4

# A BLANK LINE IS \par SPELLED THE OTHER WAY, and both have to reach the same rule: a
# reader that keyed only on the PAR_BREAK token would read `\item \par text` as tight,
# because \par is a control word the macro table never claimed.
query III
SELECT element_type, content, level FROM read_latex_blocks_string(E'\\begin{itemize}\\item\n\ntext\\end{itemize}')
ORDER BY element_order;
----
list	NULL	1
list_item	NULL	2
paragraph	text	3

# TIGHTNESS IS A PROPERTY OF THE LIST, NOT OF THE ITEM, and this is the shape that proves
# it. Blank lines BETWEEN items is the canonical spelling of a loose list -- Pandoc emits
# Para for all three -- but nothing follows the last item, so a rule that only looks for a
# break INSIDE the open item can never loosen it. That reads uniform separation as an
# uneven list, on every loose list in every real document.
query III
SELECT element_type, content, level FROM read_latex_blocks_string(
  E'\\begin{itemize}\\item a\n\n\\item b\n\n\\item c\\end{itemize}') ORDER BY element_order;
----
list	NULL	1
list_item	NULL	2
paragraph	a	3
list_item	NULL	2
paragraph	b	3
list_item	NULL	2
paragraph	c	3

# ...AND THE DISCRIMINATING HALF: no break between the items, so all three stay tight and
# all three carry their own content. Asserting only the loose case would pass against a
# reader that had simply stopped folding.
query III
SELECT element_type, content, level FROM read_latex_blocks_string(
  E'\\begin{itemize}\\item a\n\\item b\n\\item c\\end{itemize}') ORDER BY element_order;
----
list	NULL	1
list_item	a	2
list_item	b	2
list_item	c	2

# A BLANK LINE BEFORE THE FIRST \item IS LAYOUT, not spacing the author asked for. It is
# how a great many lists are typeset, and loosening on it would loosen half the lists ever
# written.
query III
SELECT element_type, content, level FROM read_latex_blocks_string(
  E'\\begin{itemize}\n\n\\item a\n\\item b\\end{itemize}') ORDER BY element_order;
----
list	NULL	1
list_item	a	2
list_item	b	2

# LOOSENESS STOPS AT THE LIST THAT OWNS THE BREAK. The \par is inside the INNER list, so
# the outer list's items stay tight -- a break belongs to the innermost scope open when it
# occurs, exactly as a paragraph does.
query III
SELECT element_type, content, level FROM read_latex_blocks_string(
  '\begin{itemize}\item outer\begin{enumerate}\item inner\par more\end{enumerate}\item second\end{itemize}')
ORDER BY element_order;
----
list	NULL	1
list_item	NULL	2
plain	outer	3
list	NULL	3
list_item	NULL	4
paragraph	inner	5
paragraph	more	5
list_item	second	2

# A FORMATTED RUN IS NOT A BARE TEXT RUN, so it stays a `plain` child with its own inline
# tree rather than being flattened onto the item's content -- there is no single string to
# carry, and Pandoc emits Plain here too. The content rule asks what the only child IS.
#
# content is TRIMMED in the projection only: the trailing run really is " b", because the
# space between `\textbf{a}` and `b` is a word boundary rather than layout and the reader
# keeps it. Asserting it raw would be testing sqllogictest's whitespace handling.
query IIII
SELECT kind, element_type, trim(content), level
FROM read_latex_blocks_string('\begin{itemize}\item \textbf{a} b\end{itemize}') ORDER BY element_order;
----
block	list	NULL	1
block	list_item	NULL	2
block	plain	NULL	3
inline	bold	a	4
inline	text	b	4

# ---------------------------------------------------------------------------
# ORDERED LISTS carry start/number_style/number_delim ALWAYS, matching read_epub_blocks:
# a consumer that renders numbering should never have to guess a default that the reader
# already knows.
# ---------------------------------------------------------------------------
query IIIIII
SELECT element_type, attributes['list_type'], attributes['ordered'], attributes['start'],
       attributes['number_style'], attributes['number_delim']
FROM read_latex_blocks_string('\begin{enumerate}\item a\end{enumerate}')
WHERE element_type = 'list';
----
list	ordered	true	1	Decimal	Period

# ...and an explicit start survives. `\begin{enumerate}[3]` is the shape the optional
# argument takes; enumitem's `[start=3]` spells the same fact and reads the same.
query II
SELECT list_start, count(*) FROM (
  SELECT attributes['start'] AS list_start
    FROM read_latex_blocks_string('\begin{enumerate}[3]\item a\end{enumerate}') WHERE element_type = 'list'
  UNION ALL
  SELECT attributes['start']
    FROM read_latex_blocks_string('\begin{enumerate}[start=3]\item a\end{enumerate}') WHERE element_type = 'list'
) GROUP BY 1;
----
3	2

# ...and the DISCRIMINATING half: an enumerate optional is usually enumitem KEY-VALUE
# OPTIONS, not a start. Reading "the first integer anywhere in it" turns `[itemsep=0pt]`
# into start=0 -- a number no list starts at -- and `[topsep=2pt,start=5]` into start=2.
# Both are routine markup, so the loose reading is wrong on ordinary documents.
query II
SELECT src, list_start FROM (
  SELECT 'a_keys_only' AS src, attributes['start'] AS list_start
    FROM read_latex_blocks_string('\begin{enumerate}[itemsep=0pt]\item a\end{enumerate}')
   WHERE element_type = 'list'
  UNION ALL
  SELECT 'b_start_after_key', attributes['start']
    FROM read_latex_blocks_string('\begin{enumerate}[topsep=2pt,start=5]\item a\end{enumerate}')
   WHERE element_type = 'list'
) ORDER BY src;
----
a_keys_only	1
b_start_after_key	5

# A BULLET LIST HAS NO start/number_style/number_delim. Emitting them anyway would tell a
# consumer that an unordered list is numbered from 1, which is a statement about the
# document rather than a harmless default.
query III
SELECT attributes['start'], attributes['number_style'], attributes['number_delim']
FROM read_latex_blocks_string('\begin{itemize}\item a\end{itemize}') WHERE element_type = 'list';
----
NULL	NULL	NULL

# ---------------------------------------------------------------------------
# \end MUST MATCH BY NAME. Counting \begin/\end generically -- which the Task 4 placeholder
# did -- lets \end{document} close an unclosed \begin{itemize}: the document's real ending
# is consumed as a nest level and the reader then runs to end of input, emitting the tail
# it was supposed to stop before.
# ---------------------------------------------------------------------------
query III
SELECT element_type, content, level FROM read_latex_blocks_string(
  '\begin{document}\begin{itemize}\item one\end{document} after this') ORDER BY element_order;
----
list	NULL	1
list_item	one	2

# ...and the same for a DROPPED environment, which skips to its own \end rather than
# parsing: `\begin{tabular}` with no `\end{tabular}` must not eat the rest of the document
# silently past the point the document ends.
query I
SELECT count(*) FROM read_latex_blocks_string(
  '\begin{document}\begin{tabular}{ll}a\end{document} after this')
WHERE content LIKE '%after this%';
----
0

# A STRAY \end CLOSES NOTHING. Popping a level that was never pushed would lift the rest
# of the document out of whatever container it really sits in. The text on BOTH sides
# survives and both rows stay at level 1 -- an \end is still a block boundary, which is why
# this is two paragraphs rather than one.
query III
SELECT element_type, content, level FROM read_latex_blocks_string('before \end{itemize} after')
ORDER BY element_order;
----
paragraph	before	1
paragraph	after	1

# ---------------------------------------------------------------------------
# VERBATIM IS A LEXICAL MODE, NOT AN ENVIRONMENT WITH A BODY. Inside it `%` is a percent
# sign and `\emph` is five characters, so the body has to be taken as BYTES before the
# comment rule and the control-word scanner have run -- reconstructing it from tokens
# afterwards cannot get back what those already ate.
# ---------------------------------------------------------------------------
query III
SELECT kind, element_type, content
FROM read_latex_blocks_string(E'\\begin{verbatim}\n100% \\emph{raw} ---\n\\end{verbatim}') ORDER BY element_order;
----
block	code	100% \emph{raw} ---

# ...and lstlisting's options are not code.
query II
SELECT element_type, content
FROM read_latex_blocks_string(E'\\begin{lstlisting}[language=C]\nint x;\n\\end{lstlisting}') ORDER BY element_order;
----
code	int x;

# ---------------------------------------------------------------------------
# \item OUTSIDE A LIST. \begin{description} is TRANSPARENT -- duck_block has no settled
# shape for a definition list, so inventing list_type='bullet' for one would be a
# falsehood about the document -- which leaves its \item with no container to belong to.
# The run is ended and the label stays as text, because deleting text on a guess is the
# one outcome worse than losing the structure.
# ---------------------------------------------------------------------------
query II
SELECT element_type, content FROM read_latex_blocks_string(
  '\begin{description}\item[Term] the definition\end{description}')
WHERE kind = 'block' ORDER BY element_order;
----
paragraph	[Term] the definition

# ---------------------------------------------------------------------------
# A STARRED ENVIRONMENT IS THE UNNUMBERED VARIANT OF THE SAME CONSTRUCT, never a different
# one. The tokenizer strips the star from a control WORD, but an environment name arrives
# from a brace group and keeps it -- so an exact-match lookup missed `align*`, the most
# common display-math environment in real LaTeX, and emitted its source as prose. That is
# precisely the outcome the DROPPED list exists to prevent.
# ---------------------------------------------------------------------------
query II
SELECT src, n FROM (
  SELECT 'a_align_star' AS src, count(*) AS n
    FROM read_latex_blocks_string('\begin{align*} E &= mc^2 \end{align*}')
  UNION ALL
  SELECT 'b_align_plain', count(*) FROM read_latex_blocks_string('\begin{align} E &= mc^2 \end{align}')
  UNION ALL
  SELECT 'c_gather_star', count(*) FROM read_latex_blocks_string('\begin{gather*} x = y \end{gather*}')
  UNION ALL
  SELECT 'd_figure_star', count(*) FROM read_latex_blocks_string('\begin{figure*}\caption{c}\end{figure*}')
) ORDER BY src;
----
a_align_star	0
b_align_plain	0
c_gather_star	0
d_figure_star	0

# ...and the star reaches the verbatim LEXER too, which is a separate lookup: without it
# `\begin{verbatim*}` was tokenized as ordinary LaTeX and its body was read as markup.
query II
SELECT element_type, content
FROM read_latex_blocks_string(E'\\begin{verbatim*}\n\\section{X}\n\\end{verbatim*}') ORDER BY element_order;
----
code	\section{X}

# ...and the dropped text really is gone rather than merely uncounted: the prose either
# side of a starred math environment survives, so this is not the reader stopping early.
query II
SELECT element_type, content FROM read_latex_blocks_string(
  E'before\n\n\\begin{align*} E &= mc^2 \\end{align*}\n\nafter') ORDER BY element_order;
----
paragraph	before
paragraph	after
