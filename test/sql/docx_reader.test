# name: test/sql/docx_reader.test
# description: read_docx_blocks() over DOCX produced by two different real writers
# group: [sql]

#
# The fixtures mark headings by MUTUALLY EXCLUSIVE mechanisms, measured:
#
#                     w:pStyle "Heading*"      w:outlineLvl
#   pandoc            Heading1, Heading2       none
#   LibreOffice       none (only "Normal")     0, 1
#
# A reader supporting one loses every heading from the other. This is the same split RTF
# has, with the writers on OPPOSITE sides -- pandoc is style-based here and outline-based
# in RTF, LibreOffice the reverse. Both paths are asserted independently.

require panduck

# ---------------------------------------------------------------------------
# Mechanism 1: w:pStyle resolved through word/styles.xml (pandoc)
# ---------------------------------------------------------------------------
query II
SELECT content, attributes['heading_level'] AS lvl
FROM read_docx_blocks('test/fixtures/pandoc_pstyle.docx')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	1
Heading Two	2

# ---------------------------------------------------------------------------
# Mechanism 2: w:outlineLvl, with no heading pStyle anywhere (LibreOffice)
# ---------------------------------------------------------------------------
query II
SELECT content, attributes['heading_level'] AS lvl
FROM read_docx_blocks('test/fixtures/libreoffice_outlinelvl.docx')
WHERE element_type = 'heading' ORDER BY element_order;
----
Heading One	1
Heading Two	2

# Both writers reduce to the same block skeleton. Content differs slightly because the
# source documents differ -- LibreOffice's RTF->DOCX conversion kept a literal bullet
# character -- so this compares STRUCTURE, which is the part that must agree.
query I
SELECT count(*) FROM (
  SELECT element_type, kind FROM read_docx_blocks('test/fixtures/pandoc_pstyle.docx')
  EXCEPT
  SELECT element_type, kind FROM read_docx_blocks('test/fixtures/libreoffice_outlinelvl.docx')
);
----
0

# ---------------------------------------------------------------------------
# Inline runs become structured children; the block's own content is NULL.
# ---------------------------------------------------------------------------
query II
SELECT element_type, trim(content) FROM read_docx_blocks('test/fixtures/pandoc_pstyle.docx')
WHERE kind = 'inline' AND element_type <> 'text' ORDER BY element_order;
----
bold	bold
italic	italic
strikethrough	strike

# A heading always flattens its text into content even though writers bold it: the bold
# belongs to the heading style, and a NULL here would empty any table of contents built
# from `content`.
query I
SELECT count(*) FROM read_docx_blocks('test/fixtures/pandoc_pstyle.docx')
WHERE element_type = 'heading' AND content IS NULL;
----
0

# ---------------------------------------------------------------------------
# Unicode survives the ZIP + XML path.
# ---------------------------------------------------------------------------
query II
SELECT length(content) < strlen(content), contains(content, 'café')
FROM read_docx_blocks('test/fixtures/pandoc_pstyle.docx') WHERE content LIKE 'Unicode:%';
----
true	true

# ---------------------------------------------------------------------------
# Row shape is the canonical duck_block schema, so read_panduck_doc's flat branch can
# SELECT * it through. 'value' is allowed ahead of duck_block_utils implementing it.
# ---------------------------------------------------------------------------
query I
SELECT count(*) FROM read_docx_blocks('test/fixtures/pandoc_pstyle.docx')
WHERE kind NOT IN ('block', 'inline', 'value') OR encoding <> 'text';
----
0

# POSITIVE COMPANION. Every count-violations-expecting-zero guard above is satisfied by
# an empty document, so assert there was something to guard. Written this way from the
# start rather than retrofitted, which is how the RTF suite acquired it.
query I
SELECT count(*) > 10 FROM read_docx_blocks('test/fixtures/pandoc_pstyle.docx');
----
true

# ---------------------------------------------------------------------------
# The dispatcher is indistinguishable from the reader, for BOTH fixtures. Symmetric,
# because a one-directional EXCEPT would miss rows the dispatcher drops.
# ---------------------------------------------------------------------------
query I
SELECT (SELECT count(*) FROM ((SELECT * FROM read_panduck_doc('test/fixtures/pandoc_pstyle.docx'))
                       EXCEPT (SELECT * FROM read_docx_blocks('test/fixtures/pandoc_pstyle.docx'))))
     + (SELECT count(*) FROM ((SELECT * FROM read_docx_blocks('test/fixtures/pandoc_pstyle.docx'))
                       EXCEPT (SELECT * FROM read_panduck_doc('test/fixtures/pandoc_pstyle.docx'))));
----
0

query I
SELECT (SELECT count(*) FROM ((SELECT * FROM read_panduck_doc('test/fixtures/libreoffice_outlinelvl.docx'))
                       EXCEPT (SELECT * FROM read_docx_blocks('test/fixtures/libreoffice_outlinelvl.docx'))))
     + (SELECT count(*) FROM ((SELECT * FROM read_docx_blocks('test/fixtures/libreoffice_outlinelvl.docx'))
                       EXCEPT (SELECT * FROM read_panduck_doc('test/fixtures/libreoffice_outlinelvl.docx'))));
----
0

# ---------------------------------------------------------------------------
# Errors name what is wrong. A ZIP that is not a DOCX is a different failure from a file
# that is not a ZIP, and saying which beats returning zero rows.
# ---------------------------------------------------------------------------
statement error
SELECT * FROM read_docx_blocks('test/fixtures/pandoc_outlinelevel.rtf');
----
not a readable ZIP archive

statement error
SELECT * FROM read_docx_blocks('test/fixtures/does_not_exist.docx');
----
not a readable ZIP archive

# ---------------------------------------------------------------------------
# EVERY ELEMENT CARRIES A STRUCTURAL LEVEL. Top level is 1, children are parent+1, and an
# INLINE IS A CHILD OF ITS BLOCK rather than a separate scale -- so a run inside a
# top-level paragraph is 2, not 1.
#
# One rule, no per-type exceptions, and no NULL. The two-scale reading it replaces is what
# let a container and its own child land at the same effective depth, because a NULL block
# and a level-1 inline both resolved to 1; that collision is structurally impossible when
# there is no NULL to resolve. `level` is structural nesting depth and has nothing to do
# with a heading's semantic level, which lives in attributes['heading_level'].
query III
SELECT element_type, content, level FROM read_docx_blocks('test/fixtures/pandoc_pstyle.docx')
WHERE element_order < 4 ORDER BY element_order;
----
heading	Heading One	1
paragraph	NULL	1
text	A paragraph with 	2
bold	bold	2

# ---------------------------------------------------------------------------
# DOCUMENT METADATA -> kind='value', AND THIS READER EXCEEDS PANDOC ON PURPOSE.
#
# Measured: `pandoc file.docx -t json` returns an EMPTY meta on both fixtures, though both
# carry docProps/core.xml with real fields. Pandoc's DOCX reader does not populate Meta at
# all -- unlike its EPUB, LaTeX and RTF readers, where panduck agrees with it exactly.
#
# Recovering fields the user's file plainly contains beats matching that blind spot, and
# the exception is approved. It is narrow in two ways, both asserted here.
#
# FIRST, attributes['source_type'] CARRIES THE ORIGINAL SPELLING. That is the condition
# the approval came with: a format-derived field must be distinguishable from a
# pandoc-derived one, or panduck's output stops being reproducible from `pandoc -t json`
# and the next person to diff the two reads recovered data as a bug. `dcterms:created` and
# `dc:language` also record what the field was called before the pandoc key namespace
# flattened it -- one marker doing both jobs.
query IIIIII
SELECT kind, element_type, level, attributes['key'], attributes['source_type'], content
FROM read_docx_blocks('test/fixtures/libreoffice_outlinelvl.docx')
WHERE element_order >= (SELECT min(element_order) FROM read_docx_blocks('test/fixtures/libreoffice_outlinelvl.docx') WHERE kind = 'value')
ORDER BY element_order;
----
value	inlines	1	language	dc:language	NULL
inline	text	2	NULL	NULL	en-US

# The pandoc-written fixture carries a different field, which is the point of having both:
# dcterms:created rather than dc:language, mapping to the same `date` key every other
# reader uses.
query IIII
SELECT kind, attributes['key'], attributes['source_type'], content
FROM read_docx_blocks('test/fixtures/pandoc_pstyle.docx')
WHERE element_order >= (SELECT min(element_order) FROM read_docx_blocks('test/fixtures/pandoc_pstyle.docx') WHERE kind = 'value')
ORDER BY element_order;
----
value	date	dcterms:created	NULL
inline	NULL	NULL	2026-08-31T19:34:31Z

# SECOND, AN EMPTY FIELD IS SKIPPED HERE -- the one place this differs from the EPUB,
# LaTeX and RTF readers, which emit empty fields.
#
# The ruling is "an empty field is still a field", and its stated ground is that emitting
# nothing would discard a fact PANDOC PRESERVED. That reasoning is about mirroring, and
# pandoc extracts nothing from DOCX, so there is no empty field of pandoc's to mirror.
# What is actually present is boilerplate: LibreOffice writes <dc:title/>, <dc:creator/>,
# <dc:subject/> and <dc:description/> into every file it saves. Emitting them would put
# four empty rows in every LibreOffice document -- diverging from the reference to convey
# nothing, and weakening the case for exceeding pandoc, which rests on RECOVERING DATA.
#
# The fixture really does contain all four, so this asserts the skip rather than an
# absence: without it these would be present-and-empty.
query I
SELECT count(*) FROM read_docx_blocks('test/fixtures/libreoffice_outlinelvl.docx')
WHERE kind = 'value' AND attributes['key'] IN ('title', 'author', 'subject', 'description');
----
0
