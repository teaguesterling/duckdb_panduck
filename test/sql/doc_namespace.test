# name: test/sql/doc_namespace.test
# description: doc_* — path-taking sugar over duck_block_utils' block-taking db_*
# group: [sql]

#
# doc_* takes a PATH; db_* takes blocks you already hold. That split is why this
# namespace is panduck's: taking a path is the IO engine's job. It restores
# doc_toc('README.md'), which duck_block_utils recorded as an accepted cost when
# dispatch moved out.
#
# These load duck_block_utils ON DEMAND, exactly as reading .md loads markdown. panduck's
# core needs none of it -- every reader, the registry and both dispatchers work with
# duck_block_utils absent -- so this whole file is gated rather than the suite.

require panduck

# Explicit INSTALL/LOAD rather than `require duck_block_utils`: the unittest binary is
# built with ENABLE_EXTENSION_AUTOLOADING=0, so `require` cannot load a community
# extension and the whole file would SKIP -- coverage-shaped with no coverage, which is
# the exact failure this suite has been hunting all day. This mirrors what
# duck_block_utils' own doc_macros.test does for markdown.
statement ok
INSTALL duck_block_utils;

statement ok
LOAD duck_block_utils;

# ---------------------------------------------------------------------------
# WHICH SPELLING THE INSTALLED BUILD USES. duck_block_utils renamed its whole surface --
# db_blocks_toc -> duck_blocks_toc, and so on -- because `db_` reads as DATABASE
# everywhere else in SQL. As of 2026-09-04 that rename IS in the community build. Measured
# into an EMPTY extension_directory, so the shared ~/.duckdb profile could not colour it:
#
#   SET extension_directory='<empty dir>';
#   INSTALL duck_block_utils FROM community;   -- extension_version 3f2a0f0
#   LOAD duck_block_utils;
#   SELECT count(*) FILTER (WHERE function_name LIKE 'db\_%' ESCAPE '\'),
#          count(*) FILTER (WHERE function_name LIKE 'duck\_%' ESCAPE '\')
#     FROM duckdb_functions();
#     -> 0 db_*, 174 duck_*.  No back-compat aliases; both names panduck calls are gone.
#
# doc_toc and doc_render call those BY NAME at runtime, so they follow the INSTALLED build,
# not panduck's submodule pin -- the pin is a compile-time dependency on constant names and
# says nothing about this. Two independent clocks, and this is the day the second one
# moved: CI passed this file on the db_* spelling at 05:03 UTC and the local suite failed
# it on the duck_* one hours later, from the same commit and the same source tree.
#
# This assertion is the alarm, and it tracks whichever spelling reader_registry.cpp
# currently calls. It goes red HERE, naming exactly what moved, instead of doc_toc failing
# with a bare "function does not exist" three assertions further down -- but a red result
# has AT LEAST TWO causes, not one, because this reads whatever build is currently
# INSTALLED, not necessarily a published one:
#
#   1. duck_block_utils renamed the surface again. Re-run the measurement above against
#      `FROM community` IN AN EMPTY extension_directory to confirm, then rename the call
#      sites in reader_registry.cpp and flip this expectation in the same commit.
#   2. Someone locally replaced the installed build -- e.g. `FORCE INSTALL duck_block_utils
#      FROM '<local repo>'` -- which mutates the shared ~/.duckdb extension profile in
#      place. Nothing has been published; the fix is restoring the community build, not
#      touching panduck's call sites. This has happened: a sibling project's local build
#      briefly sat in that profile, this assertion correctly went red, and an implementer
#      who read only the old wording here concluded upstream had published when it had not.
#
# WHAT DOES NOT TELL THEM APART: duckdb_extensions().installed_from. It read `community`
# throughout the 2026-09-04 red, which is consistent with both causes and settles neither.
# The empty-directory re-install is the measurement that does.
query I
SELECT count(*) > 0 FROM duckdb_functions() WHERE function_name = 'duck_blocks_toc';
----
true

# ---------------------------------------------------------------------------
# The same document read two ways yields the same table of contents. Two formats,
# two readers, two heading mechanisms, one vocabulary.
# ---------------------------------------------------------------------------
query III
SELECT level, title, indent FROM doc_toc('test/fixtures/pandoc_pstyle.docx') ORDER BY element_order;
----
1	Heading One	0
2	Heading Two	1

query III
SELECT level, title, indent FROM doc_toc('test/fixtures/pandoc_outlinelevel.rtf') ORDER BY element_order;
----
1	Heading One	0
2	Heading Two	1

# The DOCX and RTF fixtures agree exactly -- asserted directly rather than left to be
# inferred from the two blocks above matching by eye.
query I
SELECT count(*) FROM (
  (SELECT level, title FROM doc_toc('test/fixtures/pandoc_pstyle.docx'))
  EXCEPT
  (SELECT level, title FROM doc_toc('test/fixtures/pandoc_outlinelevel.rtf'))
);
----
0

# POSITIVE COMPANION: the EXCEPT above is satisfied by both sides being empty.
query I
SELECT count(*) FROM doc_toc('test/fixtures/pandoc_pstyle.docx');
----
2

# ...AND THE .tex ARM, which is the headline goal stated as an assertion rather than as
# prose: "a LaTeX document and the same document in DOCX, ODT, EPUB or RTF produce the same
# table of contents". Three writers with nothing in common -- Word's paragraph styles,
# RTF's outline levels, and a person typing \section -- routed through three readers into
# one vocabulary. Asserted in BOTH directions, because EXCEPT is one-sided and the pair
# above only rules out extra rows on the docx side.
query III
SELECT level, title, indent FROM doc_toc('test/fixtures/handwritten.tex') ORDER BY element_order;
----
1	Heading One	0
2	Heading Two	1

query I
SELECT count(*) FROM (
  (SELECT level, title FROM doc_toc('test/fixtures/pandoc_pstyle.docx'))
  EXCEPT
  (SELECT level, title FROM doc_toc('test/fixtures/handwritten.tex'))
);
----
0

query I
SELECT count(*) FROM (
  (SELECT level, title FROM doc_toc('test/fixtures/handwritten.tex'))
  EXCEPT
  (SELECT level, title FROM doc_toc('test/fixtures/pandoc_outlinelevel.rtf'))
);
----
0

# doc_toc is exactly the composition it claims to be -- sugar, not a reimplementation.
query I
SELECT count(*) FROM (
  (SELECT level, title FROM doc_toc('test/fixtures/pandoc_pstyle.docx'))
  EXCEPT
  (SELECT (t).level, (t).title
   FROM (SELECT unnest(duck_blocks_toc(panduck_read_blocks('test/fixtures/pandoc_pstyle.docx'))) AS t))
);
----
0

# ---------------------------------------------------------------------------
# doc_render: to a FORMAT. duck_block_utils deleted its own doc_render when it stopped
# depending on format extensions; rendering to md/html is format IO, which is panduck's.
# ---------------------------------------------------------------------------
query I
SELECT starts_with(doc_render('test/fixtures/pandoc_outlinelevel.rtf', 'md'), '# Heading One');
----
true

query I
SELECT contains(doc_render('test/fixtures/pandoc_outlinelevel.rtf', 'md'), '**bold**');
----
true

query I
SELECT contains(doc_render('test/fixtures/pandoc_pstyle.docx', 'text'), 'Heading One');
----
true

# An unsupported output format is named, not silently defaulted -- the failure mode that
# let doc_search degrade md/html/blocks/pandoc to text in duck_block_utils.
statement error
SELECT doc_render('test/fixtures/pandoc_outlinelevel.rtf', 'nonsense');
----
doc_render supports md, html and text

# 'ansi' is deliberately absent, not forgotten: duck_block_ansi is a macro behind
# PRAGMA duck_block_render, and a macro created by a pragma cannot be reached from a
# panduck macro. That blocker may have lifted -- duck_block_utils 3f2a0f0 does register a
# duck_blocks_render_ansi SCALAR at LOAD -- but wiring it up means checking its signature
# against what doc_render needs, which is a separate change from the db_ -> duck_ rename.
# Until then it returns the same named error.
statement error
SELECT doc_render('test/fixtures/pandoc_outlinelevel.rtf', 'ansi');
----
doc_render supports md, html and text

# ---------------------------------------------------------------------------
# doc_toc AND doc_render TAKE A SINGLE DOCUMENT TOO.
#
# doc_section and doc_container were guarded first; these two had the same defect and were
# left open, which #14 records. Measured before the guard: doc_toc('*.html') returned 7 rows
# -- a merged table of contents over three documents whose element_order values collide, so
# the `element_order` column no longer addresses anything -- and doc_render('*.html','md')
# returned 344 characters of three documents concatenated with no separator.
#
# A LIST was refused before this, but by LEAKING AN INTERNAL BINDER ERROR
# (`replace(VARCHAR[], STRING_LITERAL, STRING_LITERAL)`) from inside panduck_quote, which
# names none of panduck, the function, or what to do instead. Both spellings now get the
# same named refusal.
statement error
SELECT count(*) FROM doc_toc('test/fixtures/*.html');
----
doc_toc takes a single document

statement error
SELECT count(*) FROM doc_toc(['test/fixtures/pandoc_pstyle.docx', 'test/fixtures/handwritten.tex']);
----
doc_toc takes a single document

statement error
SELECT doc_render('test/fixtures/*.html', 'md');
----
doc_render takes a single document

statement error
SELECT doc_render(['test/fixtures/pandoc_pstyle.docx', 'test/fixtures/handwritten.tex'], 'md');
----
doc_render takes a single document

# NEGATIVE CONTROLS. A guard that refused everything would satisfy all four assertions above
# and break both functions, so the single-document path is pinned by exact value, not by
# "did not error".
query III
SELECT level, title, indent FROM doc_toc('test/fixtures/pandoc_pstyle.docx') ORDER BY element_order;
----
1	Heading One	0
2	Heading Two	1

query I
SELECT starts_with(doc_render('test/fixtures/pandoc_outlinelevel.rtf', 'md'), '# Heading One');
----
true

# ...AND THE SPELLINGS OF ONE DOCUMENT. A glob that matches exactly one file, and a
# one-element list, are single documents and must work -- the mistake the doc_section guard
# made on its first attempt, by testing the shape of the source instead of what it resolves
# to. A one-element list previously hit the leaked binder error here, so this is new
# capability rather than merely a preserved one.
query I
SELECT count(*) FROM doc_toc('test/fixtures/pandoc_pstyle.doc?');
----
2

query I
SELECT count(*) FROM doc_toc(['test/fixtures/pandoc_pstyle.docx']);
----
2

# ---------------------------------------------------------------------------
# doc_toc PICKS ITS FUNCTION FROM THE INSTALLED duck_block_utils, NOT FROM WHAT PANDUCK
# WAS COMPILED AGAINST.
#
# 6.5 reshaped duck_blocks_toc to return duck_blocks and moved today's projection to
# duck_blocks_toc_structs. The five fields doc_toc reads live on the _structs form and NOT
# on a duck_block, so against 6.5 the old name does not degrade -- it fails to bind:
#
#   Binder Error: Could not find key "title" in struct        (measured, against a 6.5 build)
#
# Naming only the new function breaks doc_toc for everyone on the published build; naming
# only the old one breaks the day 6.5 publishes. So the name is chosen per install.
#
# VERIFIED BOTH WAYS on real builds, which is the only verification worth anything here:
# against community 3f2a0f0 (spec 6.3) and against a local 6.5 build installed into a
# scratch extension_directory, doc_toc returns the identical two rows asserted above.
query I
SELECT panduck_duck_block_spec_at_least(6, 0) AND NOT panduck_duck_block_spec_at_least(99, 0);
----
true

# NUMERIC, NOT LEXICAL. '6.10' sorts before '6.5' as a string, so a string compare would
# silently pick the wrong branch the first time a minor version reaches double digits --
# the kind of bug that surfaces months later as "doc_toc broke on upgrade".
query II
SELECT '6.10' < '6.5' AS lexical_would_be_wrong,
       panduck_duck_block_spec_at_least(6, 3) AS numeric_is_right;
----
true	true
